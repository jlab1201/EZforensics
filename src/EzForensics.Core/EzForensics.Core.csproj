<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Pin patched transitive deps (GHSA-2m69-gcr7-jv3q, GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <EmbeddedResource Include="Resources\**\*.json" />
    <EmbeddedResource Include="Resources\prompts\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Eric Zimmerman's offline hive parser (MIT), used for Computer details (Core/SystemInfo) -->
    <PackageReference Include="Registry" Version="2026.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PE headers, sections, imports/exports, imphash for Explore (Apache-2.0). 5.1.0 is the last release with a net8.0 target; 6.x is net10-only. -->
    <PackageReference Include="PeNet" Version="5.1.0" />
  </ItemGroup>

</Project>
