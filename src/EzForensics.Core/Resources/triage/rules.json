{
  "rules": [
    { "id": "prefetch", "label": "Prefetch", "toolId": "PECmd", "exeName": "PECmd.exe", "category": "ProgramExecution",
      "paths": ["Windows\\Prefetch"], "mode": "dir", "mask": "*.pf",
      "args": ["-d", "{dir}", "--csv", "{out}", "-q"], "defaultSelected": true,
      "output": { "name": "Prefetch", "artifactId": "prefetch", "csvf": true } },
    { "id": "evtx", "label": "Event logs", "toolId": "EvtxECmd", "exeName": "EvtxECmd.exe", "category": "EventLogs",
      "paths": ["Windows\\System32\\winevt\\Logs"], "mode": "dir", "mask": "*.evtx",
      "args": ["-d", "{dir}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "EventLogs", "artifactId": "eventlog", "csvf": true } },
    { "id": "mft", "label": "$MFT", "toolId": "MFTECmd", "exeName": "MFTECmd.exe", "category": "FileSystem",
      "paths": ["$MFT"], "mode": "file", "liveVolumeMatch": true, "requiresAdmin": true,
      "args": ["-f", "{file}", "--csv", "{out}"], "defaultSelected": true, "exclusive": true,
      "output": { "name": "MFT", "artifactId": "mft", "csvf": true } },
    { "id": "usnjrnl", "label": "$UsnJrnl:$J", "toolId": "MFTECmd", "exeName": "MFTECmd.exe", "category": "FileSystem",
      "paths": ["$Extend\\$J", "$Extend\\$UsnJrnl%3A$J"], "mode": "file",
      "args": ["-f", "{file}", "--csv", "{out}"], "defaultSelected": true, "exclusive": true,
      "output": { "name": "UsnJournal", "artifactId": "usnjournal", "csvf": true } },
    { "id": "amcache", "label": "Amcache", "toolId": "AmcacheParser", "exeName": "AmcacheParser.exe", "category": "ProgramExecution",
      "paths": ["Windows\\AppCompat\\Programs\\Amcache.hve"], "mode": "file",
      "args": ["-f", "{file}", "-i", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "Amcache", "artifactId": "amcache" } },
    { "id": "appcompat", "label": "AppCompatCache (Shimcache)", "toolId": "AppCompatCacheParser", "exeName": "AppCompatCacheParser.exe", "category": "ProgramExecution",
      "paths": ["Windows\\System32\\config\\SYSTEM"], "mode": "file",
      "args": ["-f", "{file}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "ShimCache", "artifactId": "shimcache", "csvf": true } },
    { "id": "registry", "label": "Registry hive", "toolId": "RECmd", "exeName": "RECmd.exe", "category": "Registry",
      "paths": ["Windows\\System32\\config\\SYSTEM", "Windows\\System32\\config\\SOFTWARE", "Windows\\System32\\config\\SAM",
                "Windows\\System32\\config\\SECURITY", "Users\\*\\NTUSER.DAT",
                "Users\\*\\AppData\\Local\\Microsoft\\Windows\\UsrClass.dat"],
      "mode": "file", "perMatch": true,
      "args": ["-f", "{file}", "--bn", "{batchFile}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "Registry", "artifactId": "registry", "qualifier": "hive" } },
    { "id": "shellbags", "label": "ShellBags", "toolId": "SBECmd", "exeName": "SBECmd.exe", "category": "FileFolderAccess",
      "paths": ["Users\\*"], "mode": "dir", "mask": "NTUSER.DAT", "perMatch": true,
      "args": ["-d", "{dir}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "ShellBags", "artifactId": "shellbags", "qualifier": "user" } },
    { "id": "lnk", "label": "LNK files", "toolId": "LECmd", "exeName": "LECmd.exe", "category": "FileFolderAccess",
      "paths": ["Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\Recent"], "mode": "dir", "mask": "*.lnk", "perMatch": true,
      "args": ["-d", "{dir}", "--csv", "{out}", "-q"], "defaultSelected": true,
      "output": { "name": "LNK", "artifactId": "lnk", "csvf": true, "qualifier": "user" } },
    { "id": "jumplists", "label": "Jump lists", "toolId": "JLECmd", "exeName": "JLECmd.exe", "category": "FileFolderAccess",
      "paths": ["Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\Recent"], "mode": "dir", "mask": "*Destinations-ms", "recurse": true, "perMatch": true,
      "args": ["-d", "{dir}", "--csv", "{out}", "-q"], "defaultSelected": true,
      "output": { "name": "JumpLists", "artifactId": "jumplist", "qualifier": "user" } },
    { "id": "recyclebin", "label": "Recycle Bin", "toolId": "RBCmd", "exeName": "RBCmd.exe", "category": "FileDeletion",
      "paths": ["$Recycle.Bin"], "mode": "dir", "mask": "$I*", "recurse": true,
      "args": ["-d", "{dir}", "--csv", "{out}", "-q"], "defaultSelected": true,
      "output": { "name": "RecycleBin", "artifactId": "recyclebin", "csvf": true } },
    { "id": "srum", "label": "SRUM", "toolId": "SrumECmd", "exeName": "SrumECmd.exe", "category": "ProgramExecution",
      "paths": ["Windows\\System32\\SRU\\SRUDB.dat"], "mode": "file",
      "args": ["-f", "{file}", "-r", "{softwareHive}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "SRUM", "artifactId": "srum" } },
    { "id": "sum", "label": "User Access Logging (SUM)", "toolId": "SumECmd", "exeName": "SumECmd.exe", "category": "UserActivity",
      "paths": ["Windows\\System32\\LogFiles\\Sum"], "mode": "dir", "mask": "*.mdb",
      "args": ["-d", "{dir}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "UAL", "artifactId": "ual" } },
    { "id": "activitiescache", "label": "Windows Timeline (ActivitiesCache)", "toolId": "WxTCmd", "exeName": "WxTCmd.exe", "category": "UserActivity",
      "paths": ["Users\\*\\AppData\\Local\\ConnectedDevicesPlatform\\*\\ActivitiesCache.db"], "mode": "file", "perMatch": true,
      "args": ["-f", "{file}", "--csv", "{out}"], "defaultSelected": true,
      "output": { "name": "ActivitiesCache", "artifactId": "activitiescache", "qualifier": "user" } },
    { "id": "recentfilecache", "label": "RecentFileCache", "toolId": "RecentFileCacheParser", "exeName": "RecentFileCacheParser.exe", "category": "ProgramExecution",
      "paths": ["Windows\\AppCompat\\Programs\\RecentFileCache.bcf"], "mode": "file",
      "args": ["-f", "{file}", "--csv", "{out}", "-q"], "defaultSelected": true,
      "output": { "name": "RecentFileCache", "artifactId": "recentfilecache", "csvf": true } },
    { "id": "sqlite-hunt", "label": "SQLite database hunt (users)", "toolId": "SQLECmd", "exeName": "SQLECmd.exe", "category": "Databases",
      "paths": ["Users"], "mode": "dir",
      "args": ["-d", "{dir}", "--hunt", "--csv", "{out}"], "defaultSelected": false,
      "output": { "name": "SQLite", "artifactId": "sqlite" } }
  ]
}
