{
  "schemaVersion": 1,
  "tool": "EvtxECmd",
  "researchedOn": "2026-10-16",
  "notes": [
    "EvtxECmd --inc/--exc filter on Event ID only. Channel/provider are not filter keys. Channel is controlled by which .evtx files are passed (-f / -d).",
    "mapStatus 'verified' means the EZ Maps file for that Channel_Provider_EventID exists in evtx/Maps and its PayloadData/Property targets were read. 'no-map' means no EZ map exists for that event (fields come only from the raw Payload). 'unverified' means not yet checked; none should remain.",
    "fields are Windows EventData names as seen in the raw XML. mapProperties are EZ Maps targets (UserName, RemoteHost, PayloadData1-6, ExecutableInfo) where verified.",
    "Group 'process-activity' feeds the process tree details (Analyze > Process tree). Its off-by-default events (Security 5156/5158/4656/4657/4663) need audit policies / SACLs and are high volume; each carries a 'note'.",
    "Sysmon, WinRM, TaskScheduler/Operational, Defender and WMI-Activity channels are not enabled by default on Windows and only produce events when enabled or installed."
  ],
  "sources": [
    "https://github.com/EricZimmerman/evtx",
    "https://github.com/EricZimmerman/evtx/tree/master/evtx/Maps",
    "https://raw.githubusercontent.com/EricZimmerman/evtx/master/evtx/Maps/!!!!README.md",
    "https://learn.microsoft.com/en-us/windows-server/identity/ad-ds/plan/appendix-l--events-to-monitor",
    "https://www.jpcert.or.jp/english/pub/sr/DetectingLateralMovementThroughTrackingEventLogs_version2.pdf",
    "https://hannahsuarez.github.io/2019/eventids-lateral/",
    "https://www.nsa.gov/ia/_files/app/spotting_the_adversary_with_windows_event_log_monitoring.pdf"
  ],
  "groups": [
    {
      "id": "logon",
      "title": "Logon and authentication",
      "events": [
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4624, "title": "Successful logon", "fields": ["TargetUserName", "TargetDomainName", "LogonType", "IpAddress", "WorkstationName", "AuthenticationPackageName", "LogonProcessName", "TargetLogonId"], "mapProperties": ["UserName", "RemoteHost", "PayloadData1 (TargetDomainName, TargetUserName)", "PayloadData2 (LogonType)", "PayloadData3 (TargetLogonId)", "PayloadData4 (AuthenticationPackageName)", "PayloadData5 (LogonProcessName)"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4625, "title": "Failed logon", "fields": ["TargetUserName", "LogonType", "IpAddress", "WorkstationName", "Status", "SubStatus"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4648, "title": "Logon with explicit credentials", "fields": ["SubjectUserName", "TargetUserName", "TargetServerName", "ProcessName", "IpAddress"], "mapProperties": ["UserName (SubjectUserName)", "RemoteHost (IpAddress:IpPort)", "PayloadData1 (TargetUserName)", "PayloadData2 (TargetServerName)", "PayloadData3 (ProcessId)", "PayloadData4 (TargetInfo)", "ExecutableInfo (ProcessName)"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4672, "title": "Special privileges assigned to new logon", "fields": ["SubjectUserName", "SubjectDomainName", "PrivilegeList"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (PrivilegeList)", "PayloadData2 (SubjectLogonId)"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4634, "title": "Account logged off", "fields": ["TargetUserName", "LogonType"], "mapProperties": ["PayloadData1 (TargetUserName)", "PayloadData2 (LogonType)", "PayloadData3 (TargetLogonId)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4769, "title": "Kerberos service ticket requested", "fields": ["TargetUserName", "ServiceName", "TicketEncryptionType", "IpAddress"], "mapProperties": ["RemoteHost (IpAddress:IpPort)", "PayloadData1 (TargetUserName)", "PayloadData2 (ServiceName)", "PayloadData3 (ServiceSid)", "PayloadData4 (TicketEncryptionType)", "PayloadData5 (Status)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4771, "title": "Kerberos pre-authentication failed", "fields": ["TargetUserName", "Status", "IpAddress"], "mapProperties": ["RemoteHost (IpAddress:IpPort)", "PayloadData1 (TargetUserName)", "PayloadData2 (ServiceName)", "PayloadData3 (Status)", "PayloadData4 (PreAuthType)"], "mapStatus": "verified", "default": false }
      ]
    },
    {
      "id": "account",
      "title": "Account management",
      "events": [
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4720, "title": "User account created", "fields": ["SubjectUserName", "TargetUserName", "TargetDomainName", "TargetSid"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4732, "title": "Member added to security-enabled local group", "fields": ["SubjectUserName", "MemberName", "MemberSid", "TargetUserName", "TargetSid"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4722, "title": "User account enabled", "fields": ["SubjectUserName", "TargetUserName"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (TargetUserName)", "PayloadData2 (SubjectLogonId)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4724, "title": "Password reset attempt", "fields": ["SubjectUserName", "TargetUserName"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (TargetUserName)", "PayloadData2 (SubjectLogonId)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4726, "title": "User account deleted", "fields": ["SubjectUserName", "TargetUserName"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (TargetUserName)", "PayloadData2 (SubjectLogonId)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4728, "title": "Member added to security-enabled global group", "fields": ["SubjectUserName", "MemberName", "MemberSid", "TargetUserName"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (TargetUserName)", "PayloadData2 (MemberName)", "PayloadData3 (MemberSid)", "PayloadData4 (SubjectLogonId)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4756, "title": "Member added to security-enabled universal group", "fields": ["SubjectUserName", "MemberName", "TargetUserName"], "mapStatus": "no-map", "default": false }
      ]
    },
    {
      "id": "process",
      "title": "Process execution",
      "events": [
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4688, "title": "New process created", "fields": ["SubjectUserName", "NewProcessName", "NewProcessId", "CommandLine", "ParentProcessName", "ProcessId"], "mapProperties": ["UserName", "PayloadData1 (parent process)", "PayloadData2 (PID)", "PayloadData3 (parent PID)", "PayloadData4 (mandatory label)", "PayloadData5 (target user)", "ExecutableInfo"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 1, "title": "Process create", "fields": ["Image", "CommandLine", "ParentImage", "ParentCommandLine", "User", "Hashes"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 3, "title": "Network connection", "fields": ["Image", "User", "DestinationIp", "DestinationPort", "DestinationHostname"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessGuid, ProcessId)", "PayloadData2 (RuleName)", "PayloadData3 (SourceHostname)", "PayloadData4 (SourceIp)", "PayloadData5 (DestinationHostname)", "PayloadData6 (DestinationIp)", "ExecutableInfo (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 10, "title": "Process access (e.g. LSASS)", "fields": ["SourceImage", "TargetImage", "GrantedAccess", "CallTrace"], "mapProperties": ["UserName (SourceUser, TargetUser)", "PayloadData2 (GrantedAccess)", "PayloadData3 (SourceProcessId, SourceProcessGuid)", "PayloadData4 (SourceImage)", "PayloadData5 (TargetProcessId, TargetProcessGuid)", "PayloadData6 (TargetImage)", "ExecutableInfo (CallTrace)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 8, "title": "CreateRemoteThread", "fields": ["SourceImage", "TargetImage", "StartModule", "StartFunction"], "mapProperties": ["UserName (SourceUser, TargetUser)", "PayloadData1 (StartAddress)", "PayloadData2 (RuleName)", "PayloadData3 (SourceProcessId, SourceProcessGuid)", "PayloadData4 (SourceImage)", "PayloadData5 (TargetProcessId, TargetProcessGuid)", "PayloadData6 (TargetImage)"], "mapStatus": "verified", "default": false },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 11, "title": "File created", "fields": ["Image", "TargetFilename"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessGuid, ProcessId)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (TargetFilename)"], "mapStatus": "verified", "default": false }
      ]
    },
    {
      "id": "process-activity",
      "title": "Process activity (process tree details)",
      "events": [
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 2, "title": "File creation time changed (timestomp)", "fields": ["Image", "TargetFilename", "CreationUtcTime", "PreviousCreationUtcTime"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (TargetFilename)", "PayloadData5 (CreationUtcTime)", "PayloadData6 (PreviousCreationUtcTime)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 6, "title": "Driver loaded", "fields": ["ImageLoaded", "Hashes", "Signed", "Signature", "SignatureStatus"], "mapProperties": ["ExecutableInfo (ImageLoaded)", "PayloadData2 (RuleName)", "PayloadData3 (Hashes)", "PayloadData4 (Signed)", "PayloadData5 (Signature)", "PayloadData6 (SignatureStatus)"], "mapStatus": "verified", "default": true, "note": "The EZ map has no process cells; the process tree attaches driver loads to System (PID 4)." },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 7, "title": "Image loaded (DLL)", "fields": ["Image", "ImageLoaded", "Hashes", "Signed", "Signature", "SignatureStatus"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Hashes)", "PayloadData4 (Signed)", "PayloadData5 (Image)", "ExecutableInfo (ImageLoaded)"], "mapStatus": "verified", "default": true, "note": "Signature and SignatureStatus are not in the EZ map; they are read from the raw Payload column. Costs nothing when Sysmon does not log image loads." },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 12, "title": "Registry object created or deleted", "fields": ["Image", "EventType", "TargetObject"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (EventType)", "PayloadData5 (TargetObject)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 14, "title": "Registry key or value renamed", "fields": ["Image", "EventType", "TargetObject", "NewName"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData3 (Image)", "PayloadData4 (EventType)", "PayloadData5 (TargetObject)", "PayloadData6 (NewName)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 15, "title": "File stream created (Zone.Identifier, ADS)", "fields": ["Image", "TargetFilename", "Hash"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (TargetFilename)", "PayloadData5 (Hash)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 17, "title": "Named pipe created", "fields": ["Image", "PipeName"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (PipeName)", "PayloadData5 (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 18, "title": "Named pipe connected", "fields": ["Image", "PipeName"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (PipeName)", "PayloadData5 (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 22, "title": "DNS query", "fields": ["Image", "QueryName", "QueryStatus", "QueryResults"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (QueryName)", "PayloadData5 (QueryStatus)", "PayloadData6 (QueryResults)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 23, "title": "File deleted (archived)", "fields": ["Image", "TargetFilename", "Hashes", "IsExecutable", "Archived"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Hashes)", "PayloadData4 (TargetFilename)", "PayloadData5 (IsExecutable)", "PayloadData6 (Archived)", "ExecutableInfo (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 25, "title": "Process tampering (hollowing, herpaderping)", "fields": ["Image", "Type"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData6 (Type)", "ExecutableInfo (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 26, "title": "File delete logged", "fields": ["Image", "TargetFilename", "Hashes", "IsExecutable", "Archived"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessId, ProcessGuid)", "PayloadData2 (RuleName)", "PayloadData3 (Hashes)", "PayloadData4 (TargetFilename)", "PayloadData5 (IsExecutable)", "PayloadData6 (Archived)", "ExecutableInfo (Image)"], "mapStatus": "verified", "default": true },
        { "channel": "Windows PowerShell", "provider": "PowerShell", "eventId": 400, "title": "PowerShell engine started", "fields": ["HostApplication", "HostName", "HostVersion", "EngineVersion"], "mapProperties": ["PayloadData1 (HostApplication)", "PayloadData2 (HostName)", "PayloadData3 (HostVersion)"], "mapStatus": "verified", "default": true, "note": "The process tree links it by the ProcessId column of the row (the host process)." },
        { "channel": "Windows PowerShell", "provider": "PowerShell", "eventId": 800, "title": "PowerShell pipeline execution details", "fields": ["HostApplication", "HostName", "CommandName"], "mapProperties": ["PayloadData1 (HostApplication)", "PayloadData2 (HostName)", "PayloadData3 (HostVersion)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "provider": "Microsoft-Windows-TaskScheduler", "eventId": 129, "title": "Scheduled task launched a process (has PID)", "fields": ["TaskName", "Path", "ProcessID"], "mapProperties": ["PayloadData1 (TaskName)", "PayloadData2 (ProcessID)", "ExecutableInfo (Path)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "provider": "Microsoft-Windows-TaskScheduler", "eventId": 201, "title": "Scheduled task action completed", "fields": ["TaskName", "ActionName", "TaskInstanceId", "ResultCode"], "mapProperties": ["PayloadData1 (TaskName)", "PayloadData2 (TaskInstanceId)", "ExecutableInfo (ActionName)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-AppLocker/EXE and DLL", "provider": "Microsoft-Windows-AppLocker", "eventId": 8002, "title": "AppLocker: executable allowed", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapProperties": ["ExecutableInfo (FilePath)", "PayloadData1 (FileHash)", "PayloadData2 (Fqbn)", "PayloadData4 (TargetLogonId)", "PayloadData5 (FullFilePath)"], "mapStatus": "verified", "default": true, "note": "Only logged when an AppLocker policy exists." },
        { "channel": "Microsoft-Windows-AppLocker/EXE and DLL", "provider": "Microsoft-Windows-AppLocker", "eventId": 8003, "title": "AppLocker: executable would be blocked (audit mode)", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapStatus": "no-map", "default": true },
        { "channel": "Microsoft-Windows-AppLocker/EXE and DLL", "provider": "Microsoft-Windows-AppLocker", "eventId": 8004, "title": "AppLocker: executable blocked", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapProperties": ["ExecutableInfo (FilePath)", "PayloadData1 (FileHash)", "PayloadData2 (Fqbn)", "PayloadData4 (TargetLogonId)", "PayloadData5 (FullFilePath)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-AppLocker/MSI and Script", "provider": "Microsoft-Windows-AppLocker", "eventId": 8005, "title": "AppLocker: script or installer allowed", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapProperties": ["ExecutableInfo (FilePath)", "PayloadData1 (FileHash)", "PayloadData2 (Fqbn)", "PayloadData4 (TargetLogonId)", "PayloadData5 (FullFilePath)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-AppLocker/MSI and Script", "provider": "Microsoft-Windows-AppLocker", "eventId": 8006, "title": "AppLocker: script or installer would be blocked (audit mode)", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapStatus": "no-map", "default": true },
        { "channel": "Microsoft-Windows-AppLocker/MSI and Script", "provider": "Microsoft-Windows-AppLocker", "eventId": 8007, "title": "AppLocker: script or installer blocked", "fields": ["PolicyName", "RuleName", "RuleSddl", "TargetUser", "FilePath", "FileHash", "Fqbn"], "mapProperties": ["ExecutableInfo (FilePath)", "PayloadData1 (FileHash)", "PayloadData2 (Fqbn)", "PayloadData4 (TargetLogonId)", "PayloadData5 (FullFilePath)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-WMI-Activity/Operational", "provider": "Microsoft-Windows-WMI-Activity", "eventId": 5857, "title": "WMI provider started (provider host PID)", "fields": ["ProviderName", "ProviderPath", "ProcessID", "HostProcess"], "mapProperties": ["PayloadData1 (ProcessID)", "PayloadData2 (ProviderPath)"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 5156, "title": "Firewall allowed a connection (per process, no Sysmon needed)", "fields": ["Application", "ProcessID", "SourceAddress", "SourcePort", "DestAddress", "DestPort", "Protocol", "Direction"], "mapProperties": ["ExecutableInfo (Application)", "PayloadData1 (SourceAddress:SourcePort)", "PayloadData2 (DestAddress:DestPort)", "PayloadData3 (Protocol)", "PayloadData4 (ProcessID)", "PayloadData5 (Direction)", "PayloadData6 (LayerName)"], "mapStatus": "verified", "default": false, "note": "Off by default: needs 'Audit Filtering Platform Connection' and produces millions of events on a busy host." },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 5158, "title": "Firewall permitted a bind to a local port", "fields": ["Application", "ProcessID", "SourceAddress", "SourcePort", "Protocol"], "mapProperties": ["ExecutableInfo (Application)", "PayloadData1 (SourceAddress:SourcePort)", "PayloadData2 (Protocol)", "PayloadData3 (ProcessId)", "PayloadData4 (LayerName)"], "mapStatus": "verified", "default": false, "note": "Off by default: same volume as 5156." },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4656, "title": "Handle to an object requested (files, registry)", "fields": ["ProcessName", "ProcessId", "ObjectType", "ObjectName", "AccessList"], "mapProperties": ["UserName", "ExecutableInfo (ProcessName + PID)", "PayloadData1 (ObjectType)", "PayloadData2 (ObjectName)", "PayloadData3 (HandleId)", "PayloadData5 (AccessList)", "PayloadData6 (PrivilegeList)"], "mapStatus": "verified", "default": false, "note": "Off by default: only logged where a SACL (auditing rule) is set on the object, and very high volume." },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4663, "title": "Attempt to access an object (files, registry)", "fields": ["ProcessName", "ProcessId", "ObjectType", "ObjectName", "AccessList"], "mapProperties": ["UserName", "PayloadData1 (ObjectServer)", "PayloadData2 (ObjectType)", "PayloadData3 (ObjectName)", "PayloadData4 (AccessList)", "ExecutableInfo (ProcessName)"], "mapStatus": "verified", "default": false, "note": "Off by default: needs a SACL on the object and is very high volume. The EZ map has no ProcessId; the process tree reads it from the raw Payload column." },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4657, "title": "Registry value modified", "fields": ["ProcessName", "ProcessId", "ObjectName", "ObjectValueName", "OldValue", "NewValue"], "mapProperties": ["UserName", "ExecutableInfo (ProcessName + PID)", "PayloadData1 (SubjectLogonId)", "PayloadData2 (OperationType)", "PayloadData3 (ObjectName)", "PayloadData4 (ObjectValueName)", "PayloadData5 (OldValue)", "PayloadData6 (NewValue)"], "mapStatus": "verified", "default": false, "note": "Off by default: needs a SACL on the registry key and is high volume." }
      ]
    },
    {
      "id": "services",
      "title": "Services and persistence",
      "events": [
        { "channel": "System", "provider": "Service Control Manager", "eventId": 7045, "title": "Service installed", "fields": ["ServiceName", "ImagePath", "ServiceType", "StartType", "AccountName"], "mapProperties": ["PayloadData1", "PayloadData2", "PayloadData3", "ExecutableInfo"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4697, "title": "Service installed (security log)", "fields": ["SubjectUserName", "ServiceName", "ServiceFileName", "ServiceType", "ServiceStartType"], "mapStatus": "verified", "default": true },
        { "channel": "System", "provider": "Service Control Manager", "eventId": 7036, "title": "Service state changed", "fields": ["param1 (service name)", "param2 (state)"], "mapProperties": ["PayloadData1 (param1)", "PayloadData2 (param2)"], "mapStatus": "verified", "default": false },
        { "channel": "Microsoft-Windows-Sysmon/Operational", "provider": "Microsoft-Windows-Sysmon", "eventId": 13, "title": "Registry value set (Run keys, services)", "fields": ["Image", "TargetObject", "Details"], "mapProperties": ["UserName (User)", "PayloadData1 (ProcessGuid, ProcessId)", "PayloadData2 (RuleName)", "PayloadData3 (Image)", "PayloadData4 (EventType)", "PayloadData5 (TargetObject)", "PayloadData6 (Details)"], "mapStatus": "verified", "default": false }
      ]
    },
    {
      "id": "tasks",
      "title": "Scheduled tasks",
      "events": [
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "provider": "Microsoft-Windows-TaskScheduler", "eventId": 106, "title": "Scheduled task registered", "fields": ["TaskName", "UserContext"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "provider": "Microsoft-Windows-TaskScheduler", "eventId": 200, "title": "Scheduled task action executed", "fields": ["TaskName", "ActionName", "InstanceId"], "mapProperties": ["PayloadData1 (TaskName)", "PayloadData2 (TaskInstanceId)", "ExecutableInfo (ActionName)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "provider": "Microsoft-Windows-TaskScheduler", "eventId": 140, "title": "Scheduled task updated", "fields": ["TaskName", "UserContext"], "mapProperties": ["UserName (UserName)", "PayloadData1 (TaskName)"], "mapStatus": "verified", "default": false },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4698, "title": "Scheduled task created", "fields": ["SubjectUserName", "TaskName", "TaskContent"], "mapProperties": ["UserName", "PayloadData1", "PayloadData2"], "mapStatus": "verified", "default": true },
        { "channel": "Security", "provider": "Microsoft-Windows-Security-Auditing", "eventId": 4702, "title": "Scheduled task updated (security log)", "fields": ["SubjectUserName", "TaskName", "TaskContent"], "mapProperties": ["UserName (SubjectUserName)", "PayloadData1 (TaskName)", "PayloadData2 (TaskContentNew)"], "mapStatus": "verified", "default": false }
      ]
    },
    {
      "id": "powershell",
      "title": "PowerShell",
      "events": [
        { "channel": "Microsoft-Windows-PowerShell/Operational", "provider": "Microsoft-Windows-PowerShell", "eventId": 4104, "title": "Script block logging", "fields": ["ScriptBlockText", "Path", "ScriptBlockId"], "mapProperties": ["PayloadData1 (Path)", "PayloadData2 (ScriptBlockText)"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-PowerShell/Operational", "provider": "Microsoft-Windows-PowerShell", "eventId": 4103, "title": "Module logging", "fields": ["ContextInfo", "Payload", "CommandName"], "mapStatus": "verified", "default": true },
        { "channel": "Microsoft-Windows-PowerShell/Operational", "provider": "Microsoft-Windows-PowerShell", "eventId": 4105, "title": "Script start", "fields": ["ScriptBlockId", "Path"], "mapStatus": "no-map", "default": false }
      ]
    },
    {
      "id": "rdp",
      "title": "RDP and remote access (lateral movement)",
