<Application x:Class="EzForensics.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EzForensics.App"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/TreeStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
            <local:InverseBoolConverter x:Key="Not"/>
            <local:JobStateBrushConverter x:Key="StateFg"/>
            <local:JobStateBrushConverter x:Key="StateBg" Background="True"/>
            <local:SeverityGlyphConverter x:Key="SevGlyph"/>
            <local:EqualsConverter x:Key="EqBool"/>
            <local:EqualsConverter x:Key="EqVis" ToVisibility="True"/>
            <local:TextOverflowToVisibilityConverter x:Key="TextOverflowVis"/>
            <!-- InfoBar-style banner: <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"/>
                 One line; a long message gets a More / Less toggle that wraps it in full. -->
            <DataTemplate x:Key="InfoBarTemplate">
                <Border AutomationProperties.AutomationId="InfoBar" AutomationProperties.Name="InfoBar" AutomationProperties.HelpText="{Binding Severity}"
                        BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}"/>
                            <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
                            </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontSize="16" Margin="0,0,10,0"
                                   Text="{Binding Severity, Converter={StaticResource SevGlyph}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                    <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="&#xE711;" ToolTip="Dismiss"
                                FontFamily="{StaticResource Font.Icon}" FontSize="10" MinHeight="0" Padding="6" VerticalAlignment="Center"
                                Command="{Binding DataContext.DismissBannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ToggleButton x:Name="more" DockPanel.Dock="Right" Style="{StaticResource ExpanderHeaderToggle}" Margin="8,0,4,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="InfoBar.More" AutomationProperties.Name="Show the whole message">
                            <TextBlock x:Name="moreText" Text="More" FontWeight="Normal" FontSize="{DynamicResource FontSize.Caption}"/>
                            <ToggleButton.Visibility>
                                <MultiBinding Converter="{StaticResource TextOverflowVis}">
                                    <Binding Path="Message"/>
                                    <Binding ElementName="msg" Path="ActualWidth"/>
                                    <Binding ElementName="msg"/>
                                </MultiBinding>
                            </ToggleButton.Visibility>
                        </ToggleButton>
                        <TextBox x:Name="msg" AutomationProperties.AutomationId="InfoBar.Message" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                                 TextWrapping="NoWrap" MinHeight="0" Padding="0" VerticalAlignment="Center" ToolTip="{Binding Message}"/>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="more" Property="IsChecked" Value="True">
                        <Setter TargetName="msg" Property="TextWrapping" Value="Wrap"/>
                        <Setter TargetName="msg" Property="ToolTip" Value="{x:Null}"/>
                        <Setter TargetName="moreText" Property="Text" Value="Less"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- "Tools not installed" banner (Ingest and Tools; non-modal: the wizard no longer opens by itself after the first start);
                 DataContext = page VM -->
            <DataTemplate x:Key="FirstRunTemplate">
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.InfoBg}" Margin="0,0,0,12"
                        Padding="12,8" AutomationProperties.AutomationId="FirstRun.Banner">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="18" Margin="2,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Use existing folder…" Margin="0,0,8,0" Command="{Binding PointToExistingToolsCommand}"
                                    AutomationProperties.AutomationId="FirstRun.ExistingFolder"/>
                            <Button Content="Open setup" Style="{StaticResource AccentButton}" Command="{Binding GoDownloadToolsCommand}"
                                    AutomationProperties.AutomationId="FirstRun.OpenSetup"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tools not installed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <c:HelpTip
                                       Text="EZ Forensics runs Eric Zimmerman's tools (and plaso, Volatility, Zeek...) but does not ship them. Open setup to download them and everything they need, or use a folder you already have (e.g. from Get-ZimmermanTools)."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- One app-built command (SpecialCommandViewModel): read-only live preview with Copy, the user's additional arguments, errors, Save / Reset -->
            <DataTemplate x:Key="SpecialCommandRow">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3"
                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}"/>
                    <Grid>
                        <TextBox Style="{StaticResource MonoBox}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6,36,6" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" Text="{Binding Preview, Mode=OneWay}"
                                 AutomationProperties.AutomationId="Tools.Special.Preview" AutomationProperties.Name="Command preview"/>
                        <Button Style="{StaticResource SubtleButton}" Content="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                Command="{Binding CopyCommand}" ToolTip="Copy command"
                                AutomationProperties.AutomationId="Tools.Special.Copy" AutomationProperties.Name="Copy command"/>
                    </Grid>
                    <TextBlock Text="Additional arguments" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBox Style="{StaticResource MonoBox}" IsReadOnly="False" AcceptsReturn="False" TextWrapping="Wrap"
                             Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" Tag="none"
                             AutomationProperties.AutomationId="Tools.Special.ExtraArgs" AutomationProperties.Name="Additional arguments"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding ArgsHelp}"/>
                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource Brush.Error}"/>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Error}" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                AutomationProperties.AutomationId="Tools.Special.Save"/>
                        <Button Content="Reset" Command="{Binding ResetCommand}" ToolTip="Remove the additional arguments"
                                AutomationProperties.AutomationId="Tools.Special.Reset"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- The Command tile of plaso, Zeek, RITA and Volatility (SpecialCommandTileViewModel), in the disk-tool layout -->
            <DataTemplate x:Key="SpecialCommandTile">
                <StackPanel>
                    <TextBlock Text="Command" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Tile}" AutomationProperties.AutomationId="{Binding AutomationId}">
                        <StackPanel>
                            <!-- Source: what Run reads (remembered) -->
                            <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource MonoBox}" Text="{Binding SourcePath, Mode=OneWay}" Tag="{Binding SourcePlaceholder}"
                                         ToolTip="{Binding SourcePath}" AutomationProperties.AutomationId="Tools.Source.Path"/>
                                <Button Grid.Column="1" Content="{Binding FileButtonText}" Command="{Binding BrowseFileCommand}" Margin="6,0,0,0"
                                        Visibility="{Binding AllowFile, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Source.BrowseFile"/>
                                <Button Grid.Column="2" Content="{Binding FolderButtonText}" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0"
                                        Visibility="{Binding AllowFolder, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Source.Browse"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceHelp}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       AutomationProperties.AutomationId="Tools.Source.Help"/>

                            <!-- Output folder: where the results go (auto = next generated folder) -->
                            <TextBlock Text="Output folder" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource MonoBox}" Text="{Binding OutputDir, Mode=OneWay}" ToolTip="{Binding OutputDir}"
                                         AutomationProperties.AutomationId="Tools.OutputDir.Path"/>
                                <Button Grid.Column="1" Content="Change…" Command="{Binding ChangeOutputDirCommand}" Margin="6,0,0,0"
                                        AutomationProperties.AutomationId="Tools.OutputDir.Change"/>
                                <Button Grid.Column="2" Content="Auto" Command="{Binding ResetOutputDirCommand}" Margin="6,0,0,0" ToolTip="Back to the generated output folder"
                                        IsEnabled="{Binding OutputDirIsCustom}" AutomationProperties.AutomationId="Tools.OutputDir.Auto"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{Binding OutputHelp}"/>

                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpecialCommandRow}" Focusable="False"
                                          AutomationProperties.AutomationId="Tools.Special.Rows"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding RunCommand}" Style="{StaticResource AccentButton}" MinWidth="90" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="Tools.Special.Run">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12"/>
                                        <TextBlock Text="{Binding RunText}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" Margin="0,0,6,0"
                                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Special.Secondary"/>
                                <TextBlock Text="{Binding RunHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0"
                                           Visibility="{Binding HasRunHint, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Special.RunHint"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
