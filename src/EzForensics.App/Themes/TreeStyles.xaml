<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Guide-line tree (shared by the Analyze case tree and the process graph Navigator): guide lines (vertical per level + elbow to each child),
         a separator between top-level sections, semibold section headers. The item DataContext supplies IsExpanded, IsSelected (TwoWay), IsLast,
         IsFirst, IsTopLevel, IsOpenHighlighted and IsMultiSelected; derive with BasedOn to add automation, visibility or a different IsSelected source.
         The chevron is the TreeToggle style (Controls.xaml). -->
        <Style x:Key="GuideTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Border x:Name="Section" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GuideCol" Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- sibling line: runs past this item (and its children) down to the next sibling -->
                                <Rectangle x:Name="VLine" Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="9,0,0,0"
                                           Fill="{DynamicResource Brush.BorderStrong}" SnapsToDevicePixels="True"/>
                                <!-- top half of the sibling line + elbow into this item's expander -->
                                <Grid x:Name="Elbow" Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Width="1" HorizontalAlignment="Left" Margin="9,0,0,0" Fill="{DynamicResource Brush.BorderStrong}" SnapsToDevicePixels="True"/>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="9,0,0,0" Fill="{DynamicResource Brush.BorderStrong}" SnapsToDevicePixels="True"/>
                                </Grid>
                                <!-- line from an expanded folder's chevron down to its first child -->
                                <Grid x:Name="Tail" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Width="1" HorizontalAlignment="Left" Margin="9,6,0,0" Fill="{DynamicResource Brush.BorderStrong}" SnapsToDevicePixels="True"/>
                                </Grid>
                                <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="0,3,2,3" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeToggle}" ClickMode="Press"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsExpanded" Value="True"/>
                                    <Condition Property="HasItems" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Tail" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter TargetName="VLine" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- top-level sections: no guide column, semibold header, separator above every section but the first -->
                            <DataTrigger Binding="{Binding IsTopLevel}" Value="True">
                                <Setter TargetName="GuideCol" Property="Width" Value="0"/>
                                <Setter TargetName="VLine" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Elbow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTopLevel}" Value="True"/>
                                    <Condition Binding="{Binding IsFirst}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Section" Property="BorderThickness" Value="0,1,0,0"/>
                                <Setter TargetName="Section" Property="Margin" Value="0,3,0,0"/>
                                <Setter TargetName="Section" Property="Padding" Value="0,3,0,0"/>
                            </MultiDataTrigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control}"/>
                            </Trigger>
                            <!-- selection highlight follows the multi-selection (a plain click makes it the single selected item) -->
                            <DataTrigger Binding="{Binding IsOpenHighlighted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
