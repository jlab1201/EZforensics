<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Window" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush.Nav" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#A3A3A3"/>
