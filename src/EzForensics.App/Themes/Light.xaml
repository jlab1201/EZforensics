    <SolidColorBrush x:Key="Brush.Role.System" Color="#56688F"/>
    <SolidColorBrush x:Key="Brush.Role.Session" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.Role.Services" Color="#0D9488"/>
    <SolidColorBrush x:Key="Brush.Role.Security" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Role.Desktop" Color="#0284C7"/>
    <SolidColorBrush x:Key="Brush.Role.Shells" Color="#EA580C"/>
    <SolidColorBrush x:Key="Brush.Role.Admin" Color="#C026D3"/>
    <SolidColorBrush x:Key="Brush.Role.Remote" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Role.Office" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Role.Browsers" Color="#7C3AED"/>
    <SolidColorBrush x:Key="Brush.Role.Other" Color="#9CA3AF"/>
    <!-- Filter expression syntax colours (Timeline Explorer / DevExpress style) -->
    <SolidColorBrush x:Key="Filter.Column" Color="#1A5FB4"/>
    <SolidColorBrush x:Key="Filter.Function" Color="#8E3FB3"/>
    <SolidColorBrush x:Key="Filter.Operator" Color="#555555"/>
    <SolidColorBrush x:Key="Filter.String" Color="#B5281F"/>
    <SolidColorBrush x:Key="Filter.Number" Color="#0E7C7B"/>
    <SolidColorBrush x:Key="Filter.Logical" Color="#C25E00"/>
    <SolidColorBrush x:Key="Filter.Not" Color="#C01C28"/>
    <SolidColorBrush x:Key="Filter.Paren" Color="#555555"/>
