<UserControl x:Class="EzForensics.App.Views.ColumnFilterPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
             Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource Font.UI}" FontSize="12.5"
             AutomationProperties.AutomationId="Results.Funnel" AutomationProperties.Name="Column filter"
             KeyDown="Popup_KeyDown">
    <UserControl.Resources>
        <Style x:Key="TabToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
            CornerRadius="6" Padding="10" Width="340" Margin="0,2,8,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Column}" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton GroupName="tabs" Style="{StaticResource TabToggle}" Content="Values" AutomationProperties.AutomationId="Results.Funnel.TabValues"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource EqBool}, ConverterParameter=0}"/>
                <RadioButton GroupName="tabs" Style="{StaticResource TabToggle}" Content="Dates" AutomationProperties.AutomationId="Results.Funnel.TabDates"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource EqBool}, ConverterParameter=1}"
                              Visibility="{Binding IsDateColumn, Converter={StaticResource BoolToVis}}"/>
                <RadioButton GroupName="tabs" Style="{StaticResource TabToggle}" Content="Custom filter…" AutomationProperties.AutomationId="Results.Funnel.TabCustom"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource EqBool}, ConverterParameter=2}"/>
            </StackPanel>

            <!-- footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="Clear" Command="{Binding ClearColumnCommand}" AutomationProperties.AutomationId="Results.Funnel.Clear"
                        ToolTip="Remove this column's value/custom filter"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Results.Funnel.Cancel"/>
                    <Button Content="OK" Style="{StaticResource AccentButton}" Command="{Binding OkCommand}" MinWidth="70" IsDefault="True"
                            AutomationProperties.AutomationId="Results.Funnel.Ok"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- values -->
                <DockPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=0}">
                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search values…"
                             AutomationProperties.AutomationId="Results.Funnel.Search" AutomationProperties.Name="Search values"/>
                    <ProgressBar DockPanel.Dock="Top" Maximum="1" Value="{Binding Progress}" Margin="0,6,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="2,8,0,4">
                        <CheckBox Content="(Select All)" IsChecked="{Binding SelectAll}" AutomationProperties.AutomationId="Results.Funnel.SelectAll" Margin="0,0,0,4"/>
                        <CheckBox IsChecked="{Binding BlanksChecked}" AutomationProperties.AutomationId="Results.Funnel.Blanks" AutomationProperties.Name="(Blanks)" Margin="0,0,0,4">
                            <TextBlock><Run Text="(Blanks)"/><Run Text="  "/><Run Text="{Binding BlankCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource Brush.TextSecondary}"/></TextBlock>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding NonBlanksChecked}" AutomationProperties.AutomationId="Results.Funnel.NonBlanks" AutomationProperties.Name="(Non blanks)">
                            <TextBlock><Run Text="(Non blanks)"/><Run Text="  "/><Run Text="{Binding NonBlankCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource Brush.TextSecondary}"/></TextBlock>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="Results.Funnel.Note"/>
                    <ListBox ItemsSource="{Binding ItemsView}" Height="260" AutomationProperties.AutomationId="Results.Funnel.Values"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Value}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ValueItem}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,0"/>
                                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Value}">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- dates -->
                <DockPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=1}">
                    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Visibility="{Binding DatesLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
                    <CheckBox DockPanel.Dock="Top" IsChecked="{Binding DateBlanksChecked}" Margin="2,0,0,6" AutomationProperties.AutomationId="Results.Funnel.DateBlanks">
                        <TextBlock><Run Text="(Blanks / not a date)"/><Run Text="  "/><Run Text="{Binding DateBlankCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource Brush.TextSecondary}"/></TextBlock>
                    </CheckBox>
                    <TreeView ItemsSource="{Binding Years}" Height="300" AutomationProperties.AutomationId="Results.Funnel.DateTree">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DateNode}" ItemsSource="{Binding Children}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,0"/>
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"/>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <!-- custom -->
                <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=2}">
                    <TextBlock Text="Show rows where the value" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Ops}" SelectedItem="{Binding Custom1.Op}" AutomationProperties.AutomationId="Results.Funnel.Custom1.Op"/>
                    <TextBox Text="{Binding Custom1.Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="value"
                             IsEnabled="{Binding Custom1.NeedsValue}" AutomationProperties.AutomationId="Results.Funnel.Custom1.Value"/>
                    <TextBox Text="{Binding Custom1.Value2, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="and (upper bound)"
                             Visibility="{Binding Custom1.IsBetween, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox SelectedIndex="{Binding CustomJoinIndex}" Width="90" HorizontalAlignment="Left" Margin="0,10,0,10"
                              AutomationProperties.AutomationId="Results.Funnel.Custom.Join">
                        <ComboBoxItem Content="And"/>
                        <ComboBoxItem Content="Or"/>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding Ops}" SelectedItem="{Binding Custom2.Op}" AutomationProperties.AutomationId="Results.Funnel.Custom2.Op"/>
                    <TextBox Text="{Binding Custom2.Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="value (leave empty for one condition)"
                             IsEnabled="{Binding Custom2.NeedsValue}" AutomationProperties.AutomationId="Results.Funnel.Custom2.Value"/>
                    <TextBox Text="{Binding Custom2.Value2, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="and (upper bound)"
                             Visibility="{Binding Custom2.IsBetween, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="Wildcards and comparisons"/>
                        <c:HelpTip Margin="6,0,0,0"
                                   Text="Like: * matches any text, ? one character. Greater/Less/Between compare numbers and dates when the value parses as one."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
