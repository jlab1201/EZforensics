<UserControl x:Class="EzForensics.App.Views.Analyze.ProcessTreePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:an="clr-namespace:EzForensics.App.Views.Analyze"
             xmlns:core="clr-namespace:EzForensics.Core.Processes;assembly=EzForensics.Core">
    <!-- Analyze > Process tree of one host (DataContext: ProcessTreeViewModel). Hosted in the top half of the Analyze right pane (ResultsView; the events grid is below); Close (x) releases it.
         The canvas fills the pane; the controls float over it: host chip (top-left), one bottom bar (centred at the bottom: View menu
         popover above it, zoom out / slider / in, Navigator, Close), status toast (bottom-centre, above the bar), detail card (top-right), Navigator panel (left).
         Floating: Results.ProcessTree.(HostChip|ViewMenu|ViewMenu.ShowWholeTree|ShowGrid|ZoomBar|Toast),
                   Results.ProcessTree.Navigator.Close (Sources is the host chip's tooltip),
         AutomationIds: Results.ProcessTree.Stack.{ParentPid|Root}.{name},
                        Results.ProcessTree.Node.{Pid}.Services, Results.ProcessTree.Node.{Pid}.Exited (stop marker), Results.ProcessTree.Region.{ParentPid} (zoomed-out region fill of the subtrees under a boot-chain process),
                        Results.ProcessTree.Navigator(.Toggle|.Clear|.RoleSwatch.{RoleKey}|.More.{Section}.{Key}|.Section.{Section}|.Empty.{Section}|.Group.{Section}.{Key}|.Member.{Pid}), Results.ProcessTree.Detail.(GhostCard|GhostNote),
                        Results.ProcessTree.(Pane|Title|ShowExited|Fit|Close|Sources|Warnings|Status|Canvas)
                        Results.ProcessTree.PidChooser(.Item|.Dismiss) (PID link that matches several instances),
                        Results.ProcessTree.Zoom(In|Out|Slider), Results.ProcessTree.Node.{Pid}, Results.ProcessTree.Node.{Pid}.(Expand|Collapse)
                        Results.ProcessTree.Detail.(Card|Close|Collapse|Copy|Rail|Rail.{ProcessTab}|TabTitle|Badges|Field.{FieldId}|Field.{FieldId}.Copy|Field.{FieldId}.More|Markers|
                        SubTabs|Tab.{RowSetId}|Grid|TierChip|SourceChip|Message|TabMessage|Note|OpenInGrid) -->
    <UserControl.Resources>
        <!-- marker badge: Kind -> theme brush -->
        <DataTemplate DataType="{x:Type vm:ProcessBadge}">
            <Border x:Name="b" CornerRadius="3" BorderThickness="1" Padding="3,0" Margin="4,0,0,0" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.Neutral}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <TextBlock x:Name="t" Text="{Binding Text}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.NeutralText}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="error">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="orange">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Orange}"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Brush.Orange}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="warn">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="info">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Info}"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- small pill buttons on the canvas ("N children", collapse) -->
        <Style x:Key="GraphPillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="13.5" Padding="{TemplateBinding Padding}" Background="{DynamicResource Brush.Control}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- role colour (DataContext.RoleKey: ProcessNodeViewModel, or a Navigator Roles group): the node diamond's fill and the Navigator swatch (the legend).
             The shape sets no Fill of its own, so these style triggers apply; a template trigger (ghost) still overrides them. -->
        <Style x:Key="RoleFill" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource Brush.Role.Other}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RoleKey}" Value="System"><Setter Property="Fill" Value="{DynamicResource Brush.Role.System}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Session"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Session}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Services"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Services}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Security"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Security}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Desktop"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Desktop}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Shells"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Shells}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Admin"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Admin}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Remote"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Remote}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Office"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Office}"/></DataTrigger>
                <DataTrigger Binding="{Binding RoleKey}" Value="Browsers"><Setter Property="Fill" Value="{DynamicResource Brush.Role.Browsers}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one process on the isometric floor (Tanium style): a small diamond on a pedestal, the name pill to its right, "N children" / collapse / services under the pill.
             Fixed size ProcessGraphCanvas.NodeWidth x NodeHeight (210 x 72, 1.5x since Oct 27); the diamond centre (24,27) = ProcessGraphCanvas.DiamondCenterX/Y is the layout anchor
             where edges meet. The diamond is filled by the role (RoleFill, Brush.Role.*); its outline shows the severity / group / selection. The PID, role and badge texts
             are in the tooltip (an explicit wrapping ToolTip, capped width: long command lines must not run off the screen); the dot at the diamond's top-right shows the
             strongest badge (Severity). Always solid (no root Opacity): exited = dashed outline + grey stop marker, ghost = hollow dashed diamond + italic grey name,
             dimmed (not in the highlighted Navigator group) = grey diamond and name. -->
        <DataTemplate x:Key="ProcessNodeTemplate" DataType="{x:Type vm:ProcessNodeViewModel}">
            <Grid x:Name="root" Background="Transparent" Cursor="Hand"
                  AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}}"
                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding PidText}"
                  AutomationProperties.ItemStatus="{Binding Severity}">
                <!-- diamond column: pedestal (soft radial contact shadow, opacity mask instead of a BlurEffect), 33 px diamond with a gear, severity dot -->
                <Grid Width="48" Height="54" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ToolTip>
                        <ToolTip MaxWidth="500" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" MaxWidth="480"/></ToolTip>
                    </Grid.ToolTip>
                    <Ellipse Width="39" Height="13.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0"
                             Fill="{DynamicResource Brush.TextDisabled}" Opacity="0.6" IsHitTestVisible="False">
                        <Ellipse.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#80000000" Offset="0.45"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.OpacityMask>
                    </Ellipse>
                    <Grid Width="33" Height="33" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7.5,10.5,0,0">
                        <Path x:Name="diamond" Data="M16.5,0.9 L32.1,16.5 L16.5,32.1 L0.9,16.5 Z" Style="{StaticResource RoleFill}" Stroke="{DynamicResource Brush.BorderStrong}"
                              StrokeThickness="1.2"/>
                        <!-- light gear on the role colour (every Brush.Role.* is a mid tone in both themes) -->
                        <TextBlock x:Name="gear" Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.AccentText}"/>
                    </Grid>
                    <!-- exited: small grey stop marker at the diamond's bottom-left -->
                    <Grid x:Name="exitedMark" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,31.5,0,0" Visibility="Collapsed"
                          IsHitTestVisible="False" AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.Exited}">
                        <Ellipse Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.TextDisabled}" StrokeThickness="1"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Grid>
                    <Ellipse x:Name="dot" Width="10.5" Height="10.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,7.5,0,0" StrokeThickness="1"
                             Stroke="{DynamicResource Brush.Input}" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Margin="45,13.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid HorizontalAlignment="Left">
                        <!-- ghost parent: dashed outline instead of the pill border -->
                        <Rectangle x:Name="ghostOutline" RadiusX="12" RadiusY="12" StrokeThickness="1" StrokeDashArray="3 2" Stroke="{DynamicResource Brush.TextDisabled}"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="pill" CornerRadius="12" Padding="9,1.5"
                                Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="500" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" MaxWidth="480"/></ToolTip>
                            </Border.ToolTip>
                            <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="135"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- under the pill: "N children" when collapsed, a small round collapse button when expanded; svcscan services count (names in the tooltip) -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" HorizontalAlignment="Left">
                        <!-- path view: the topmost drawn ancestor reveals one more ancestor per click -->
                        <Button x:Name="expandUp" Style="{StaticResource GraphPillButton}" Padding="9,0" Margin="0,0,4.5,0" Command="{Binding ExpandUpCommand}"
                                Visibility="{Binding CanExpandUp, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ExpandUpToolTip}"
                                AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.ExpandUp}"
                                AutomationProperties.Name="{Binding ExpandUpToolTip}">
                            <TextBlock Text="{Binding ExpandUpText}" FontSize="14.25"/>
                        </Button>
                        <Button x:Name="expand" Style="{StaticResource GraphPillButton}" Padding="9,0" Command="{Binding ToggleCommand}" Visibility="Collapsed"
                                ToolTip="Show the child processes"
                                AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.Expand}"
                                AutomationProperties.Name="{Binding ChildrenText, StringFormat=Expand {0}}">
                            <TextBlock Text="{Binding ChildrenText}" FontSize="14.25"/>
                        </Button>
                        <Button x:Name="collapse" Style="{StaticResource GraphPillButton}" Padding="0" Width="22.5" Height="22.5" Command="{Binding ToggleCommand}"
                                Visibility="Collapsed" ToolTip="Hide the child processes"
                                AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.Collapse}"
                                AutomationProperties.Name="Collapse children">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="11"/>
                        </Button>
                        <Border x:Name="services" CornerRadius="10.5" BorderThickness="1" Padding="6,0" Margin="4.5,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Brush.Info}" Background="{DynamicResource Brush.Surface}" ToolTip="{Binding ServicesTip}"
                                Visibility="{Binding HasServices, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.Services}"
                                AutomationProperties.Name="{Binding ServicesText}" AutomationProperties.HelpText="{Binding ServicesTip}">
                            <TextBlock Text="{Binding ServiceCount, StringFormat={}{0:N0} svc}" FontSize="13.5" Foreground="{DynamicResource Brush.Info}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- data chips: one small pill above the diamond holding every card tab with linked rows (rail glyph + count, accent); its bottom
                     sits just above the diamond. Only while the names are readable (ProcessGraphCanvas.NamesVisible). A click on an icon opens that tab. -->
                <Canvas x:Name="chipsHost" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding (c:ProcessGraphCanvas.NamesVisible), RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                    <Border Canvas.Left="5" Canvas.Bottom="-7" CornerRadius="6" Padding="3,0,3,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}"
                            Background="{DynamicResource Brush.Surface}"
                            Visibility="{Binding HasDataChips, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding DataChips}" Focusable="False" IsTabStop="False"
                                  AutomationProperties.AutomationId="{Binding Pid, StringFormat=Results.ProcessTree.Node.{0}.Data}" AutomationProperties.Name="Linked data">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessDataChip}">
                                <Button Command="{Binding DataContext.OpenDataTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Cursor="Hand" Focusable="False" ToolTip="{Binding ToolTipText}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding ToolTipText}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="4" Padding="2,0,2,0" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="g" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Accent}"/>
                                                    <TextBlock x:Name="n" Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Accent}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                                    <Setter TargetName="n" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasChildren}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="expand" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasChildren}" Value="True"/>
                        <Condition Binding="{Binding IsExpanded}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="collapse" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsExited}" Value="True">
                    <Setter TargetName="diamond" Property="StrokeDashArray" Value="3 2"/>
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="exitedMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info">
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Info}"/>
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brush.Info}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="warn">
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Warning}"/>
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="orange">
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Orange}"/>
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brush.Orange}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="error">
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Error}"/>
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brush.Error}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Navigator group: everything not in it is muted (solid grey diamond and name, no fade); before the ghost trigger so a ghost stays hollow -->
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="diamond" Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="gear" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                    <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                </DataTrigger>
                <!-- ghost parent: a placeholder for a process that is in no source (dashed diamond, muted italic text) -->
                <DataTrigger Binding="{Binding IsGhost}" Value="True">
                    <Setter TargetName="diamond" Property="StrokeDashArray" Value="3 2"/>
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="diamond" Property="Fill" Value="Transparent"/>
                    <Setter TargetName="gear" Property="Text" Value="&#xE897;"/>
                    <Setter TargetName="gear" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="nm" Property="FontStyle" Value="Italic"/>
                    <Setter TargetName="nm" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                    <Setter TargetName="pill" Property="Background" Value="Transparent"/>
                    <Setter TargetName="pill" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="ghostOutline" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Navigator group: members ringed in the accent colour (never dimmed); selection wins last -->
                <DataTrigger Binding="{Binding IsGroupMember}" Value="True">
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="pill" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="pill" Property="Padding" Value="8,0.5"/>
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                    <Setter TargetName="diamond" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- same-name sibling stack ("svchost.exe ×24", exited count under it), or while expanded the small "collapse stack" pill in front of its members.
             Same fixed size and diamond centre as a node: two offset diamonds on a pedestal + a pill. Solid; dimmed = grey diamonds and text. -->
        <DataTemplate x:Key="ProcessStackTemplate" DataType="{x:Type vm:ProcessStackViewModel}">
            <Grid x:Name="root" Background="Transparent">
                <Grid Width="48" Height="54" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Ellipse Width="42" Height="13.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0" Fill="{DynamicResource Brush.TextDisabled}" Opacity="0.6">
                        <Ellipse.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#80000000" Offset="0.45"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.OpacityMask>
                    </Ellipse>
                    <Path x:Name="back" Data="M30,4.5 L43.5,18 L30,31.5 L16.5,18 Z" Fill="{DynamicResource Brush.SurfaceAlt}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1"/>
                    <Path x:Name="front" Data="M24,11.4 L39.6,27 L24,42.6 L8.4,27 Z" Fill="{DynamicResource Brush.SurfaceAlt}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.2"/>
                </Grid>
                <StackPanel Margin="45,13.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button x:Name="stack" Style="{StaticResource GraphPillButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                            Padding="9,1.5"
                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Text}"
                            AutomationProperties.HelpText="Expand the stack">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="500" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" MaxWidth="480"/></ToolTip>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="stackName" Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="87" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock x:Name="stackCount" Text="{Binding CountText}" FontSize="16.5" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Margin="7.5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="exited" Text="{Binding ExitedText}" FontSize="14.25" Margin="6,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding HasExited, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="collapse" Style="{StaticResource GraphPillButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                            Padding="9,1.5" Visibility="Collapsed"
                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Text, StringFormat=Collapse stack {0}}"
                            AutomationProperties.HelpText="Collapse the stack">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="500" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" MaxWidth="480"/></ToolTip>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock FontSize="15" Margin="7.5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120">
                                <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding CountText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="stack" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="exited" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="collapse" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="back" Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="front" Property="Fill" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="stackName" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                    <Setter TargetName="stackCount" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                    <Setter TargetName="collapse" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Navigator tree (guide lines from Themes/TreeStyles.xaml). A click on a row runs its action (ProcessTreePane.NavTree_MouseLeftButtonDown, registered on the TreeView): group highlights / clears, member reveals, section folds. -->
        <Style x:Key="NavTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource GuideTreeItem}">
            <Setter Property="IsSelected" Value="{Binding RowSelected, Mode=TwoWay}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNote}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Navigator: member row (name, PID, start; indicator evidence on a second line and as tooltip) -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigatorMemberViewModel}">
            <StackPanel Margin="0,0,4,0" ToolTip="{Binding ToolTipText}" AutomationProperties.HelpText="{Binding PidText}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PidText}" FontSize="11" FontFamily="{DynamicResource Font.Mono}" Margin="6,0,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <!-- flagged: a warning flag before a bold name, so "N flagged" in the group can be found -->
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVis}}"
                               ToolTip="Flagged" AutomationProperties.AutomationId="{Binding PidText, StringFormat=Results.ProcessTree.Navigator.Flagged.{0}}"/>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.Caption}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding StartText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <TextBlock Text="{Binding Evidence}" FontSize="11" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Navigator: group row (click selects / clears it) with its members underneath -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigatorGroupViewModel}" ItemsSource="{Binding Children}">
            <DockPanel Margin="0,0,4,0" ToolTip="Highlight these processes on the canvas (click again to clear)" AutomationProperties.ItemStatus="{Binding CountText}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="{DynamicResource FontSize.Small}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                <!-- Roles: the role's diamond colour (the canvas legend) -->
                <Path DockPanel.Dock="Left" Data="M5,0 L10,5 L5,10 L0,5 Z" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource RoleFill}"
                      Visibility="{Binding HasRoleSwatch, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.AutomationId="{Binding RoleKey, StringFormat=Results.ProcessTree.Navigator.RoleSwatch.{0}}"/>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize.Caption}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- Navigator: section header (click folds) + its groups, or the empty note -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigatorSectionViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding HeaderText}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <!-- Indicators: "Flag all" flags every source row of every listed process (the click never folds the section: ProcessTreePane skips buttons) -->
                <Button Style="{DynamicResource GlassPillButton}" Padding="7,0" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                        Visibility="{Binding CanFlagAll, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.FlagAllIndicatorsCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                        ToolTip="Flag all: give every source row of every process listed under Indicators the last used flag"
                        AutomationProperties.AutomationId="Results.ProcessTree.Navigator.FlagAll" AutomationProperties.Name="Flag all">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Flag all" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Navigator: disabled note line (empty section, "+ N more") -->
        <DataTemplate DataType="{x:Type vm:NavigatorNoteViewModel}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,4,0"/>
        </DataTemplate>

        <!-- rail icon: glyph + linked-row count; a tab with nothing linked is dimmed, never hidden -->
        <Style x:Key="RailItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Results.ProcessTree.Detail.Rail.{0}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding CountText}"/>
        </Style>
        <Style x:Key="SubTabItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationKey, StringFormat=Results.ProcessTree.Detail.Tab.{0}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusText}"/>
        </Style>
        <!-- row-number gutter for the detail grid (position in the view; the rows carry no CSV row index) -->
        <Style x:Key="DetailRowNumberHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border x:Name="gutter" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,1,1" Padding="4,0,6,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{DynamicResource FontSize.Small}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsRowSelected" Value="True">
                                <Setter TargetName="gutter" Property="Background" Value="{DynamicResource Brush.Control}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- row chips (FacetGridColumns builds the Tier / Source columns from these keys) -->
        <DataTemplate x:Key="TierChipTemplate" DataType="{x:Type core:ProcessActivityRow}">
            <Border x:Name="b" CornerRadius="3" BorderThickness="1" Padding="5,1" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.Success}" Background="{DynamicResource Brush.SuccessBg}"
                    Visibility="{Binding HasTier, Converter={StaticResource BoolToVis}}"
                    ToolTip="Exact: a memory row of this PID in the same image, the same Sysmon ProcessGuid, or the same PID inside the process lifetime"
                    AutomationProperties.AutomationId="Results.ProcessTree.Detail.TierChip" AutomationProperties.Name="{Binding TierText}">
                <TextBlock x:Name="t" Text="{Binding TierText}" FontSize="11" FontFamily="{DynamicResource Font.UI}" Foreground="{DynamicResource Brush.Success}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TierText}" Value="Path + time">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Info}"/>
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                    <Setter TargetName="b" Property="ToolTip" Value="Path + time: the same full program path, a row time that fits this instance, and no other instance fits"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SourceChipTemplate" DataType="{x:Type core:ProcessActivityRow}">
            <Border CornerRadius="3" BorderThickness="1" Padding="5,1" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" Background="{DynamicResource Brush.SurfaceAlt}" ToolTip="{Binding Source}"
                    AutomationProperties.AutomationId="Results.ProcessTree.Detail.SourceChip" AutomationProperties.Name="{Binding Source}">
                <TextBlock Text="{Binding Source}" FontSize="11" FontFamily="{DynamicResource Font.UI}" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Border>
        </DataTemplate>

        <!-- one sub-tab: compact rows grid with chips, or the reason there are none -->
        <DataTemplate DataType="{x:Type vm:RowSetViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="Results.ProcessTree.Detail.Note" AutomationProperties.Name="{Binding Note}"/>
                <Grid>
                    <DataGrid an:FacetGridColumns.Spec="{Binding Spec}" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"
                              CurrentItem="{Binding SelectedRow, Mode=OneWayToSource}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                              RowHeight="24" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Small}" Background="Transparent"
                              ColumnHeaderStyle="{StaticResource CompactHeader}" GridLinesVisibility="None"
                              ClipboardCopyMode="IncludeHeader" HeadersVisibility="All" RowHeaderWidth="44" an:FacetGridColumns.RowNumbers="True"
                              RowHeaderStyle="{StaticResource DetailRowNumberHeaderStyle}"
                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.AutomationId="Results.ProcessTree.Detail.Grid" AutomationProperties.Name="{Binding Title}"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding HasRows, Converter={StaticResource BoolToVisInv}}"
                               AutomationProperties.AutomationId="Results.ProcessTree.Detail.Message" AutomationProperties.Name="{Binding Message}"/>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- detail card body (title bar is outside so it stays when the card is collapsed) -->
        <DataTemplate x:Key="DetailBodyTemplate" DataType="{x:Type vm:ProcessDetailViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- icon rail: one icon per tab (ProcessDetailViewModel.RailTabs) -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ItemContainerStyle="{StaticResource RailItem}"
                             BorderThickness="0" Background="Transparent" Margin="2,6,2,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="Results.ProcessTree.Detail.Rail" AutomationProperties.Name="Detail tabs">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DetailTabViewModel}">
                                <!-- a tab with linked rows gets an accent icon and a filled notification badge (count) on its top-right corner;
                                     an empty tab stays dimmed with no badge -->
                                <Grid x:Name="sp" Width="38" Height="34" Margin="0,2,0,2">
                                    <TextBlock x:Name="ic" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" MinWidth="18" Height="18" CornerRadius="9"
                                            Padding="4,0" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed">
                                        <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDim}" Value="True">
                                        <Setter TargetName="sp" Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasData}" Value="True">
                                        <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <DockPanel Grid.Column="1" Margin="12,8,10,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="40" Height="3" VerticalAlignment="Center"
                                     Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SelectedTab.Title}" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="Results.ProcessTree.Detail.TabTitle"/>
                    </DockPanel>

                    <!-- Overview: badges, Tanium key / values (each with a copy button), markers -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedTab.IsOverview, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Badges}" Focusable="False" Margin="-4,0,0,8"
                                          Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.AutomationId="Results.ProcessTree.Detail.Badges">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProcessDetailField}">
                                        <Grid x:Name="fieldRow" Background="Transparent" Margin="0,0,0,7" AutomationProperties.AutomationId="{Binding Id, StringFormat=Results.ProcessTree.Detail.Field.{0}}"
                                              AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Value}"
                                              ToolTip="{Binding Hint}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Hint}" Value="">
                                                            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <StackPanel x:Name="valBox" Grid.Column="1">
                                                <!-- a long value shows 3 lines (the Border clips at 3 x the line height) until "more…" -->
                                                <Border x:Name="valClip" ClipToBounds="True">
                                                    <TextBox x:Name="val" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                             BorderThickness="0" Background="Transparent" Padding="0" Foreground="{DynamicResource Brush.Text}" MinHeight="0"
                                                             VerticalScrollBarVisibility="Disabled"/>
                                                </Border>
                                                <Button x:Name="more" Style="{StaticResource LinkButton}" Visibility="Collapsed" Margin="0,2,0,0" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Left"
                                                        Content="{Binding MoreText, Mode=OneWay}" Command="{Binding ToggleExpandedCommand}"
                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Results.ProcessTree.Detail.Field.{0}.More}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="link" Grid.Column="1" TextWrapping="Wrap" Visibility="Collapsed">
                                                <Hyperlink Command="{Binding DataContext.SelectParentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           AutomationProperties.AutomationId="Results.ProcessTree.Detail.ParentLink">
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <Button x:Name="copy" Grid.Column="2" Style="{StaticResource SubtleButton}" Command="{Binding CopyCommand}" MinHeight="0" MinWidth="0"
                                                    Opacity="0" Width="22" Height="22" Padding="0" Margin="4,-2,0,0" VerticalAlignment="Top" ToolTip="{Binding CopyTip}"
                                                    Visibility="{Binding CanCopy, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Results.ProcessTree.Detail.Field.{0}.Copy}"
                                                    AutomationProperties.Name="{Binding CopyTip}">
                                                <TextBlock x:Name="copyGlyph" Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- copy button shows on row hover / keyboard focus only -->
                                            <Trigger SourceName="fieldRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="copy" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger SourceName="fieldRow" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="copy" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                <Setter TargetName="copy" Property="Opacity" Value="1"/>
                                                <Setter TargetName="copyGlyph" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="copyGlyph" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsLong}" Value="True"/>
                                                    <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="valClip" Property="MaxHeight" Value="52"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsLong}" Value="True">
                                                <Setter TargetName="more" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                <Setter TargetName="valBox" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="link" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="—">
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter TargetName="val" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                <Setter TargetName="val" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding MarkerLines}" Margin="0,4,0,0" Focusable="False"
                                          Visibility="{Binding HasMarkers, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.AutomationId="Results.ProcessTree.Detail.Markers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="10,6" MinHeight="32" CornerRadius="4" BorderThickness="1"
                                                Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Warning}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- data tabs: sub-tabs (one per source) + grid -->
                    <DockPanel Visibility="{Binding SelectedTab.IsRows, Converter={StaticResource BoolToVis}}">
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SelectedTab.Sets}" SelectedItem="{Binding SelectedTab.SelectedSet}"
                                 ItemContainerStyle="{StaticResource SubTabItem}" BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding SelectedTab.HasSubTabs, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.AutomationId="Results.ProcessTree.Detail.SubTabs" AutomationProperties.Name="Sources">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RowSetViewModel}">
                                    <TextBlock x:Name="t" Text="{Binding Title}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDim}" Value="True">
                                            <Setter TargetName="t" Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding OpenRowsInGridCommand}"
                                Style="{StaticResource SubtleButton}" ToolTip="Open the rows' CSV in the Analyze table, filtered to these rows (the selected row's CSV when the rows come from several)"
                                AutomationProperties.AutomationId="Results.ProcessTree.Detail.OpenInGrid" AutomationProperties.Name="Open rows in table">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="Open rows in table" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <ContentControl Content="{Binding SelectedTab.SelectedSet}" IsTabStop="False"/>
                            <TextBlock Text="{Binding SelectedTab.Message}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12"
                                       Visibility="{Binding SelectedTab.Message, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.AutomationId="Results.ProcessTree.Detail.TabMessage"/>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- floating "glass" chip over the canvas: a translucent Surface layer with a soft shadow under opaque content (text stays crisp) -->
        <Style x:Key="GlassChip" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}" Opacity="0.92">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the Navigator panel: like GlassChip (rounded corners, border, soft shadow) but fully opaque, so the graph never shows through -->
        <Style x:Key="SolidPanel" TargetType="ContentControl" BasedOn="{StaticResource GlassChip}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Control}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- small text pill on a chip ("Show whole tree") -->
        <Style x:Key="GlassPillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- full-width row in the View menu popover -->
        <Style x:Key="MenuRowButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </UserControl.Resources>

    <c:AutomationPane AutomationProperties.AutomationId="Results.ProcessTree.Pane" AutomationProperties.Name="Process tree">
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <!-- the canvas fills the pane; every control floats over it as a small glass chip -->
            <Grid x:Name="CanvasHost">
                <c:ProcessGraphCanvas x:Name="Canvas" Source="{Binding}" FitToScreen="{Binding FitToScreen, Mode=TwoWay}" FitBottomInset="44" ShowGrid="{Binding ShowGrid}" NodeTemplate="{StaticResource ProcessNodeTemplate}"
                                      StackTemplate="{StaticResource ProcessStackTemplate}"
                                      AutomationProperties.AutomationId="Results.ProcessTree.Canvas" AutomationProperties.Name="Process graph"/>

                <!-- top-left: host chip, PID chooser under it, then the floating Navigator -->
                <Grid HorizontalAlignment="Left" Margin="10,10,60,52">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" HorizontalAlignment="Left">
                        <c:AutomationPane DockPanel.Dock="Left" VerticalAlignment="Top"
                                          AutomationProperties.AutomationId="Results.ProcessTree.HostChip" AutomationProperties.Name="{Binding Title}">
                            <ContentControl Style="{StaticResource GlassChip}" Padding="10,5">
                                <ContentControl.ToolTip>
                                    <TextBlock MaxWidth="420" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Results.ProcessTree.Sources" AutomationProperties.Name="{Binding SourceSummary}">
                                        <Run Text="Sources:"/> <Run Text="{Binding SourceSummary, Mode=OneWay}"/>
                                    </TextBlock>
                                </ContentControl.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}" Margin="7,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260"
                                               AutomationProperties.AutomationId="Results.ProcessTree.Title"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                                               Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="{Binding WarningsText}"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.AutomationId="Results.ProcessTree.Warnings" AutomationProperties.Name="{Binding WarningsText}"/>
                                </StackPanel>
                            </ContentControl>
                        </c:AutomationPane>
                    </DockPanel>

                    <!-- PID chooser: a clicked PID that matches several instances (ProcessTreeViewModel.SelectPid); nothing is selected until one is picked -->
                    <c:AutomationPane x:Name="PidChooser" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                                      Visibility="{Binding HasPidChooser, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.AutomationId="Results.ProcessTree.PidChooser" AutomationProperties.Name="{Binding PidChooserTitle}">
                        <Border BorderThickness="2" CornerRadius="8" BorderBrush="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.WarningBg}" RenderTransformOrigin="0,0">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <!-- one short pulse + fade-in each time the chooser appears -->
                                    <DataTrigger Binding="{Binding HasPidChooser}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleX">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.04"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleY">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.04"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ContentControl Style="{StaticResource GlassChip}" Padding="0" Background="Transparent">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="6,0,0,6" Background="{DynamicResource Brush.Warning}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlassIconButton}" Command="{Binding DismissPidChooserCommand}" Width="24" Height="24"
                                        Margin="4" VerticalAlignment="Top" ToolTip="Dismiss" FontSize="11" Content="&#xE8BB;"
                                        AutomationProperties.AutomationId="Results.ProcessTree.PidChooser.Dismiss" AutomationProperties.Name="Dismiss the PID chooser"/>
                                <StackPanel Margin="12,9,6,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="15" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PidChooserTitle}" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding PidCandidates}" IsTabStop="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Text}" MinHeight="32" Padding="14,0" Margin="0,4,8,4" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold"
                                                        Command="{Binding DataContext.PickPidCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="Results.ProcessTree.PidChooser.Item" AutomationProperties.Name="{Binding Text}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </ContentControl>
                        </Border>
                    </c:AutomationPane>

                    <!-- Navigator: floating panel on the left of the canvas, as tall as the space under the chips allows -->
                    <Grid x:Name="NavigatorHost" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                          Visibility="{Binding IsNavigatorOpen, Converter={StaticResource BoolToVis}}">
                    <c:AutomationPane x:Name="NavigatorPanel" Width="260" MinWidth="200"
                                      AutomationProperties.AutomationId="Results.ProcessTree.Navigator" AutomationProperties.Name="Navigator">
                        <ContentControl Style="{StaticResource SolidPanel}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6,4,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassIconButton}" Width="24" Height="24" FontSize="11" Content="&#xE8BB;"
                                                    Click="NavigatorClose_Click" ToolTip="Close the Navigator"
                                                    AutomationProperties.AutomationId="Results.ProcessTree.Navigator.Close" AutomationProperties.Name="Close the Navigator"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Navigator" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <!-- filter strip: only while a group is selected -->
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6,4,6"
                                        Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassIconButton}" Width="20" Height="20" FontSize="11" Content="&#xE711;"
                                                    Command="{Binding ClearGroupCommand}" ToolTip="Clear the group selection"
                                                    AutomationProperties.AutomationId="Results.ProcessTree.Navigator.Clear" AutomationProperties.Name="Clear group"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <!-- search: lists only matching processes (name, PID, user, command line, path); Esc clears -->
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6,8,6">
                                    <Grid>
                                    <TextBox Padding="6,4,26,4" Tag="Search name, PID, user, command line" Text="{Binding NavigatorSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                             AutomationProperties.AutomationId="Results.ProcessTree.Navigator.Search" AutomationProperties.Name="Search the Navigator">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Escape" Command="{Binding ClearNavigatorSearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button HorizontalAlignment="Right" Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                            MinHeight="0" Padding="5,3" Margin="0,0,3,0" VerticalAlignment="Center" ToolTip="Clear search (Esc)"
                                            Command="{Binding ClearNavigatorSearchCommand}"
                                            AutomationProperties.AutomationId="Results.ProcessTree.Navigator.Search.Clear" AutomationProperties.Name="Clear search">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NavigatorSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NavigatorSearch}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    </Grid>
                                </Border>
                                <TreeView x:Name="NavTree" ItemsSource="{Binding NavigatorSections}"
                                          BorderThickness="0" Background="Transparent" Padding="0,4" Focusable="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True">
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource NavTreeItem}"/>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                        </ContentControl>
                    </c:AutomationPane>
                    <!-- resize grips (right edge / bottom edge / corner) -->
                    <Thumb Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragDelta="NavResizeRight_DragDelta" Margin="0,8,-3,8"/>
                    <Thumb Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragDelta="NavResizeBottom_DragDelta" Margin="8,0,8,-3"/>
                    <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"
                           DragDelta="NavResizeCorner_DragDelta" Margin="0,0,-4,-4"/>
                    </Grid>
                </Grid>

                <!-- floating detail card, docked top-right: resizable (left edge / bottom / corner), collapsible, closable -->
                <Grid x:Name="DetailHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,10"
                      Visibility="{Binding Detail, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="DetailCard" Width="400" MinWidth="300" MinHeight="44" CornerRadius="6"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            AutomationProperties.AutomationId="Results.ProcessTree.Detail.Card">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                        </Border.Effect>
                        <DockPanel>
                            <!-- title bar -->
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8,8,8">
                                <DockPanel>
                                    <ToggleButton x:Name="CollapseToggle" DockPanel.Dock="Right" MinHeight="0" Padding="5" Margin="4,0,0,0" BorderThickness="0"
                                                  Background="Transparent" Checked="CollapseToggle_Changed" Unchecked="CollapseToggle_Changed" ToolTip="Collapse / expand the details"
                                                  AutomationProperties.AutomationId="Results.ProcessTree.Detail.Collapse" AutomationProperties.Name="Collapse details">
                                        <TextBlock x:Name="CollapseGlyph" Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11"/>
                                    </ToggleButton>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding Detail.CopyDetailsCommand}" MinHeight="0" Padding="5"
                                            ToolTip="Copy the process details" Margin="4,0,0,0"
                                            AutomationProperties.AutomationId="Results.ProcessTree.Detail.Copy" AutomationProperties.Name="Copy details">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"/>
                                    </Button>
                                    <!-- Flag rows: every source row of this process gets the last used flag in its CSV -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding Detail.FlagRowsCommand}" MinHeight="0" Padding="5"
                                            ToolTip="Flag rows: give every source row of this process (all tabs and the process lists) the last used flag"
                                            Margin="4,0,0,0"
                                            AutomationProperties.AutomationId="Results.ProcessTree.Detail.FlagRows" AutomationProperties.Name="Flag rows">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="12" Foreground="{DynamicResource Brush.Warning}"/>
                                    </Button>
                                    <!-- total linked rows of the rail's data tabs (accent when > 0) -->
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,2,0" Padding="7,1" CornerRadius="9" BorderThickness="1"
                                            Visibility="{Binding Detail.HasTotal, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                            ToolTip="{Binding Detail.TotalToolTip}"
                                            AutomationProperties.AutomationId="Results.ProcessTree.Detail.Total" AutomationProperties.Name="{Binding Detail.TotalToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail.TotalCount}" Value="0">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Detail.TotalText}" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.TotalCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail.Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="Results.ProcessTree.Detail.Name" AutomationProperties.Name="{Binding Detail.Name}"/>
                                        <TextBlock Text="{Binding Detail.PidLine}" FontSize="{DynamicResource FontSize.Small}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Results.ProcessTree.Detail.Pid"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ContentControl x:Name="DetailBody" Content="{Binding Detail}" ContentTemplate="{StaticResource DetailBodyTemplate}" IsTabStop="False"/>
                        </DockPanel>
                    </Border>
                    <!-- resize grips -->
                    <Thumb Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" DragDelta="ResizeLeft_DragDelta" Margin="-3,8,0,8"/>
                    <Thumb Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragDelta="ResizeBottom_DragDelta" Margin="8,0,0,-3"/>
                    <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0"
                           DragDelta="ResizeCorner_DragDelta" Margin="-4,0,0,-4"/>
                    <!-- round close button on the card's top-right corner -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-9,0" Width="18" Height="18" Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource GraphPillButton}" Padding="0" ToolTip="Close the details"
                            AutomationProperties.AutomationId="Results.ProcessTree.Detail.Close" AutomationProperties.Name="Close details">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                    </Button>
                </Grid>

                <TextBlock Text="Click a process to see its details." HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,16" FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False"
                           Visibility="{Binding ShowSelectHint, Converter={StaticResource BoolToVis}}"/>

                <!-- a selected ghost parent has no evidence: one line instead of the card -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                        Visibility="{Binding HasGhostNote, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="Results.ProcessTree.Detail.GhostCard">
                    <TextBlock Text="{Binding GhostNote}" Foreground="{DynamicResource Brush.TextSecondary}"
                               AutomationProperties.AutomationId="Results.ProcessTree.Detail.GhostNote" AutomationProperties.Name="{Binding GhostNote}"/>
                </Border>

                <!-- bottom bar: one horizontal glass bar, centred at the bottom of the canvas (View menu, zoom out / slider / in, Navigator, Close); it stays put
                     whether the Navigator is open or not -->
                <c:AutomationPane HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                  AutomationProperties.AutomationId="Results.ProcessTree.ZoomBar" AutomationProperties.Name="Zoom and tools">
                    <ContentControl Style="{StaticResource GlassChip}" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ViewMenu" Style="{StaticResource GlassIconToggle}" Content="&#xE81E;" Width="24" Height="24" FontSize="12"
                                          IsChecked="{Binding IsOpen, ElementName=ViewPopup, Mode=TwoWay}"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=ViewPopup, Converter={StaticResource Not}}"
                                          ToolTip="View: fit to screen, whole tree, exited processes, grid"
                                          AutomationProperties.AutomationId="Results.ProcessTree.ViewMenu" AutomationProperties.Name="View options"/>
                            <Rectangle Width="1" Margin="4,4" Fill="{DynamicResource Brush.Border}"/>
                            <Button Style="{StaticResource GlassIconButton}" Content="&#xE71F;" FontSize="11" Width="24" Height="24" Click="ZoomOut_Click"
                                    ToolTip="{Binding Zoom, ElementName=Canvas, StringFormat=Zoom out (mouse wheel) - now {0:P0}}"
                                    AutomationProperties.AutomationId="Results.ProcessTree.ZoomOut" AutomationProperties.Name="Zoom out"/>
                            <Slider Orientation="Horizontal" Width="110" VerticalAlignment="Center" Margin="4,0"
                                    Minimum="{x:Static c:ProcessGraphCanvas.MinZoom}" Maximum="{x:Static c:ProcessGraphCanvas.MaxZoom}"
                                    Value="{Binding Zoom, ElementName=Canvas, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.25"
                                    ToolTip="{Binding Zoom, ElementName=Canvas, StringFormat={}{0:P0}}"
                                    AutomationProperties.AutomationId="Results.ProcessTree.ZoomSlider" AutomationProperties.Name="Zoom"/>
                            <Button Style="{StaticResource GlassIconButton}" Content="&#xE8A3;" FontSize="11" Width="24" Height="24" Margin="2,0,0,0" Click="ZoomIn_Click"
                                    ToolTip="{Binding Zoom, ElementName=Canvas, StringFormat=Zoom in (mouse wheel) - now {0:P0}}"
                                    AutomationProperties.AutomationId="Results.ProcessTree.ZoomIn" AutomationProperties.Name="Zoom in"/>
                            <Rectangle Width="1" Margin="4,4" Fill="{DynamicResource Brush.Border}"/>
                            <ToggleButton Style="{StaticResource GlassIconToggle}" Content="&#xE8FD;" Width="24" Height="24" FontSize="12" IsChecked="{Binding IsNavigatorOpen}"
                                          ToolTip="Navigator: indicators, data gaps, roles and sessions of this host"
                                          AutomationProperties.AutomationId="Results.ProcessTree.Navigator.Toggle" AutomationProperties.Name="Navigator"/>
                            <Button Style="{StaticResource GlassIconButton}" Content="&#xE8BB;" FontSize="11" Width="24" Height="24" Margin="2,0,0,0" Command="{Binding CloseCommand}"
                                    ToolTip="Close the process tree"
                                    AutomationProperties.AutomationId="Results.ProcessTree.Close" AutomationProperties.Name="Close the process tree"/>
                        </StackPanel>
                    </ContentControl>
                </c:AutomationPane>

                <!-- View menu popover (above the View button at the left end of the bottom bar) -->
                <Popup x:Name="ViewPopup" PlacementTarget="{Binding ElementName=ViewMenu}" Placement="Top" HorizontalOffset="-14" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Grid Margin="12">
                        <ContentControl Style="{StaticResource GlassChip}" Padding="10,8">
                            <!-- one row per item: the label, then a "?" with its explanation (outside the button / checkbox so a click on it does not run the item) -->
                            <StackPanel MinWidth="200">
                                <TextBlock Text="View" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <CheckBox IsChecked="{Binding FitToScreen}" Padding="6,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="Results.ProcessTree.Fit" AutomationProperties.Name="Fit to screen">
                                        <TextBlock Text="Fit to screen" FontWeight="Bold"/>
                                    </CheckBox>
                                    <c:HelpTip Text="Zoom so the whole visible graph fits, and keep it fitted until you zoom or pan." Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                                    <CheckBox IsChecked="{Binding ShowWholeTreeChecked}" IsEnabled="{Binding CanToggleWholeTree}" Padding="6,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="Results.ProcessTree.ViewMenu.ShowWholeTree" AutomationProperties.Name="Show whole tree">
                                        <TextBlock Text="Show whole tree" FontWeight="Bold"/>
                                    </CheckBox>
                                    <c:HelpTip Text="Untick to return to the last process path; tick to show every process." Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,8,0,0">
                                    <CheckBox IsChecked="{Binding ShowExited}" Padding="6,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="Results.ProcessTree.ShowExited" AutomationProperties.Name="Show exited processes">
                                        <TextBlock Text="Show exited processes" FontWeight="Bold"/>
                                    </CheckBox>
                                    <c:HelpTip Text="Include processes that had already ended." Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,8,0,2">
                                    <CheckBox IsChecked="{Binding ShowGrid}" Padding="6,0,0,0" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="Results.ProcessTree.ShowGrid" AutomationProperties.Name="Show grid">
                                        <TextBlock Text="Show grid" FontWeight="Bold"/>
                                    </CheckBox>
                                    <c:HelpTip Text="Draw the floor grid under the graph." Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </Grid>
                </Popup>

                <!-- bottom-centre status toast: shown while loading and for a few seconds after the status changes (code-behind), then fades -->
                <c:AutomationPane x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="150,0,150,54" Opacity="0" IsHitTestVisible="False"
                                  AutomationProperties.AutomationId="Results.ProcessTree.Toast" AutomationProperties.Name="{Binding StatusText}">
                    <ContentControl Style="{StaticResource GlassChip}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="60" Height="3" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}"
                                       TextWrapping="Wrap" MaxWidth="520" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="Results.ProcessTree.Status" AutomationProperties.Name="{Binding StatusText}"/>
                        </StackPanel>
                    </ContentControl>
                </c:AutomationPane>
            </Grid>
        </Border>
    </c:AutomationPane>
</UserControl>
