<Window x:Class="EzForensics.App.Views.EzDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZ Forensics" Icon="pack://application:,,,/Assets/EzForensics.png" Width="460" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource FontSize.Body}" TextOptions.TextFormattingMode="{DynamicResource Ui.TextFormatting}"
        AutomationProperties.AutomationId="EzDialog">
    <Border x:Name="Frame" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Info}" BorderThickness="1.5"
            CornerRadius="8" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
        <StackPanel LayoutTransform="{DynamicResource Ui.Scale}">
            <Border x:Name="Header" Background="{DynamicResource Brush.Surface}" CornerRadius="6,6,0,0" Padding="16,12" Cursor="SizeAll">
                <DockPanel>
                    <Image x:Name="Logo" DockPanel.Dock="Left" Source="pack://application:,,,/Assets/EzForensics.png" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="EzDialog.Logo"/>
                    <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource Brush.Info}" AutomationProperties.AutomationId="EzDialog.Icon"/>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}" AutomationProperties.AutomationId="EzDialog.Title"/>
                </DockPanel>
            </Border>
            <StackPanel Margin="16,12,16,4">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" AutomationProperties.AutomationId="EzDialog.Message"/>
                <Expander x:Name="DetailsExpander" Header="Details" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="EzDialog.Details">
                    <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource MonoBox}" MaxHeight="220" Margin="0,6,0,0"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="EzDialog.DetailsText"/>
                </Expander>
            </StackPanel>
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16"/>
        </StackPanel>
    </Border>
</Window>
