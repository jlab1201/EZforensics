<UserControl x:Class="EzForensics.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:app="clr-namespace:EzForensics.App">
    <UserControl.Resources>
        <!-- log row: a small "select a job" placeholder while nothing is selected, the remaining height once a job is -->
        <app:NullToGridLengthConverter x:Key="LogRowHeight" NullLength="Auto" NotNullLength="*"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <c:PageHeader Title="Jobs"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Text="Every job run in this session. Select one to see its log; finished jobs load from the log file in the case folder."/>
            <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                            Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}"/>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
                <Button Content="Cancel all" Command="{Binding CancelAllCommand}" Margin="0,0,6,0"/>
                <Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,0,16,0"/>
                <Button Content="Open output folder" Command="{Binding OpenOutputCommand}" Margin="0,0,6,0"/>
                <Button Content="Open log file" Command="{Binding OpenLogFileCommand}"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="12"/>
                <RowDefinition MinHeight="0">
                    <RowDefinition.Height>
                        <Binding Path="Selected" Converter="{StaticResource LogRowHeight}"/>
                    </RowDefinition.Height>
                </RowDefinition>
            </Grid.RowDefinitions>

            <DataGrid x:Name="Grid" AutomationProperties.AutomationId="Jobs.Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single" IsReadOnly="True" CanUserSortColumns="False"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      HorizontalScrollBarVisibility="Auto">
                <!-- pixel widths only (no star column): the columns can be wider than the page, so widening one shows the
                     horizontal scroll bar instead of squeezing another column -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="State" Width="110" SortMemberPath="Job.State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Background="{Binding Job.State, Converter={StaticResource StateBg}}">
                                    <TextBlock AutomationProperties.AutomationId="Jobs.State" Text="{Binding Job.State}" FontSize="11" Foreground="{Binding Job.State, Converter={StaticResource StateFg}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Tool" Binding="{Binding Job.Spec.ToolId}" Width="190">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Job.Spec.ToolId}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Label" Binding="{Binding Job.Spec.Label}" Width="220"/>
                    <DataGridTextColumn Header="Started" Binding="{Binding Job.StartUtc, Converter={StaticResource LocalTime}}" Width="90"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                    <DataGridTextColumn Header="Exit" Binding="{Binding Job.ExitCode}" Width="55"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding Job.StatusReason}" Width="340">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Job.StatusReason}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Output" Binding="{Binding Job.Spec.OutputDir}" Width="400"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,6"
                        Background="{Binding Selected.Job.State, Converter={StaticResource StateBg}}"
                        BorderBrush="{Binding Selected.Job.State, Converter={StaticResource StateFg}}"
                        Visibility="{Binding StatusText, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RetryCommand}" Margin="10,0,0,0" VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Jobs.HintRetry"
                                Visibility="{Binding ShowRetryHint, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock AutomationProperties.AutomationId="Jobs.Reason" Text="{Binding StatusText}"
                                   ToolTip="{Binding Selected.Job.StatusReason}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{Binding Selected.Job.State, Converter={StaticResource StateFg}}"/>
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="2,0,0,6" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Jobs.Meta" Text="{Binding MetaText}"
                           Visibility="{Binding MetaText, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Command" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" Margin="0,0,0,4"
                           Visibility="{Binding CommandText, Converter={StaticResource BoolToVis}}"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding CommandText, Converter={StaticResource BoolToVis}}">
                    <TextBox Style="{StaticResource MonoBox}" MinHeight="0" MaxHeight="110"
                             AutomationProperties.AutomationId="Jobs.Command" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding CommandText, Mode=OneWay}"/>
                    <Button AutomationProperties.AutomationId="Jobs.CopyCommand" Command="{Binding CopyCommandTextCommand}"
                            ToolTip="Copy" AutomationProperties.Name="Copy command"
                            FontFamily="{StaticResource Font.Icon}" Content="&#xE8C8;" MinHeight="0" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding RefreshLogCommand}"/>
                    <TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LogTitle}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Select a job to see its log" Style="{StaticResource Caption}" Margin="2,4,0,8"
                           AutomationProperties.AutomationId="Jobs.LogPlaceholder"
                           Visibility="{Binding Selected, Converter={StaticResource BoolToVisInv}}"/>
                <Grid Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}">
                    <c:LogConsole AutomationProperties.AutomationId="Jobs.Log" Buffer="{Binding Log}" MinHeight="100"/>
                    <Button AutomationProperties.AutomationId="Jobs.CopyLog" Command="{Binding CopyLogCommand}"
                            ToolTip="Copy" AutomationProperties.Name="Copy log"
                            FontFamily="{StaticResource Font.Icon}" Content="&#xE8C8;" MinHeight="0" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                <Setter Property="Opacity" Value="0.6"/>
                                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
