<UserControl x:Class="EzForensics.App.Views.ToolManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:tools="clr-namespace:EzForensics.Core.Tools;assembly=EzForensics.Core"
             xmlns:plaso="clr-namespace:EzForensics.Core.Plaso;assembly=EzForensics.Core"
             xmlns:zeek="clr-namespace:EzForensics.Core.Zeek;assembly=EzForensics.Core"
             xmlns:rita="clr-namespace:EzForensics.Core.Rita;assembly=EzForensics.Core">
    <UserControl.Resources>
        <!-- Volatility plugin table: header and rows share these columns (Grid.IsSharedSizeScope on the table) -->
        <Style x:Key="PluginHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <!-- one Volatility plugin of the Ingest set (MemoryPluginItem): Run / Command / Module / Description -->
        <DataTemplate x:Key="PluginRow">
            <Border x:Name="Row" Padding="8,5" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Background="Transparent" ToolTip="{Binding ToolTip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PluginRun"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PluginCommand"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PluginModule"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center" Margin="0,0,16,0"
                              AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}"/>
                    <TextBlock x:Name="Command" Grid.Column="1" Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="Module" Grid.Column="2" Text="{Binding Plugin}" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock x:Name="Description" Grid.Column="3" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.RowAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Command" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="Module" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                    <Setter TargetName="Description" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- OS group row of the plugin table (Windows / Linux) -->
        <Style x:Key="PluginGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel x:Name="RootPanel">
            <ContentControl Tag="always" Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                            Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}"/>

            <Border x:Name="PlasoCard" Margin="0,0,0,14" AutomationProperties.AutomationId="ToolManager.Plaso"
                    AutomationProperties.Name="log2timeline / plaso">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" VerticalAlignment="Top" Padding="10,2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlasoToolStatus}" Value="Installed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PlasoToolStatus}" Value="UpdateAvailable">
                                            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PlasoToolStatus}" Value="NotInstalled">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PlasoToolStatus}" Value="PythonMissing">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PlasoStatus}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}" AutomationProperties.AutomationId="ToolManager.Plaso.Status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlasoToolStatus}" Value="Installed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PlasoToolStatus}" Value="UpdateAvailable">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PlasoToolStatus}" Value="NotInstalled">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PlasoToolStatus}" Value="PythonMissing">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="log2timeline / plaso" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="ToolManager.Plaso.Title"/>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.Control}" Margin="10,0,0,0">
                                <TextBlock Text="Timeline" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TabControl Style="{StaticResource FlatTabs}">
                        <TabItem Header="Overview" AutomationProperties.AutomationId="Tools.Tab.Overview">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Forensic Value" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="{x:Static tools:ToolDisplay.PlasoUsage}"/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}">
                                    <TextBlock Text="One timeline of every artifact, sorted by time." TextWrapping="Wrap" AutomationProperties.AutomationId="ToolManager.Plaso.Usage"/>
                                </Border>

                                <!-- plaso timeline options: used by every super timeline build (Ingest panel, auto build) -->
                                <StackPanel x:Name="PlasoOptionsCard" DataContext="{Binding PlasoOptions}" AutomationProperties.AutomationId="ToolManager.Plaso.Options"
                                            AutomationProperties.Name="Timeline options">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Timeline options" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="Applied to every plaso super timeline build. Saved as you change them."/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Tile}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Parsers" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding ParserPresets}"
                                                      Text="{Binding PlasoParsers, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Preset or parser filter expression for --parsers (e.g. win7, win_gen,!filestat). Empty = plaso auto-selects."
                                                      AutomationProperties.AutomationId="ToolManager.Plaso.Options.Parsers" AutomationProperties.Name="plaso parsers"/>
                                            <TextBlock Grid.Row="1" Text="Output format" VerticalAlignment="Center" Margin="0,8,16,0"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"
                                                      DisplayMemberPath="Label" AutomationProperties.AutomationId="ToolManager.Plaso.Options.Format" AutomationProperties.Name="psort output format"
                                                      ToolTip="dynamic: ISO 8601 datetime (sorts and filters in Analyze) with macb. l2tcsv: legacy 17 columns incl. MACB, second precision."/>
                                            <TextBlock Grid.Row="2" Text="Workers" VerticalAlignment="Center" Margin="0,8,16,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Width="70" HorizontalAlignment="Left" Tag="auto"
                                                     Text="{Binding PlasoWorkers, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="--workers (empty = CPUs minus one)" AutomationProperties.AutomationId="ToolManager.Plaso.Options.Workers"/>
                                            <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <CheckBox Content="Time zone UTC" IsChecked="{Binding PlasoTimezoneUtc}" Margin="0,0,16,4"
                                                          ToolTip="--timezone UTC for timestamps stored without a time zone"
                                                          AutomationProperties.AutomationId="ToolManager.Plaso.Options.Utc"/>
                                                <CheckBox Content="Volume Shadow Copies" IsChecked="{Binding PlasoVss}" Margin="0,0,16,4"
                                                          ToolTip="--vss_stores all (off: --vss_stores none)"
                                                          AutomationProperties.AutomationId="ToolManager.Plaso.Options.Vss"/>
                                                <CheckBox Content="Unattended" IsChecked="{Binding PlasoUnattended}" Margin="0,0,16,4"
                                                          ToolTip="--unattended: never prompt, fail instead"
                                                          AutomationProperties.AutomationId="ToolManager.Plaso.Options.Unattended"/>
                                            </WrapPanel>
                                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="From (UTC)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <DatePicker SelectedDate="{Binding FromDate}" Width="125" ToolTip="From (inclusive, UTC; a psort event filter)"
                                                            AutomationProperties.AutomationId="ToolManager.Plaso.Options.From"/>
                                                <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                                <DatePicker SelectedDate="{Binding ToDate}" Width="125" ToolTip="To (inclusive, whole day, UTC)"
                                                            AutomationProperties.AutomationId="ToolManager.Plaso.Options.To"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Source, output folder, log2timeline / psort as they will run (+ additional arguments), Run -->
                                <ContentControl Content="{Binding PlasoCommand}" ContentTemplate="{StaticResource SpecialCommandTile}" Focusable="False"/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Release" AutomationProperties.AutomationId="Tools.Tab.Release">
                            <StackPanel AutomationProperties.AutomationId="ToolManager.Plaso.Configuration">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Installed" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}"
                                               ToolTip="Discovery order: configured path, EZ Forensics' venv (%LOCALAPPDATA%\EzForensicsData\plaso\venv), log2timeline/psort on PATH, then Docker (log2timeline/plaso). plaso publishes no Windows binaries, so on Windows it is installed with pip or run from Docker. Free and open source; installs into its own folder: no admin rights, no PATH changes."/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlasoVersion}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Plaso.Version"/>
                                            <TextBlock Grid.Row="1" Text="Latest" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Plaso.Latest"/>
                                            <TextBlock Grid.Row="2" Text="psort / pinfo" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Plaso.Tools">
                                                <Run Text="psort"/> <Run Text="{Binding PsortVersion, Mode=OneWay}"/><Run Text="   ·   pinfo"/> <Run Text="{Binding PinfoVersion, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Row="3" Text="Engine" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlasoEngineType}" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Plaso.Engine"/>
                                            <TextBlock Grid.Row="4" Text="Location" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PlasoLocation}" Margin="0,0,0,6" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PlasoLocation}" AutomationProperties.AutomationId="ToolManager.Plaso.Location"/>
                                            <TextBlock Grid.Row="5" Text="Path" Style="{StaticResource Caption}" Margin="0,0,16,6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PlasoConfiguredPath}" Margin="0,0,0,6" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlasoConfiguredPath}"
                                                       AutomationProperties.AutomationId="ToolManager.Plaso.ConfiguredPath"/>
                                            <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,6">
                                                <Button Content="Folder…" Command="{Binding SetPlasoFolderCommand}" Margin="0,0,4,0" MinHeight="24" Padding="8,2"
                                                        ToolTip="A folder with log2timeline.exe/psort.exe (or .py), or a venv" AutomationProperties.AutomationId="ToolManager.Plaso.SetFolder"/>
                                                <Button Content="python.exe…" Command="{Binding SetPlasoPythonCommand}" Margin="0,0,4,0" MinHeight="24" Padding="8,2"
                                                        ToolTip="A python.exe that has plaso installed (python -m plaso.scripts.log2timeline)" AutomationProperties.AutomationId="ToolManager.Plaso.SetPython"/>
                                                <Button Content="Automatic" Command="{Binding ClearPlasoPathCommand}" MinHeight="24" Padding="8,2"
                                                        ToolTip="Clear the configured path (managed venv, PATH, Docker)" AutomationProperties.AutomationId="ToolManager.Plaso.ClearPath"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="6" Text="Python" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PythonText}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PythonText}" AutomationProperties.AutomationId="ToolManager.Plaso.Python"/>
                                            <TextBlock Grid.Row="7" Text="Links" Style="{StaticResource Caption}"/>
                                            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="ToolManager.Plaso.Links">
                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.Docs}" ToolTip="{x:Static plaso:PlasoLinks.Docs}"
                                                           AutomationProperties.AutomationId="ToolManager.Plaso.LinkDocs">Website / Docs</Hyperlink>
                                                <Run Text="  ·  "/>
                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.GitHub}" ToolTip="{x:Static plaso:PlasoLinks.GitHub}"
                                                           AutomationProperties.AutomationId="ToolManager.Plaso.LinkGitHub">GitHub</Hyperlink>
                                                <Run Text="  ·  "/>
                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.Releases}" ToolTip="{x:Static plaso:PlasoLinks.Releases}"
                                                           AutomationProperties.AutomationId="ToolManager.Plaso.LinkReleases">Releases</Hyperlink>
                                                <Run Text="  ·  "/>
                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.PyPI}" ToolTip="{x:Static plaso:PlasoLinks.PyPI}"
                                                           AutomationProperties.AutomationId="ToolManager.Plaso.LinkPyPI">PyPI</Hyperlink>
                                                <Run Text="  ·  "/>
                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.DockerHub}" ToolTip="{x:Static plaso:PlasoLinks.DockerHub}"
                                                           AutomationProperties.AutomationId="ToolManager.Plaso.LinkDocker">Docker Hub</Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding PlasoNotes}"
                                                   Visibility="{Binding HasPlasoNotes, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Plaso.Notes"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Manage" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PlasoHeadline}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="ToolManager.Plaso.Headline"/>
                                        <TextBlock Text="Install or update it from the Tools table on the Overview tab." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Cancel" Command="{Binding CancelPlasoSetupCommand}" Margin="0,0,6,6"
                                                    Visibility="{Binding IsPlasoInstalling, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.AutomationId="ToolManager.Plaso.Cancel"/>
                                            <Button Content="Detect again" Command="{Binding DetectPlasoCommand}" Margin="0,0,6,6"
                                                    ToolTip="Look for plaso again and re-check the latest version on PyPI" AutomationProperties.AutomationId="ToolManager.Plaso.Detect"/>
                                            <Button Content="Open folder" Command="{Binding OpenPlasoFolderCommand}" Margin="0,0,6,6"
                                                    ToolTip="Open the folder of the plaso in use (or EZ Forensics' plaso folder)" AutomationProperties.AutomationId="ToolManager.Plaso.OpenFolder"/>
                                            <Button Content="Use existing install…" Command="{Binding UseExistingPlasoCommand}" Margin="0,0,6,6"
                                                    ToolTip="Browse to a log2timeline.exe / log2timeline.py you already have (psort next to it), or a python.exe with plaso"
                                                    AutomationProperties.AutomationId="ToolManager.Plaso.UseExisting"/>
                                            <Button Content="Pull Docker image" Command="{Binding PullDockerImageCommand}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanPullDocker, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="docker pull log2timeline/plaso (runs as a job)" AutomationProperties.AutomationId="ToolManager.Plaso.PullDocker"/>
                                            <Button Content="Uninstall" Command="{Binding UninstallPlasoCommand}" Margin="0,0,6,6" Style="{StaticResource SubtleButton}"
                                                    Visibility="{Binding ManagedFilesExist, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Remove EZ Forensics' plaso venv and private Python only (%LOCALAPPDATA%\EzForensicsData\plaso\venv and \python)"
                                                    AutomationProperties.AutomationId="ToolManager.Plaso.Uninstall"/>
                                        </WrapPanel>

                                        <StackPanel Margin="0,2,0,0" Visibility="{Binding IsPlasoInstalling, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PlasoStepText}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="ToolManager.Plaso.Step"/>
                                            <ProgressBar Height="4" Margin="0,4,0,0" Maximum="1" Value="{Binding PlasoSetupProgress}"
                                                         IsIndeterminate="{Binding PlasoSetupDeterminate, Converter={StaticResource Not}}"/>
                                        </StackPanel>

                                        <!-- no Python found: Install brings its own -->
                                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource Brush.InfoBg}"
                                                Visibility="{Binding ShowPythonGuidance, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Plaso.Guidance">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                                        <Run Text="No Python needed: Install downloads a private Python"/> <Run Text="{Binding PrivatePythonVersion, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource InfoGlyph}" Margin="6,0,0,0"
                                                               ToolTip="plaso needs Python 3.10 to 3.13 and none was found. Install fetches python.org's official NuGet package from nuget.org (SHA-512 checked) into %LOCALAPPDATA%\EzForensicsData\plaso\python, used only by EZ Forensics: no installer, no admin rights, no PATH changes. Prefer your own Python? Install it from python.org (tick &quot;Add python.exe to PATH&quot;), then click Detect again. Docker Desktop with the plaso image also works."/>
                                                </StackPanel>
                                                <TextBlock FontSize="{DynamicResource FontSize.Caption}" Margin="0,4,0,0">
                                                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.PythonDownloads}"
                                                               AutomationProperties.AutomationId="ToolManager.Plaso.LinkPython">python.org downloads</Hyperlink>
                                                    <Run Text="   "/>
                                                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.PythonNuGet}"
                                                               AutomationProperties.AutomationId="ToolManager.Plaso.LinkPythonNuGet">python on nuget.org</Hyperlink>
                                                    <Run Text="   "/>
                                                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static plaso:PlasoLinks.DockerDocs}"
                                                               AutomationProperties.AutomationId="ToolManager.Plaso.LinkDockerDocs">plaso with Docker</Hyperlink>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- install / update / pull log -->
                                <StackPanel Visibility="{Binding PlasoLog, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PlasoJob.Spec.Label}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding PlasoJob.State}" Style="{StaticResource Caption}" Margin="8,0,0,6" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="ToolManager.Plaso.JobState"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Tile}">
                                        <c:LogConsole Buffer="{Binding PlasoLog}" Height="160" AutomationProperties.AutomationId="ToolManager.Plaso.Log"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <Border x:Name="ZeekCard" Margin="0,0,0,14" DataContext="{Binding Zeek}" AutomationProperties.AutomationId="ToolManager.Zeek"
                    AutomationProperties.Name="Zeek (packet capture → logs)">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" VerticalAlignment="Top" Padding="10,2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NeedsRuntime">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}" AutomationProperties.AutomationId="ToolManager.Zeek.Status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NeedsRuntime">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
