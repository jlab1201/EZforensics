                                                       AutomationProperties.AutomationId="ToolManager.Rita.License"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding NoteText}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Rita.Note"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding DockerNote, Mode=OneWay}"
                                                   Visibility="{Binding ShowDockerNote, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Rita.DockerNote"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Manage" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="ToolManager.Rita.Headline"/>
                                        <TextBlock Text="Install or update it from the Tools table on the Overview tab." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,6"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Rita.Cancel"/>
                                            <Button Content="Detect again" Command="{Binding DetectCommand}" Margin="0,0,6,6"
                                                    ToolTip="Look for RITA in the EZ Forensics Linux environment again" AutomationProperties.AutomationId="ToolManager.Rita.Detect"/>
                                            <Button Content="Delete RITA databases…" Command="{Binding DeleteDatabasesCommand}" Margin="0,0,6,6" Style="{StaticResource SubtleButton}"
                                                    Visibility="{Binding ShowDeleteDatabases, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Delete the ClickHouse databases of earlier analyses (the Rita_*.csv results in your cases stay)"
                                                    AutomationProperties.AutomationId="ToolManager.Rita.DeleteDatabases"/>
                                            <Button Content="Uninstall" Command="{Binding UninstallCommand}" Margin="0,0,6,6" Style="{StaticResource SubtleButton}"
                                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Remove RITA, ClickHouse and every RITA database from the EZ Forensics Linux environment (Zeek and your cases are not touched)"
                                                    AutomationProperties.AutomationId="ToolManager.Rita.Uninstall"/>
                                        </WrapPanel>
                                        <StackPanel Margin="0,2,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="ToolManager.Rita.Step"/>
                                            <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" AutomationProperties.AutomationId="ToolManager.Rita.Progress"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Log, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Job.Spec.Label}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding Job.State}" Style="{StaticResource Caption}" Margin="8,0,0,6" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="ToolManager.Rita.JobState"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Tile}">
                                        <c:LogConsole Buffer="{Binding Log}" Height="160" AutomationProperties.AutomationId="ToolManager.Rita.Log"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <Border x:Name="VolatilityCard" Margin="0,0,0,14" DataContext="{Binding Volatility}" AutomationProperties.AutomationId="ToolManager.Volatility"
                    AutomationProperties.Name="Volatility 3 (memory images)">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" VerticalAlignment="Top" Padding="10,2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}" AutomationProperties.AutomationId="ToolManager.Volatility.Status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Volatility 3" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="ToolManager.Volatility.Title"/>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.Control}" Margin="10,0,0,0">
                                <TextBlock Text="Memory" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TabControl Style="{StaticResource FlatTabs}">
                        <TabItem Header="Overview" AutomationProperties.AutomationId="Tools.Tab.Overview">
                            <StackPanel AutomationProperties.AutomationId="ToolManager.Volatility.Configuration">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Forensic Value" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="{x:Static tools:ToolDisplay.VolatilityUsage}"/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}">
                                    <TextBlock Text="Finds processes, connections and injected code in memory images." TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ToolManager.Volatility.Usage"/>
                                </Border>

                                <!-- plugins Ingest runs on every memory image (AppSettings.VolatilityPlugins) -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ingest plugins" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}"
                                               ToolTip="Run on every memory image Ingest processes, read-only: 'vol -r csv -f &lt;image&gt; --symbol-dirs &lt;symbols&gt; --cache-path &lt;cache&gt; &lt;plugin&gt;'. Linux images need an ISF that matches their kernel."/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}" AutomationProperties.AutomationId="ToolManager.Volatility.Plugins">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" FontSize="{DynamicResource FontSize.Caption}">
                                                <Hyperlink Command="{Binding PluginDefaultsCommand}" AutomationProperties.AutomationId="ToolManager.Volatility.PluginDefaults">Defaults</Hyperlink>
                                                <Run Text="  "/>
                                                <Hyperlink Command="{Binding PluginsAllCommand}" AutomationProperties.AutomationId="ToolManager.Volatility.PluginsAll">All</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PluginsSummary, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                                                AutomationProperties.AutomationId="ToolManager.Volatility.PluginTable">
                                            <StackPanel Grid.IsSharedSizeScope="True">
                                                <Border Padding="8,5" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PluginRun"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PluginCommand"/>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PluginModule"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Run" Style="{StaticResource PluginHeader}"/>
                                                        <TextBlock Grid.Column="1" Text="Command" Style="{StaticResource PluginHeader}"/>
                                                        <TextBlock Grid.Column="2" Text="Module" Style="{StaticResource PluginHeader}"/>
                                                        <TextBlock Grid.Column="3" Text="Description" Style="{StaticResource PluginHeader}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource PluginGroup}">
                                                    <TextBlock Text="Windows" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding WindowsPlugins}" Focusable="False" AlternationCount="2" ItemTemplate="{StaticResource PluginRow}"/>
                                                <Border Style="{StaticResource PluginGroup}">
                                                    <TextBlock Text="Linux" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Caption}"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding LinuxPlugins}" Focusable="False" AlternationCount="2" ItemTemplate="{StaticResource PluginRow}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Symbols" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}"
                                               ToolTip="Windows symbols are downloaded automatically when online. Install the symbol pack or import ISF files (e.g. made with dwarf2json for a Linux kernel) to work offline."/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenSymbolsFolderCommand}" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                                    ToolTip="{Binding SymbolsDir}" AutomationProperties.AutomationId="ToolManager.Volatility.OpenSymbols"/>
                                            <TextBlock Text="{Binding SymbolsText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       ToolTip="{Binding SymbolsDir}" AutomationProperties.AutomationId="ToolManager.Volatility.Symbols"/>
                                        </DockPanel>
                                        <CheckBox IsChecked="{Binding Offline}" Margin="0,10,0,0" Content="Offline (--offline)"
                                                  ToolTip="Never download symbols: Volatility does not contact the internet and uses only the symbols folder. Install the Windows symbol pack or import ISF files first, otherwise memory jobs fail with a missing-symbols message."
                                                  AutomationProperties.AutomationId="ToolManager.Volatility.Offline"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="{Binding SymbolPackButtonText, Mode=OneWay}" Command="{Binding InstallSymbolPackCommand}" Margin="0,0,12,0"
                                                    Visibility="{Binding ShowSymbolPack, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Official windows.zip from downloads.volatilityfoundation.org, extracted into the symbols folder, so Windows memory images can be analysed without an internet connection"
                                                    AutomationProperties.AutomationId="ToolManager.Volatility.SymbolPack"/>
                                            <TextBlock Text="Import ISF for" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Caption}"/>
                                            <ComboBox ItemsSource="{Binding IsfTargets}" SelectedItem="{Binding IsfTarget}" DisplayMemberPath="Label" MinWidth="100" Margin="0,0,6,0"
                                                      AutomationProperties.AutomationId="ToolManager.Volatility.IsfOs" AutomationProperties.Name="Operating system of the ISF files"/>
                                            <Button Content="Import ISF…" Command="{Binding ImportIsfCommand}"
                                                    ToolTip="Copy symbol files (ISF, .json or .json.xz) into symbols\windows, symbols\linux or symbols\mac"
                                                    AutomationProperties.AutomationId="ToolManager.Volatility.ImportIsf"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- memory image, case folder, one command per ticked plugin (+ plugin arguments), Run -->
                                <ContentControl Content="{Binding Command}" ContentTemplate="{StaticResource SpecialCommandTile}" Focusable="False"/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Release" AutomationProperties.AutomationId="Tools.Tab.Release">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Installed" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource InfoGlyph}"
                                               ToolTip="Discovery order: configured vol.exe, EZ Forensics' environment (%LOCALAPPDATA%\EzForensicsData\volatility\venv), then vol.exe on PATH. Runs natively on Windows from its own Python environment: no WSL, Docker, admin rights or PATH changes."/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Volatility.Version"/>
                                        <TextBlock Grid.Row="1" Text="Tested" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PinnedText, Mode=OneWay}" Margin="0,0,0,6" AutomationProperties.AutomationId="ToolManager.Volatility.Pinned"/>
                                        <TextBlock Grid.Row="2" Text="Latest" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LatestText}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="ToolManager.Volatility.Latest"/>
                                        <TextBlock Grid.Row="3" Text="Location" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LocationText}" Margin="0,0,0,6" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationText}" AutomationProperties.AutomationId="ToolManager.Volatility.Location"/>
                                        <TextBlock Grid.Row="4" Text="Path" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfiguredPath}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfiguredPath}"
                                                   AutomationProperties.AutomationId="ToolManager.Volatility.ConfiguredPath"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="Automatic" Command="{Binding ClearPathCommand}" MinHeight="24" Padding="8,2" Margin="6,0,0,0"
                                                ToolTip="Clear the configured vol.exe (EZ Forensics' environment, then PATH)" AutomationProperties.AutomationId="ToolManager.Volatility.ClearPath"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Manage" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="ToolManager.Volatility.Headline"/>
                                        <TextBlock Text="Install or update it from the Tools table on the Overview tab." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,6"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ToolManager.Volatility.Cancel"/>
                                            <Button Content="Detect again" Command="{Binding DetectCommand}" Margin="0,0,6,6"
                                                    ToolTip="Look for Volatility 3 again (configured path, EZ Forensics' environment, PATH)" AutomationProperties.AutomationId="ToolManager.Volatility.Detect"/>
                                            <Button Content="Use existing install…" Command="{Binding UseExistingCommand}" Margin="0,0,6,6"
                                                    ToolTip="Browse to a vol.exe in a Python environment that has volatility3" AutomationProperties.AutomationId="ToolManager.Volatility.UseExisting"/>
                                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6"
                                                    ToolTip="Open EZ Forensics' Volatility folder (venv, symbols, cache)" AutomationProperties.AutomationId="ToolManager.Volatility.OpenFolder"/>
                                            <Button Content="Uninstall" Command="{Binding UninstallCommand}" Margin="0,0,6,6" Style="{StaticResource SubtleButton}"
                                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Remove EZ Forensics' Volatility environment and symbol cache (the private Python shared with plaso stays)"
                                                    AutomationProperties.AutomationId="ToolManager.Volatility.Uninstall"/>
                                            <CheckBox Content="Keep symbols" IsChecked="{Binding KeepSymbolsOnUninstall}" Margin="2,0,6,6" VerticalAlignment="Center"
                                                      Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="Uninstall keeps the symbols folder (Windows symbol pack, imported ISF files). Untick to delete it too."
                                                      AutomationProperties.AutomationId="ToolManager.Volatility.KeepSymbols"/>
                                        </WrapPanel>
                                        <StackPanel Margin="0,2,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" AutomationProperties.AutomationId="ToolManager.Volatility.Step"/>
                                            <ProgressBar Height="4" Margin="0,4,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Log, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Job.Spec.Label}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding Job.State}" Style="{StaticResource Caption}" Margin="8,0,0,6" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="ToolManager.Volatility.JobState"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Tile}">
                                        <c:LogConsole Buffer="{Binding Log}" Height="160" AutomationProperties.AutomationId="ToolManager.Volatility.Log"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- every catalog tool and its download, plus the maps / batch files sync (one table) -->
            <TextBlock Text="Tools" Style="{StaticResource SectionTitle}"/>
            <DataGrid ItemsSource="{Binding ToolRowsView}" IsReadOnly="False" MaxHeight="620" AutomationProperties.AutomationId="ToolManager.ToolsTable"
                      EnableRowVirtualization="False">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,8,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsThreeState="False" HorizontalAlignment="Center" ToolTip="Tick all / none"
                                      IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ToolManager.ToolsTable.All" AutomationProperties.Name="Select all"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding VersionToolTip}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{Binding PrimaryActionText}" Style="{StaticResource AccentButton}" MinWidth="150" Command="{Binding PrimaryActionCommand}"
                            AutomationProperties.AutomationId="ToolManager.PrimaryAction" IsEnabled="{Binding CanAct}"
                            ToolTip="Nothing ticked: check for updates (EZ tools site, plaso, Volatility, Zeek). Ticked rows: install / update them (a missing tool is installed, an installed one is updated; the maps row runs EvtxECmd, RECmd and SQLECmd --sync)."/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding RemoteSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <ProgressBar Maximum="1" Height="4" Margin="0,4,0,0" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.AutomationId="ToolManager.SyncBusy"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
