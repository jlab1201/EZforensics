<UserControl x:Class="EzForensics.App.Views.ToolsView"
             xmlns:v="clr-namespace:EzForensics.App.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:local="clr-namespace:EzForensics.App">
    <UserControl.Resources>
        <!-- Tools list sections: tinted band + stripe in one stable category colour per section -->
        <local:SectionIndexConverter x:Key="SectionIndex"/>
        <local:SectionGlyphConverter x:Key="SectionGlyph"/>
        <local:SectionSummaryConverter x:Key="SectionSummary"/>
        <Style x:Key="SectionBand" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Cat8Bg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="1"><Setter Property="Background" Value="{DynamicResource Brush.Cat1Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="2"><Setter Property="Background" Value="{DynamicResource Brush.Cat2Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="3"><Setter Property="Background" Value="{DynamicResource Brush.Cat3Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="4"><Setter Property="Background" Value="{DynamicResource Brush.Cat4Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="5"><Setter Property="Background" Value="{DynamicResource Brush.Cat5Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="6"><Setter Property="Background" Value="{DynamicResource Brush.Cat6Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="7"><Setter Property="Background" Value="{DynamicResource Brush.Cat7Bg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionStripe" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Brush.Cat8Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="1"><Setter Property="Fill" Value="{DynamicResource Brush.Cat1Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="2"><Setter Property="Fill" Value="{DynamicResource Brush.Cat2Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="3"><Setter Property="Fill" Value="{DynamicResource Brush.Cat3Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="4"><Setter Property="Fill" Value="{DynamicResource Brush.Cat4Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="5"><Setter Property="Fill" Value="{DynamicResource Brush.Cat5Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="6"><Setter Property="Fill" Value="{DynamicResource Brush.Cat6Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="7"><Setter Property="Fill" Value="{DynamicResource Brush.Cat7Fg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Cat8Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="1"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat1Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="2"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat2Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="3"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat3Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="4"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat4Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="5"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat5Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="6"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat6Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Name, Converter={StaticResource SectionIndex}}" Value="7"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat7Fg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Style="{StaticResource SectionBand}" Padding="10,7,10,7">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="chev" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="11" Text="&#xE70D;" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,9,0"
                                           Text="{Binding Name, Converter={StaticResource SectionGlyph}}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Style="{StaticResource SectionTitleText}"/>
                                    <TextBlock FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SectionSummary}">
                                                <Binding/>
                                                <Binding Path="ItemCount"/>
                                                <Binding Path="DataContext.InstalledStamp" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"><Setter TargetName="chev" Property="Text" Value="&#xE76C;"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionGroupItem" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource Brush.Window}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle Style="{StaticResource SectionStripe}"/>
                                <StackPanel Grid.Column="1">
                                    <ToggleButton x:Name="Toggle" Style="{StaticResource SectionToggle}" IsChecked="True" Loaded="SectionToggle_Loaded"
                                                  Checked="SectionToggle_Changed" Unchecked="SectionToggle_Changed"
                                                  AutomationProperties.AutomationId="Tools.Section" AutomationProperties.Name="{Binding Name}"/>
                                    <ItemsPresenter x:Name="items" Margin="4,2,4,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Toggle" Property="IsChecked" Value="False"><Setter TargetName="items" Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- category badge (Brush.Cat{n}Bg / Fg per category) -->
        <Style x:Key="CategoryBadge" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Brush.Cat8Bg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="1"><Setter Property="Background" Value="{DynamicResource Brush.Cat1Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="2"><Setter Property="Background" Value="{DynamicResource Brush.Cat2Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="3"><Setter Property="Background" Value="{DynamicResource Brush.Cat3Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="4"><Setter Property="Background" Value="{DynamicResource Brush.Cat4Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="5"><Setter Property="Background" Value="{DynamicResource Brush.Cat5Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="6"><Setter Property="Background" Value="{DynamicResource Brush.Cat6Bg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="7"><Setter Property="Background" Value="{DynamicResource Brush.Cat7Bg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Cat8Fg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="1"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat1Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="2"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat2Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="3"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat3Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="4"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat4Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="5"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat5Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="6"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat6Fg}"/></DataTrigger>
                <DataTrigger Binding="{Binding CategoryIndex}" Value="7"><Setter Property="Foreground" Value="{DynamicResource Brush.Cat7Fg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- shared header: the same page title everywhere, then the sub-navigation tabs -->
        <StackPanel DockPanel.Dock="Top">
            <c:PageHeader Title="Tools"/>
            <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,4,0,12" Focusable="False" AutomationProperties.AutomationId="Tools.Tabs">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Tab" Style="{StaticResource SubtleButton}" Padding="12,6" Margin="0,0,2,0"
                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                            <Border x:Name="Underline" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,0,0,4">
                                <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="14"/>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    <Grid>
        <!-- landing: category cards, then the tools folder / downloads block -->
        <DockPanel Visibility="{Binding IsLanding, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Landing">
            <StackPanel DockPanel.Dock="Top">
                <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                                Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FirstRunTemplate}"
                                Visibility="{Binding ShowFirstRun, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,10" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="300" MinHeight="120" Margin="0,0,12,12" Padding="14,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Description}"
                                    AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="26" VerticalAlignment="Top"
                                               Margin="0,2,14,0" Foreground="{DynamicResource Brush.Accent}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="All installed" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Success}" Margin="0,2,0,0"
                                                   Visibility="{Binding AllInstalled, Converter={StaticResource BoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,0" Focusable="False" Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SubtleButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="{Binding Summary}"
                                                            Command="{Binding DataContext.OpenChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                                                        <TextBlock FontSize="{DynamicResource FontSize.Small}"><Run Text="{Binding Title, Mode=OneWay}"/> <Run Text="{Binding Counts, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/></TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <v:ToolManagerView DataContext="{Binding Manager}" Section="General"/>
        </DockPanel>

        <!-- one category -->
        <DockPanel Visibility="{Binding IsCategory, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Category">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" Text="{Binding PageDescription}" TextWrapping="Wrap"/>
                <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                                Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- tool list -->
                <Border Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" AutomationProperties.AutomationId="Tools.Search" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search tools…" Margin="0,0,0,8"/>
                        <ListBox AutomationProperties.AutomationId="Tools.List" ItemsSource="{Binding ToolsView}" SelectedItem="{Binding SelectedTool}" SelectionChanged="ToolList_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource SectionGroupItem}"/>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Description}">
                                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.Success}"
                                                 Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}" ToolTip="Installed"/>
                                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextDisabled}"
                                                 StrokeThickness="1.5" Visibility="{Binding Installed, Converter={StaticResource BoolToVisInv}}" ToolTip="Not installed"/>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                <!-- detail: configuration (installed), install (missing), launcher, or a special tool's card -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- installed CLI tool: forensic value, editable command, run, output -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,12">
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Form.DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource CategoryBadge}" DataContext="{Binding Form}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CategoryBadgeText}" Text="{Binding CategoryLabel}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                        <TabControl DataContext="{Binding Form}" Style="{StaticResource FlatTabs}">
                          <TabItem Header="Overview" AutomationProperties.AutomationId="Tools.Tab.Overview">
                           <StackPanel>
                            <TextBlock Text="Forensic Value" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Usage"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Limitation, StringFormat=Limitation: {0}}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasLimitation, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Limitation"/>
                                </StackPanel>
                            </Border>

                            <StackPanel DataContext="{Binding Evtx}" AutomationProperties.AutomationId="Tools.EvtxSelection">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Event selection" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}"><StackPanel>
                                <RadioButton GroupName="EvtxMode" Content="All events" IsChecked="{Binding UseAll}" FontWeight="SemiBold"
                                             AutomationProperties.AutomationId="Tools.EvtxSelection.All"/>
                                <RadioButton GroupName="EvtxMode" Content="Selected events" IsChecked="{Binding UseSelected}" FontWeight="SemiBold" Margin="0,8,0,0"
                                             AutomationProperties.AutomationId="Tools.EvtxSelection.Use"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="22,2,0,8" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="Tools.EvtxSelection.Summary"/>
                                <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                    <Button Content="Customize…" Command="{Binding CustomizeCommand}" IsEnabled="{Binding UseSelected}" Margin="0,0,6,0"
                                            AutomationProperties.AutomationId="Tools.EvtxSelection.Customize"/>
                                    <Button Style="{StaticResource SubtleButton}" Content="&#xE712;" FontFamily="{DynamicResource Font.Icon}" IsEnabled="{Binding UseSelected}"
                                            ToolTip="Import, export or reset the selection" Click="EvtxMore_Click"
                                            AutomationProperties.AutomationId="Tools.EvtxSelection.More" AutomationProperties.Name="Event selection menu">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Import…" Command="{Binding ImportCommand}"/>
                                                <MenuItem Header="Export…" Command="{Binding ExportCommand}"/>
                                                <MenuItem Header="Reset to recommended" Command="{Binding ResetCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="22,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel DataContext="{Binding RecmdBatch}" AutomationProperties.AutomationId="Tools.RecmdBatch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Batch file" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}"><StackPanel>
                                <TextBlock Text="{Binding Current}" Margin="0,4,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.RecmdBatch.Current"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Browse…" Command="{Binding BrowseCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Tools.RecmdBatch.Browse"/>
                                        <Button Content="Reset" Command="{Binding ResetCommand}" ToolTip="Back to the built-in DFIRBatch.reb" AutomationProperties.AutomationId="Tools.RecmdBatch.Reset"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Batch file: inserted where {batchFile} appears in the command."/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel AutomationProperties.AutomationId="Tools.Command"
                                        Visibility="{Binding HasIngestCommands, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Command" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}"><StackPanel>
                                <WrapPanel Margin="0,0,0,2">
                                    <TextBlock Style="{StaticResource Caption}" Text="Variables: {file} {dir} {out} {root} {softwareHive} {toolDir} {dateFormat}" Margin="0,0,6,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{}{eventIds}" Margin="0,0,6,0" Visibility="{Binding HasEventIds, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{}{batchFile}" Margin="0,0,6,0" Visibility="{Binding HasBatchFile, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="Tools.Command.Info" AutomationProperties.Name="Variable help">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="460"
                                                           Text="{}{file}  the matched file&#10;{dir}  the matched folder (the file's folder for file rules)&#10;{out}  output folder (required)&#10;{root}  system root (drive or folder holding Windows\ and Users\)&#10;{softwareHive}  the SOFTWARE hive&#10;{toolDir}  the tool's own folder&#10;{dateFormat}  date format from Settings (use as --dt {dateFormat})&#10;{eventIds}  EvtxECmd only: event IDs from the selection&#10;{batchFile}  RECmd only: the batch file&#10;KAPE %sourceFile% / %sourceDirectory% / %destinationDirectory% also work."/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </WrapPanel>

                                <ItemsControl ItemsSource="{Binding IngestCommands}" Focusable="False" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3"
                                                           Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}"/>
                                                <!-- Source: what Run reads (remembered per rule) -->
                                                <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource MonoBox}" Text="{Binding SourcePath, Mode=OneWay}" Tag="{Binding SourcePlaceholder}"
                                                             ToolTip="{Binding SourcePath}" AutomationProperties.AutomationId="Tools.Source.Path"/>
                                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="6,0,0,0"
                                                            AutomationProperties.AutomationId="Tools.Source.Browse"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceHelp}" Margin="0,0,0,10"/>

                                                <!-- Output folder: where the results go (auto = next generated folder) -->
                                                <TextBlock Text="Output folder" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,2" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource MonoBox}" Text="{Binding OutputDir, Mode=OneWay}" ToolTip="{Binding OutputDir}"
                                                             AutomationProperties.AutomationId="Tools.OutputDir.Path"/>
                                                    <Button Grid.Column="1" Content="Change…" Command="{Binding ChangeOutputDirCommand}" Margin="6,0,0,0"
                                                            AutomationProperties.AutomationId="Tools.OutputDir.Change"/>
                                                    <Button Grid.Column="2" Content="Auto" Command="{Binding ResetOutputDirCommand}" Margin="6,0,0,0" ToolTip="Back to the generated output folder"
                                                            IsEnabled="{Binding OutputDirIsCustom}" AutomationProperties.AutomationId="Tools.OutputDir.Auto"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                                           Text="Auto uses a new folder under the case folder for every run."/>

                                                <TextBlock Text="Command" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <TextBox Style="{StaticResource MonoBox}" IsReadOnly="False" AcceptsReturn="False" TextWrapping="Wrap" Padding="8,6,36,6"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.AutomationId="Tools.Command.Text"/>
                                                    <Button Style="{StaticResource SubtleButton}" Content="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                            Command="{Binding CopyCommand}" ToolTip="Copy command"
                                                            AutomationProperties.AutomationId="Tools.Command.Copy" AutomationProperties.Name="Copy command"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Caption}"
                                                           Visibility="{Binding IsPageOnly, Converter={StaticResource BoolToVis}}"/>
                                                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource Brush.Error}"/>
                                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Error}" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,2,0,0" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Brush.Warning}"/>
                                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Warning}" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                                            AutomationProperties.AutomationId="Tools.Command.Save"/>
                                                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,6,0" ToolTip="Back to the default command"
                                                            AutomationProperties.AutomationId="Tools.Command.Reset"/>
                                                    <Button Command="{Binding RunCommand}" AutomationProperties.AutomationId="Tools.Command.Run"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisInv}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12"/>
                                                            <TextBlock Text="Run" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding StopCommand}" AutomationProperties.AutomationId="Tools.Command.Stop"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12"/>
                                                            <TextBlock Text="Stop" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel></Border>
                            </StackPanel>

                            <!-- Output: only after Run was pressed in this panel -->
                            <StackPanel Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Output">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Output" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                            Visibility="{Binding CurrentJob, Converter={StaticResource BoolToVis}}"
                                            Background="{Binding CurrentJob.State, Converter={StaticResource StateBg}}">
                                        <TextBlock AutomationProperties.AutomationId="Tools.State" Text="{Binding CurrentJob.State}" FontSize="{DynamicResource FontSize.Small}"
                                                   Foreground="{Binding CurrentJob.State, Converter={StaticResource StateFg}}"/>
                                    </Border>
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Text="{Binding CurrentJob.ExitCode, StringFormat=exit code {0}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource Tile}"><StackPanel>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Output.Status">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReasonIsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Source" Style="{StaticResource Caption}" Margin="0,0,12,4" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="{Binding LastSource}" ToolTip="Open in Explorer"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding LastSource}"
                                                AutomationProperties.AutomationId="Tools.Output.Source"/>
                                        <TextBlock Grid.Row="1" Text="Output folder" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="{Binding OutputFolderShown}" ToolTip="Open in Explorer"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding OutputFolderShown}"
                                                AutomationProperties.AutomationId="Tools.Output.Folder"/>
                                    </Grid>
                                    <TextBlock Text="Files produced" FontWeight="SemiBold" Margin="0,12,0,4" Visibility="{Binding HasOutputFiles, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding OutputFiles}" Focusable="False" AutomationProperties.AutomationId="Tools.Output.Files">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1,0,1">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Open in Analyze" Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenOutputInAnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.AutomationId="Tools.Output.Analyze"/>
                                        <Button Content="Open output folder"
                                                Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.AutomationId="Tools.Output.Open"/>
                                    </StackPanel>
                                    <c:LogConsole Height="190" Buffer="{Binding Log}" Margin="0,12,0,0"/>
                                </StackPanel></Border>
                            </StackPanel>
                           </StackPanel>
                          </TabItem>
                          <TabItem Header="Release" AutomationProperties.AutomationId="Tools.Tab.Release">
                           <StackPanel>
                            <StackPanel DataContext="{Binding Release}" AutomationProperties.AutomationId="Tools.Release">
                                <TextBlock Text="Installed" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="0,0,0,6" AutomationProperties.AutomationId="Tools.Release.Version"/>
                                        <TextBlock Grid.Row="1" Text=".NET build" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Flavor}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Text="Installed / updated" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstalledDate}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="3" Text="Executable" Style="{StaticResource Caption}" Margin="0,0,16,6" VerticalAlignment="Center"/>
                                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                                    AutomationProperties.AutomationId="Tools.Release.OpenFolder"/>
                                            <TextBlock Text="{Binding ExePath}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExePath}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="4" Text="Source" Style="{StaticResource Caption}" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Release.UpdateStatus">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding HasMaps, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding MapsTitle}" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MapsSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Release.Maps"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding SyncMessage}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                           </StackPanel>
                          </TabItem>
                        </TabControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- missing CLI / GUI tool: install -->
                    <Border Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Top"
                            Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.InstallPanel">
                        <StackPanel DataContext="{Binding SelectedTool}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource Brush.Control}" Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <!-- GUI tools have no forensic category -->
                                                <DataTrigger Binding="{Binding Kind}" Value="Gui">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.ErrorBg}" Margin="6,0,0,0">
                                    <TextBlock Text="not installed" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Error}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="Usage" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Usage}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       AutomationProperties.AutomationId="Tools.Usage"/>
                            <TextBlock Text="Install it from the Tools table on the Overview tab." TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Open Overview" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" MinWidth="110"
                                    Command="{Binding DataContext.GoOverviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="Tools.OpenOverview"/>
                        </StackPanel>
                    </Border>

                    <!-- installed GUI tool: usage, installed build, updates (one page, no tabs) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowGui, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.AutomationId="Tools.GuiPanel">
                        <StackPanel Margin="0,0,8,12">
                            <DockPanel Margin="0,0,0,10" DataContext="{Binding SelectedTool}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" MinWidth="100"
                                        Command="{Binding DataContext.Manager.LaunchGuiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Tile}" AutomationProperties.AutomationId="Tools.Launch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12"/>
                                        <TextBlock Text="Launch" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.WarningBg}" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding Tile.RequiresAdmin, Converter={StaticResource BoolToVis}}" ToolTip="Starts elevated (UAC prompt).">
                                        <TextBlock Text="admin" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Warning}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Usage" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Tile}">
                                <TextBlock Text="{Binding SelectedTool.Usage}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Usage"/>
                            </Border>

                            <StackPanel DataContext="{Binding GuiRelease}" AutomationProperties.AutomationId="Tools.GuiRelease">
                                <TextBlock Text="Installed" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="0,0,0,6" AutomationProperties.AutomationId="Tools.Gui.Version"/>
                                        <TextBlock Grid.Row="1" Text="Installed / updated" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstalledDate}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Text="Installation Path:" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding InstallPath}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}" TextWrapping="Wrap"
                                                       ToolTip="{Binding ExePath}" AutomationProperties.AutomationId="Tools.Gui.InstallPath"/>
                                            <Button Content="Open folder" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding OpenFolderCommand}"
                                                    AutomationProperties.AutomationId="Tools.Gui.OpenFolder"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Text="Source" Style="{StaticResource Caption}" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Gui.UpdateStatus">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Explore tools: DIE, ExifTool, CyberChef (install / update / remove) -->
                    <ScrollViewer Visibility="{Binding ShowExplore, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="Tools.Explore">
                        <StackPanel DataContext="{Binding ExploreTools}" Margin="0,0,8,8">
                            <TextBlock Text="Explore tools" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="Tools.Explore.Title"/>
                            <TextBlock Text="Small per-user downloads used by the Explore page. No admin rights; your files are only read, never run." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}" Margin="0,0,0,10" AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Explore.{0}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                                                            AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Explore.{0}.Remove}"/>
                                                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" VerticalAlignment="Center"
                                                            AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Explore.{0}.Install}"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                           AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Explore.{0}.Status}"/>
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" Margin="0,6,0,0"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AI: status and Use local AI. The assistant's documents are managed on the Learn page. -->
                    <ScrollViewer Visibility="{Binding ShowAi, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="Tools.Ai">
                        <StackPanel DataContext="{Binding AiDocuments}" Margin="0,0,8,8">
                            <TextBlock Text="AI" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="Tools.Ai.Title"/>
                            <TextBlock Text="Run the assistant on this PC with a local model. Nothing leaves the computer unless you use an online AI provider."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding AiStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="Tools.Ai.Status"/>

                            <Border Style="{StaticResource Tile}" Margin="0,0,0,10" AutomationProperties.AutomationId="Tools.Ai.Actions">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="Use local AI" Style="{StaticResource AccentButton}" Command="{Binding UseLocalAiCommand}" Margin="0,0,6,6"
                                                ToolTip="Uses Ollama if it is installed and downloads the model that suits this PC."
                                                AutomationProperties.AutomationId="Tools.Ai.SetUpLocalAi"/>
                                        <Button Content="Check again" Command="{Binding UseLocalAiCommand}" Margin="0,0,6,6" Visibility="{Binding LocalAi.OllamaMissing, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Tools.Ai.CheckAgain"/>
                                        <Button Content="Cancel" Command="{Binding LocalAi.CancelCommand}" Margin="0,0,6,6" Visibility="{Binding LocalAi.IsRunning, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Tools.Ai.Cancel"/>
                                        <Button Content="Get Ollama (ollama.com)" Style="{StaticResource LinkButton}" Command="{Binding LocalAi.OpenDownloadCommand}" Margin="0,0,6,6" Visibility="{Binding LocalAi.OllamaMissing, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Tools.Ai.GetOllama"/>
                                        <Button Content="Open log" Style="{StaticResource LinkButton}" Command="{Binding LocalAi.OpenLogCommand}" Margin="0,0,6,6" Visibility="{Binding LocalAi.ShowOpenLog, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Tools.Ai.OpenLog"/>
                                        <Button Content="Manage knowledge on the AI page" Command="{Binding ManageInLearnCommand}" Margin="0,0,6,6"
                                                ToolTip="Add, review and remove the documents the assistant can search."
                                                AutomationProperties.AutomationId="Tools.Ai.ManageInLearn"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding ProgressText, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.AutomationId="Tools.Ai.Progress"/>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.AutomationId="Tools.Ai.Message"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Spectre engine tools: one row per tool, per-row Install / Update, Install / update all, Refresh -->
                    <ScrollViewer Visibility="{Binding ShowSpectre, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="Tools.Spectre">
                        <StackPanel DataContext="{Binding SpectreTools}" Margin="0,0,8,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Tools.Spectre.Refresh"/>
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Install / update all" Style="{StaticResource AccentButton}" Command="{Binding InstallAllCommand}" ToolTip="Installs or updates the required tools. Optional tools (tshark, Zeek, MemProcFS, plaso) install from their own row."
                                            AutomationProperties.AutomationId="Tools.Spectre.InstallAll"/>
                                </StackPanel>
                                <TextBlock Text="Spectre (AI) tools" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="Tools.Spectre.Title"/>
                            </DockPanel>
                            <TextBlock Text="The tools the Spectre engine runs in the EZ Forensics Linux environment. Nothing is installed until you click; no admin rights needed." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="Tools.Spectre.Headline"/>
                            <Border Style="{StaticResource Tile}" Margin="0,0,0,10" Visibility="{Binding ShowDistroMissing, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.AutomationId="Tools.Spectre.DistroMissing">
                                <TextBlock Text="{Binding DistroMissingText}" TextWrapping="Wrap"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}" Margin="0,0,0,10" AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Spectre.{0}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding InstallCommand}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                            AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Spectre.{0}.Install}"/>
                                                    <Border Style="{StaticResource Chip}" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Importance}" FontSize="{DynamicResource FontSize.Small}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding UsedBy, StringFormat=Used by: {0}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                           AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Tools.Spectre.{0}.Status}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Tile}" Visibility="{Binding Log, Converter={StaticResource BoolToVis}}">
                                <c:LogConsole Height="190" Buffer="{Binding Log}" AutomationProperties.AutomationId="Tools.Spectre.Log"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- special tool (plaso, Zeek, RITA, Volatility): its Overview / Release tabs; Zeek's run controls come from this page's view model -->
                    <Grid Visibility="{Binding ShowSpecial, Converter={StaticResource BoolToVis}}">
                        <v:ToolManagerView DataContext="{Binding Manager}"
                                           Section="{Binding DataContext.SpecialSection, RelativeSource={RelativeSource AncestorType=v:ToolsView}}">
                            <v:ToolManagerView.ZeekRelease>
                                <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=v:ToolsView}}"
                                           Visibility="{Binding ZeekReady, Converter={StaticResource BoolToVisInv}}">
                                    <Button DockPanel.Dock="Right" Content="Set up Zeek" Style="{StaticResource AccentButton}" Command="{Binding SetUpZeekCommand}"
                                            AutomationProperties.AutomationId="Tools.Zeek.SetUp"/>
                                    <TextBlock Text="{Binding ZeekEngineText}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource Caption}"
                                               AutomationProperties.AutomationId="Tools.Zeek.Engine"/>
                                </DockPanel>
                            </v:ToolManagerView.ZeekRelease>
                            <v:ToolManagerView.ZeekRun>
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=v:ToolsView}}"
                                            AutomationProperties.AutomationId="Tools.ZeekPanel">
                                    <StackPanel Visibility="{Binding ShowZeekPanel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Options" Style="{StaticResource SectionTitle}"/>
                                        <Border Style="{StaticResource Tile}" AutomationProperties.AutomationId="Tools.Zeek.Configuration">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding ZeekIncludeLocal}" Content="Load the site policy (local)"/>
                                                <TextBlock Style="{StaticResource InfoGlyph}" Margin="6,0,0,0"
                                                           ToolTip="Adds extra logs such as software, known hosts and known services."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- capture or folder, case folder, the command as it will run (+ additional arguments), Run -->
                                        <ContentControl Content="{Binding ZeekCommand}" ContentTemplate="{StaticResource SpecialCommandTile}" Focusable="False"/>
                                    </StackPanel>

                                    <!-- Output: the run's job state and log -->
                                    <StackPanel Visibility="{Binding ShowRunLog, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Tools.Output">
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Cancel" Command="{Binding CancelJobCommand}" Margin="0,0,6,0"/>
                                                <Button Content="Open in Analyze" Command="{Binding OpenZeekResultsCommand}" Margin="0,0,6,0"/>
                                                <Button Content="Open output folder" Command="{Binding OpenOutputCommand}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Output" Style="{StaticResource SectionTitle}" Margin="0"/>
                                                <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                        Visibility="{Binding CurrentJob, Converter={StaticResource BoolToVis}}"
                                                        Background="{Binding CurrentJob.State, Converter={StaticResource StateBg}}">
                                                    <TextBlock AutomationProperties.AutomationId="Tools.State" Text="{Binding CurrentJob.State}" FontSize="{DynamicResource FontSize.Small}"
                                                               Foreground="{Binding CurrentJob.State, Converter={StaticResource StateFg}}"/>
                                                </Border>
                                                <TextBlock Margin="8,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Text="{Binding CurrentJob.ExitCode, StringFormat=exit code {0}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Tile}">
                                            <c:LogConsole Height="190" Buffer="{Binding Log}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </v:ToolManagerView.ZeekRun>
                        </v:ToolManagerView>
                    </Grid>

                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
    </DockPanel>

</UserControl>
