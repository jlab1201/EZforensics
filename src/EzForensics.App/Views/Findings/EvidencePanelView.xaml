<UserControl x:Class="EzForensics.App.Views.Findings.EvidencePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
             xmlns:fvm="clr-namespace:EzForensics.App.ViewModels.Findings"
             xmlns:vc="clr-namespace:EzForensics.App.Views.Controls"
             AutomationProperties.AutomationId="Findings.EvidencePanel.View">
    <UserControl.Resources>
        <!-- Spectre's mark: a filled teal square with an S. The examiner's labels: an outlined circle in the label's colour. They never look alike. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- the analyst label circle: colour by label -->
        <Style x:Key="AnalystRing" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark.Label}" Value="confirmed">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mark.Label}" Value="added">
                    <Setter Property="BorderBrush" Value="{DynamicResource Mark.Added}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Mark.Added}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MarkCellTemplate" DataType="{x:Type vm:RowItem}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" Background="Transparent" ToolTip="{Binding Mark.Text}"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Mark" AutomationProperties.Name="{Binding RowNumber, StringFormat=Labels of row {0}}"
                        AutomationProperties.ItemStatus="{Binding Mark.Text}">
                <Grid Width="18" Height="16" Margin="0,0,3,0">
                    <Border Width="15" Height="15" CornerRadius="3" Background="{DynamicResource Mark.Spectre}" HorizontalAlignment="Left"
                            Visibility="{Binding Mark.IsSpectre, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="S" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Grid Width="18" Height="16" Margin="0,0,3,0">
                    <Border Style="{StaticResource AnalystRing}" HorizontalAlignment="Left"
                            Visibility="{Binding Mark.HasLabel, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding Mark.LabelGlyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock Text="&#xE70B;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"
                           Visibility="{Binding Mark.HasNote, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RowNumberTemplate" DataType="{x:Type vm:RowItem}">
            <TextBlock Text="{Binding RowNumber, StringFormat={}{0:N0}}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
        </DataTemplate>
        <!-- rows the examiner marked not relevant: faded, cells struck through -->
        <Style x:Key="EvidenceRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark.IsNotRelevant}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EvidenceCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="vc:CellSearchHit.Enabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark.IsNotRelevant}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="RowMenu" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu">
            <MenuItem Header="Confirmed (C)" Command="{Binding ConfirmCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.Confirm"/>
            <MenuItem Header="Not relevant (N)" Command="{Binding NotRelevantCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.NotRelevant"/>
            <MenuItem Header="Add to the finding (A)" Command="{Binding AddCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.Add"/>
            <MenuItem Header="Note… (M)" Command="{Binding NoteCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.Note"/>
            <MenuItem Header="Clear my label (Del)" Command="{Binding ClearCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.Clear"/>
            <Separator/>
            <MenuItem Header="Make this a new finding…" Command="{Binding NewFindingCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.Menu.NewFinding"/>
        </ContextMenu>
    </UserControl.Resources>

    <Border Style="{DynamicResource Card}" Padding="12,10" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
        <DockPanel>
            <!-- header: the moment, then the file, its computer and the row count -->
            <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Open in Analyze" Style="{DynamicResource LinkButton}" Command="{Binding OpenInAnalyzeCommand}" VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="Open these rows on the Analyze page (Analyze's own flags mark them there)" AutomationProperties.AutomationId="Findings.EvidencePanel.OpenInAnalyze"/>
                    <Button Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}" Style="{DynamicResource SubtleButton}" Command="{Binding CloseCommand}" Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                            ToolTip="Close (Esc)" AutomationProperties.AutomationId="Findings.EvidencePanel.Close" AutomationProperties.Name="Close the evidence panel"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" TextTrimming="CharacterEllipsis" Margin="0"
                               AutomationProperties.AutomationId="Findings.EvidencePanel.Title"/>
                    <TextBlock Text="{Binding FileLine}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               AutomationProperties.AutomationId="Findings.EvidencePanel.File"/>
                </StackPanel>
            </DockPanel>

            <!-- several files: pick one (each with its count of Spectre rows) -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Files}" Margin="0,8,0,0" Focusable="False"
                          Visibility="{Binding HasSeveralFiles, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.Files">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type fvm:EvidencePanelFile}">
                        <Button Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Margin="0,0,6,4" Padding="8,3" AutomationProperties.AutomationId="Findings.EvidencePanel.FileChoice" AutomationProperties.Name="{Binding AutomationName}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                            <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CountText, StringFormat=' · {0}'}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- an engine without the flag tools: read-only, said plainly -->
            <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource Brush.WarningBg}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.ReadOnly">
                <TextBlock Text="{x:Static fvm:EvidencePanelViewModel.UpdateEngineText}" TextWrapping="Wrap"/>
            </Border>

            <!-- toolbar: search, all rows, previous / next, the examiner's labels -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="200" Margin="0,0,8,4" VerticalContentAlignment="Center"
                         Tag="Search these rows" ToolTip="Words in any column (AND, OR, NOT and quotes work as on Analyze)"
                         AutomationProperties.AutomationId="Findings.EvidencePanel.Search" AutomationProperties.Name="Search the evidence rows"/>
                <CheckBox Content="Show all rows" IsChecked="{Binding ShowAllRows}" VerticalAlignment="Center" Margin="0,0,10,4"
                          ToolTip="Show every row of the file, not only the rows behind the finding" AutomationProperties.AutomationId="Findings.EvidencePanel.ShowAll"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PreviousRowCommand}" ToolTip="Previous evidence row (K)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Previous" AutomationProperties.Name="Previous evidence row">
                    <TextBlock Text="&#xE70E;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NextRowCommand}" ToolTip="Next evidence row (J), across files too"
                        Margin="0,0,10,4" AutomationProperties.AutomationId="Findings.EvidencePanel.Next" AutomationProperties.Name="Next evidence row">
                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Confirmed: this row supports the finding (C)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Confirm">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource GlyphText}" Foreground="{DynamicResource Brush.Success}"/><TextBlock Text="Confirmed"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NotRelevantCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Not relevant: this row should not count (N)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.NotRelevant">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource GlyphText}" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="Not relevant"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Add: a row Spectre missed joins the finding's evidence (A)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Add">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource GlyphText}" Foreground="{DynamicResource Mark.Added}"/><TextBlock Text="Add"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NoteCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Write a note on the row (M)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Note">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70B;" Style="{StaticResource GlyphText}" Foreground="{DynamicResource Brush.Warning}"/><TextBlock Text="Note"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Remove your label from the row (Del)"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.Clear">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" Style="{StaticResource GlyphText}"/><TextBlock Text="Clear"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewFindingCommand}" IsEnabled="{Binding CanFlag}" ToolTip="Make a new finding from the selected rows"
                        AutomationProperties.AutomationId="Findings.EvidencePanel.NewFinding">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" Style="{StaticResource GlyphText}"/><TextBlock Text="New finding…"/></StackPanel>
                </Button>
            </WrapPanel>

            <!-- the note box -->
            <Border DockPanel.Dock="Top" Margin="0,4,0,0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.SurfaceAlt}"
                    Visibility="{Binding IsNoteOpen, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.NoteBox">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="Save note" Style="{DynamicResource AccentButton}" Command="{Binding SaveNoteCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Findings.EvidencePanel.NoteSave"/>
                        <Button Content="Cancel" Command="{Binding CancelNoteCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.NoteCancel"/>
                    </StackPanel>
                    <TextBox x:Name="NoteBox" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" MaxHeight="90"
                             Tag="Your note on the selected rows" AutomationProperties.AutomationId="Findings.EvidencePanel.NoteText" AutomationProperties.Name="Note"/>
                </DockPanel>
            </Border>

            <!-- make a new finding from the selected rows -->
            <Border DockPanel.Dock="Top" Margin="0,4,0,0" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.SurfaceAlt}"
                    Visibility="{Binding IsNewFindingOpen, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.NewFindingForm">
                <StackPanel>
                    <TextBlock Text="{Binding SelectionText, StringFormat='New finding from your selection ({0}). It is listed as added by analyst.'}" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,6">
                        <ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" ItemsSource="{x:Static fvm:EvidencePanelViewModel.Severities}" SelectedItem="{Binding NewFindingSeverity}"
                                  AutomationProperties.AutomationId="Findings.EvidencePanel.NewSeverity" AutomationProperties.Name="Severity"/>
                        <TextBox x:Name="NewTitleBox" Text="{Binding NewFindingTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Tag="Title"
                                 AutomationProperties.AutomationId="Findings.EvidencePanel.NewTitle" AutomationProperties.Name="Title"/>
                    </DockPanel>
                    <TextBox Text="{Binding NewFindingNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Tag="Note (optional)" Margin="0,0,0,6"
                             AutomationProperties.AutomationId="Findings.EvidencePanel.NewNote" AutomationProperties.Name="Note"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create finding" Style="{DynamicResource AccentButton}" Command="{Binding CreateFindingCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Findings.EvidencePanel.Create"/>
                        <Button Content="Cancel" Command="{Binding CancelNewFindingCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.CreateCancel"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- footer: the audit hint and a legend of the marks -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel AutomationProperties.AutomationId="Findings.EvidencePanel.Legend">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                            <Border Width="15" Height="15" CornerRadius="3" Background="{DynamicResource Mark.Spectre}" Margin="0,0,5,0">
                                <TextBlock Text="S" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Spectre evidence" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.6" BorderBrush="{DynamicResource Brush.Success}" Margin="0,0,5,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Confirmed" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.6" BorderBrush="{DynamicResource Brush.TextSecondary}" Margin="0,0,5,0">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Font.Icon}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Not relevant" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.6" BorderBrush="{DynamicResource Mark.Added}" Margin="0,0,5,0">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource Font.Icon}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Mark.Added}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Added by analyst" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                            <TextBlock Text="&#xE70B;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Analyst note" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{x:Static fvm:EvidencePanelViewModel.AuditHint}" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               AutomationProperties.AutomationId="Findings.EvidencePanel.AuditHint"/>
                </StackPanel>
            </Border>

            <!-- what happened (saved, refused, nothing selected) -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Warning}"
                       Visibility="{Binding Message, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.Message"/>

            <!-- the current row: its cells and its marks -->
            <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}" MaxHeight="120"
                    Visibility="{Binding HasCurrentRow, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.Detail">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DetailMarkText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="Findings.EvidencePanel.DetailMarks"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DetailCells}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,14,2" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}">
                                        <Run Text="{Binding Key, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/><Run Text=": " Foreground="{DynamicResource Brush.TextSecondary}"/><Run Text="{Binding Value, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- count line -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{DynamicResource Caption}"/>
                <TextBlock Text="{Binding CountLine}" Style="{DynamicResource Caption}" AutomationProperties.AutomationId="Findings.EvidencePanel.Count"/>
            </DockPanel>

            <!-- the grid: Analyze's data machinery, the panel's own marks -->
            <Grid Margin="0,4,0,0">
                <DataGrid x:Name="Grid" vc:CellSearchHit.Query="{Binding SearchText, FallbackValue='', TargetNullValue=''}" ItemsSource="{Binding Rows}" MouseDoubleClick="Grid_MouseDoubleClick" IsReadOnly="True" AutoGenerateColumns="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                          SelectionUnit="FullRow" SelectionMode="Extended" RowHeight="{DynamicResource Grid.RowHeight}" FrozenColumnCount="2"
                          FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}" HeadersVisibility="Column" CanUserSortColumns="False"
                          ClipboardCopyMode="ExcludeHeader" RowStyle="{StaticResource EvidenceRowStyle}" ContextMenu="{StaticResource RowMenu}"
                          SelectionChanged="Grid_SelectionChanged" AutomationProperties.AutomationId="Findings.EvidencePanel.Grid"/>
                <TextBlock Text="Reading the file…" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidencePanel.Loading"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
