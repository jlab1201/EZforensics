<UserControl x:Class="EzForensics.App.Views.Findings.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:svc="clr-namespace:EzForensics.App.Services"
             xmlns:fvm="clr-namespace:EzForensics.App.ViewModels.Findings"
             xmlns:fv="clr-namespace:EzForensics.App.Views.Findings">
    <UserControl.Resources>
        <!-- the engine's value next to an editable override -->
        <Style x:Key="EngineValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="RevertButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Content" Value="&#xE7A7;"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="ToolTip" Value="Put back the engine's value"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource Brush.Severity.Critical}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Foreground" Value="{DynamicResource Brush.Severity.High}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="Foreground" Value="{DynamicResource Brush.Severity.Medium}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="Foreground" Value="{DynamicResource Brush.Severity.Low}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource Brush.Severity.Info}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- severity colour on a ring or dot; the word is always shown or named next to it -->
        <!-- the review decision as a mark: a green check when confirmed, a red cross when rejected, nothing while pending -->
        <Style x:Key="ReviewMark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Approval}" Value="APPROVED"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/><Setter Property="Visibility" Value="Visible"/><Setter Property="ToolTip" Value="Confirmed"/></DataTrigger>
                <DataTrigger Binding="{Binding Approval}" Value="REJECTED"><Setter Property="Text" Value="&#xE711;"/><Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/><Setter Property="Visibility" Value="Visible"/><Setter Property="ToolTip" Value="Rejected"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeverityRing" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Severity.Critical}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Severity.High}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Severity.Medium}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Severity.Low}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Severity.Info}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeverityFill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Background" Value="{DynamicResource Brush.Severity.Critical}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Background" Value="{DynamicResource Brush.Severity.High}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="Background" Value="{DynamicResource Brush.Severity.Medium}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="Background" Value="{DynamicResource Brush.Severity.Low}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info"><Setter Property="Background" Value="{DynamicResource Brush.Severity.Info}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- one stage of the journey strip: pictogram in a severity ring, count badge, short name, severity word -->
        <!-- one side of the duplicate compare view -->
        <DataTemplate x:Key="DuplicateSideTemplate" DataType="{x:Type fvm:DuplicateSide}">
            <Border Style="{DynamicResource Card}" Padding="14" Margin="4" AutomationProperties.AutomationId="Findings.Compare.Side" AutomationProperties.Name="{Binding Title}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Style="{DynamicResource Caption}"><Run Text="{Binding Origin, Mode=OneWay}"/> <Run Text="·"/> </TextBlock>
                        <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityText}" FontSize="{DynamicResource FontSize.Caption}"/>
                        <TextBlock Style="{DynamicResource Caption}"> <Run Text="·"/> <Run Text="{Binding Rows, Mode=OneWay}"/> <Run Text="rows"/></TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Technique}" TextWrapping="Wrap" Visibility="{Binding Technique, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Host}" TextWrapping="Wrap" Visibility="{Binding Host, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Times}"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- one computer of the computers map -->
        <DataTemplate x:Key="HostTileTemplate" DataType="{x:Type fvm:HostTileViewModel}">
            <Border Width="196" Padding="10,8" Margin="0,0,8,8" CornerRadius="6" BorderThickness="1" ToolTip="{Binding ToolTip}" Cursor="Hand"
                    c:Motion.PopIn="True" AutomationProperties.AutomationId="Findings.Story.Host" AutomationProperties.Name="{Binding ToolTip}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEvidence}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icon}" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Host}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding Dots}" Margin="0,3,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <Border Style="{StaticResource SeverityFill}" Width="8" Height="8" CornerRadius="4" ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Text}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Text}" FontSize="{DynamicResource FontSize.Small}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CountText}" Style="{DynamicResource Caption}" FontSize="{DynamicResource FontSize.Small}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AliasLine}" Style="{DynamicResource Caption}" FontSize="10.5" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   Visibility="{Binding HasAliases, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.Host.Aliases"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <fv:LaneModeNameConverter x:Key="LaneName"/>
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" Padding="14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="seg" Property="Background" Value="{DynamicResource Brush.Surface}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <!-- a card's secondary action: a pictogram with a tooltip naming it -->
        <Style x:Key="CardIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,4">
                    <Button Command="{Binding AddMyAnalysisCommand}" Margin="0,0,6,0" ToolTip="Bring your key events and flagged rows from Analyze into this page"
                            AutomationProperties.AutomationId="Findings.AddMyAnalysis" AutomationProperties.Name="Add my analysis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add my analysis" VerticalAlignment="Center"/>
                            <Border CornerRadius="8" Padding="6,0" Margin="6,0,0,0" Background="{DynamicResource Brush.Accent}" ToolTip="{Binding SyncBadgeTip}"
                                    Visibility="{Binding HasSyncBadge, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.AddMyAnalysis.Badge">
                                <TextBlock Text="{Binding SyncBadgeText}" Foreground="{DynamicResource Brush.AccentText}" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PresentCommand}" Margin="0,0,6,0" ToolTip="Walk through the key events as slides, from the first one"
                            AutomationProperties.AutomationId="Findings.Present" AutomationProperties.Name="Present">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{DynamicResource Font.Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Present" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SpectreChipCommand}" Margin="0,0,6,0" ToolTip="Spectre is not set up. Click to check again, or to open its set-up."
                            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Findings.OpenSetup" AutomationProperties.Name="Spectre: not set up">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{DynamicResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Spectre: not set up" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding AnalyseButtonText}" Command="{Binding AnalyseCommand}" Margin="0,0,6,0" ToolTip="Run the Spectre analysis on this case; your edits are kept"
                            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisInv}}"
                            AutomationProperties.AutomationId="Findings.Analyse"/>
                    <Button Content="{Binding ReportButtonText}" Command="{Binding ToggleReportCommand}"
                            IsEnabled="{Binding HasAnalysis}" ToolTip="Generate and preview the report (your edits, approvals and exclusions are used)"
                            AutomationProperties.AutomationId="Findings.Report" AutomationProperties.Name="Report"/>
                </StackPanel>
                <c:PageHeader Title="{x:Static svc:PageNames.Findings}"/>
            </DockPanel>
            <TabControl Style="{DynamicResource FlatTabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="0,4,0,0" AutomationProperties.AutomationId="Findings.Tabs">
                <TabItem Header="Overview" AutomationProperties.AutomationId="Findings.ViewOverview" AutomationProperties.Name="Overview"
                         ToolTip="Summary, review status, severity, activity by tactic and key events"/>
                <TabItem Header="Details" IsEnabled="{Binding HasAnalysis}" AutomationProperties.AutomationId="Findings.Details" AutomationProperties.Name="Details"
                         ToolTip="All findings, with the editor beside them"/>
                <TabItem Header="Story" IsEnabled="{Binding HasAnalysis}" AutomationProperties.AutomationId="Findings.ViewStory" AutomationProperties.Name="Story"
                         ToolTip="The key events on a timeline, one slide at a time"/>
            </TabControl>
            <!-- hint: the case files changed since the analysis (dismissable) -->
            <Border Padding="12,8" Margin="0,6,0,0" CornerRadius="6" BorderThickness="1" Background="{DynamicResource Brush.InfoBg}" BorderBrush="{DynamicResource Brush.Info}"
                    Visibility="{Binding ShowEvidenceHint, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EvidenceChanged">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{DynamicResource SubtleButton}" Command="{Binding DismissEvidenceHintCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.AutomationId="Findings.EvidenceChanged.Dismiss"/>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{DynamicResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding EvidenceChangedText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
                </DockPanel>
            </Border>
            <!-- the computer the page is about: a label with one computer, a box with several (all tabs) -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowHostBar, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.HostBar">
                <TextBlock Text="&#xE770;" Style="{DynamicResource Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Computer"/>
                <TextBlock Text="{Binding SingleHostName}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Visibility="{Binding ShowHostLabel, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.HostLabel" AutomationProperties.Name="Computer"/>
                <ComboBox MinWidth="200" ItemsSource="{Binding HostChoices}" SelectedItem="{Binding SelectedHostChoice, Mode=TwoWay}"
                          Visibility="{Binding ShowHostPicker, Converter={StaticResource BoolToVis}}" ToolTip="Show the page for one computer, or for all of them"
                          AutomationProperties.AutomationId="Findings.HostPicker" AutomationProperties.Name="Computer"/>
            </StackPanel>
            <!-- status line: one quiet line, with the action it needs -->
            <DockPanel Margin="0,2,0,0" Visibility="{Binding HasCase, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.StatusBar">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelAnalysisCommand}" Margin="8,0,0,0" Style="{DynamicResource SubtleButton}"
                            Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}" ToolTip="Stop the Spectre analysis"
                            AutomationProperties.AutomationId="Findings.CancelAnalysis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsAnalysing}" Width="48" Height="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusLine}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{Binding StatusLine, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Status"/>
                    <TextBlock Text="{Binding RunResult, StringFormat=' · {0}'}" Style="{DynamicResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding RunResult, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.RunResult"/>
                </StackPanel>
            </DockPanel>
            <ContentControl x:Name="BannerHost" Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                            Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- no case to work on -->
        <Border Style="{DynamicResource Card}" Margin="0,8,0,0" Padding="24" Visibility="{Binding HasCase, Converter={StaticResource BoolToVisInv}}"
                AutomationProperties.AutomationId="Findings.NoCase">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No case folder yet. Run Ingest first: Spectre then analyses the case and its story shows here." Style="{DynamicResource Caption}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <!-- a synthetic case with findings, key events and a process tree; works without evidence, Spectre or a local AI -->
                <Button Content="Load demo case" Command="{Binding LoadDemoCaseCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Visibility="{Binding IsDemoAvailable, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="Findings.LoadDemoCase"
                        ToolTip="Open a made-up case (host DEMO-WS01) to try the Review page, the process tree and Analyze without evidence"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
                AutomationProperties.AutomationId="Findings.Details.Stale">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowDetails}" Value="True"/>
                                <Condition Binding="{Binding ShowStaleBanner}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Re-run" Style="{DynamicResource AccentButton}" Command="{Binding AnalyseCommand}" Margin="10,0,0,0"
                        ToolTip="Run the Spectre analysis again; your edits are kept"/>
                <TextBlock Text="{x:Static fvm:FindingsViewModel.StaleText}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding StaleDetail}"/>
            </DockPanel>
        </Border>

        <Grid x:Name="PageBody" Margin="0,8,0,0" Visibility="{Binding HasCase, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition x:Name="EvidenceSplitCol" Width="0"/>
            <ColumnDefinition x:Name="EvidenceCol" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="PageContent">

            <!-- ============================================================ overview (default) -->
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story">
                <StackPanel Margin="0,0,8,16">
                    <!-- old or undated analysis: one clear way forward -->
                    <Border Padding="20,18" Margin="0,0,0,12" CornerRadius="6" BorderThickness="1" Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
                            Visibility="{Binding ShowRerunCard, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.Stale">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" FontSize="40" Foreground="{DynamicResource Brush.Warning}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <Button DockPanel.Dock="Right" Content="Re-run" Style="{DynamicResource AccentButton}" Command="{Binding AnalyseCommand}" Margin="18,0,0,0" Padding="18,6"
                                    VerticalAlignment="Center" ToolTip="Run the Spectre analysis again; your edits are kept" AutomationProperties.AutomationId="Findings.Story.Rerun"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static fvm:FindingsViewModel.RerunTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding StaleDetail}"
                                           AutomationProperties.AutomationId="Findings.Story.RerunTitle"/>
                                <TextBlock Text="{x:Static fvm:FindingsViewModel.RerunText}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="Findings.Story.NoDates"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,16,0,0" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.EmptyState">
                        <Border Style="{DynamicResource Card}" Padding="24" Margin="0,0,8,0" AutomationProperties.AutomationId="Findings.EmptyState.Mine">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource Font.Icon}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"
                                           ToolTip="Brings in the key events you made in Analyze and the rows you flagged. Nothing is changed in Analyze."/>
                                <TextBlock Text="Use my analysis" Style="{DynamicResource SectionTitle}" HorizontalAlignment="Center" Margin="0,8,0,12"/>
                                <Button Content="Use my analysis" Style="{DynamicResource AccentButton}" Command="{Binding AddMyAnalysisCommand}" IsEnabled="{Binding CanUseMyAnalysis}"
                                        HorizontalAlignment="Center" Padding="18,6" AutomationProperties.AutomationId="Findings.Empty.UseMine"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}" Padding="24" Margin="8,0,0,0" AutomationProperties.AutomationId="Findings.EmptyState.Spectre">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource Font.Icon}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"
                                           ToolTip="Spectre looks through the case and flags what stands out. The story shows here when it is done."/>
                                <TextBlock Text="Run Spectre first" Style="{DynamicResource SectionTitle}" HorizontalAlignment="Center" Margin="0,8,0,12"/>
                                <Button Content="Run Spectre first" Command="{Binding AnalyseCommand}" HorizontalAlignment="Center" Padding="18,6"
                                        AutomationProperties.AutomationId="Findings.Empty.RunSpectre"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
                        <!-- Summary and Review status side by side when wide, then Activity by tactic below; all stacked when narrow -->
                        <Grid Margin="0,0,-8,4" AutomationProperties.AutomationId="Findings.Overview.Tiles">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Padding="20,14,20,16" Margin="0,0,8,8" AutomationProperties.AutomationId="Findings.Story.Hero">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWideLayout}" Value="False">
                                            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="VerticalAlignment" Value="Top"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Summary" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/>
                                <!-- findings by severity: colour on the ring, the words and counts beside it -->
                                <StackPanel x:Name="HeroRing" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            AutomationProperties.AutomationId="Findings.Story.SeverityRing" AutomationProperties.Name="{Binding SeverityRingName}" ToolTip="{Binding SeverityRingName}">
                                    <c:SeverityDonut Counts="{Binding SeverityCounts}" Width="168" Height="168" Thickness="20"/>
                                    <ItemsControl ItemsSource="{Binding SeverityLegend}" VerticalAlignment="Center" Margin="14,0,0,0" Focusable="False" AutomationProperties.AutomationId="Findings.Overview.Severity.Levels">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type fvm:SeverityDot}">
                                                <Button HorizontalContentAlignment="Left" Padding="6,2" Margin="0,1" ToolTip="{Binding ToolTip}"
                                                        AutomationProperties.AutomationId="Findings.Overview.Severity.Level" AutomationProperties.Name="{Binding AutomationName}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource SeverityFill}" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Count}" FontWeight="SemiBold" MinWidth="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityText}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Padding="20,14,20,16" Margin="0,0,8,8" AutomationProperties.AutomationId="Findings.Overview.Review">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWideLayout}" Value="False">
                                            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="VerticalAlignment" Value="Top"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Review status" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- review progress -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0" ToolTip="Findings you have confirmed or rejected"
                                                AutomationProperties.AutomationId="Findings.Story.ReviewProgress" AutomationProperties.Name="{Binding ReviewText}">
                                        <c:ReviewRing Value="{Binding ReviewedCount}" Maximum="{Binding ReviewTotal}" Width="108" Height="108" HorizontalAlignment="Center"/>
                                        <TextBlock Text="reviewed" Style="{DynamicResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- the four lines; a click lists those findings in Details -->
                                    <ItemsControl ItemsSource="{Binding ReviewBreakdown}" VerticalAlignment="Center" Focusable="False" AutomationProperties.AutomationId="Findings.Overview.ReviewLines">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type fvm:ReviewLine}">
                                                <Button Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left" Padding="6,3" Margin="0,1"
                                                        Command="{Binding DataContext.FilterByReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="Show them in Details" AutomationProperties.AutomationId="Findings.Overview.ReviewLine" AutomationProperties.Name="{Binding Text}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bucket}" Value="Confirmed"><Setter Property="Fill" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Bucket}" Value="Rejected"><Setter Property="Fill" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Count}" FontWeight="SemiBold" MinWidth="22" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- every finding has a decision -->
                                <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,8" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.Success}"
                                        Visibility="{Binding AllReviewed, Converter={StaticResource BoolToVis}}" c:Motion.PopIn="True"
                                        AutomationProperties.AutomationId="Findings.Story.AllReviewed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Report" Style="{DynamicResource AccentButton}" Command="{Binding ToggleReportCommand}" Padding="16,4"
                                                ToolTip="Generate and preview the report" AutomationProperties.AutomationId="Findings.Story.AllReviewed.Report"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Success}"/>
                                        <TextBlock Text="{x:Static fvm:FindingsViewModel.AllReviewedText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Activity by tactic: a radar on the 12 ATT&CK tactics, full width under the two tiles -->
                        <Border Padding="16,12,16,10" Margin="0,0,8,8" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Findings.Story.Hosts" AutomationProperties.Name="Activity by tactic">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWideLayout}" Value="False"><Setter Property="Grid.Row" Value="2"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Activity by tactic" Style="{DynamicResource SectionTitle}"/>
                                    <TextBlock Style="{DynamicResource InfoGlyph}" Margin="6,0,0,0"
                                               ToolTip="Findings per ATT&amp;CK tactic. A finding counts under the tactic of its technique. Distance from the centre is the square root of the count, scaled to the busiest tactic."/>
                                </StackPanel>
                                <c:TacticRadar MaxHeight="420" HorizontalAlignment="Center" Data="{Binding Radar}"
                                               AutomationProperties.AutomationId="Findings.Overview.Tactic" AutomationProperties.Name="Activity by tactic"
                                               AutomationProperties.HelpText="Findings per ATT&amp;CK tactic."/>
                                <TextBlock Text="{Binding RadarUnmappedText}" Style="{DynamicResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                           Visibility="{Binding RadarUnmappedText, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Overview.Tactic.Unmapped"/>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <TextBlock Text="Loading the timeline…" Style="{DynamicResource Caption}" Visibility="{Binding IsLoadingTimeline, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.AutomationId="Findings.Story.TimelineLoading"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding TimelineError, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.TimelineError">
                            <TextBlock Text="{Binding TimelineError}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" MaxWidth="720"/>
                            <Button Content="Try again" Command="{Binding RefreshTimelineCommand}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- the key events as plain cards -->
                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Content="{Binding DuplicateBadgeText}" Command="{Binding OpenCompareCommand}" Style="{DynamicResource SubtleButton}"
                                    Visibility="{Binding HasDuplicatePairs, Converter={StaticResource BoolToVis}}" ToolTip="Compare the key events that may be the same thing"
                                    AutomationProperties.AutomationId="Findings.Duplicates.Badge"/>
                            <TextBlock Text="Key events" Style="{DynamicResource SectionTitle}" AutomationProperties.AutomationId="Findings.Story.KeyEventsTitle"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding StoryMoments}" Margin="0,0,-10,0" AlternationCount="100000" AutomationProperties.AutomationId="Findings.Story.Moments" AutomationProperties.Name="Key events">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.OverviewColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type fvm:MomentCardViewModel}">
                                    <StackPanel>
                                    <Border Margin="0,0,10,10" CornerRadius="6" BorderThickness="1"
                                            c:Motion.SlideIn="True" c:Motion.StaggerMs="40" c:Motion.Lift="True"
                                            c:ReviewStamp.Reviewed="{Binding IsReviewed}" c:ReviewStamp.Stamp="{Binding ElementName=Stamp}" c:ReviewStamp.Token="{Binding StampToken}"
                                            Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand" ToolTip="Open in Details"
                                            AutomationProperties.AutomationId="Findings.Story.Evidence" AutomationProperties.Name="{Binding PlainTitle}">
                                        <Border.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.ShowMomentInDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ShowMomentInDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.ControlHover}"/></Trigger>
                                                    <DataTrigger Binding="{Binding Approval}" Value="APPROVED"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Approval}" Value="REJECTED"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                        <!-- the review stamp: lands when the key event is reviewed (confirmed or not important), then fades (hidden at rest and with animations off) -->
                                        <Border x:Name="Stamp" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0"
                                                BorderThickness="3" CornerRadius="6" Padding="14,4" Background="{DynamicResource Brush.Surface}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StampText}" Value="Not a key event"><Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                                <TextBlock Text="{Binding StampText}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            </StackPanel>
                                        </Border>
                                        <DockPanel>
                                        <!-- the severity accent bar on the left edge -->
                                        <Border DockPanel.Dock="Left" Width="5" CornerRadius="5,0,0,5" Style="{StaticResource SeverityFill}"/>
                                        <DockPanel Margin="12,10,12,10">
                                            <!-- the stage pictogram, ringed in the severity colour -->
                                            <Grid DockPanel.Dock="Left" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,14,0" ToolTip="{Binding Stage}">
                                                <Border CornerRadius="28" BorderThickness="3" Background="{DynamicResource Brush.SurfaceAlt}" Style="{StaticResource SeverityRing}">
                                                    <TextBlock Text="{Binding StageGlyph}" FontFamily="{DynamicResource Font.Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top" CornerRadius="10" Padding="8,2" Background="{DynamicResource Brush.SurfaceAlt}"
                                                            Visibility="{Binding OriginText, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.Card.Origin">
                                                        <TextBlock Text="{Binding OriginText}" Style="{DynamicResource Caption}"/>
                                                    </Border>
                                                    <!-- the review status as a coloured pill: green confirmed, red rejected, amber while it needs a look -->
                                                    <Border DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top" CornerRadius="10" Padding="8,2" ToolTip="{Binding StatusText}"
                                                            AutomationProperties.AutomationId="Findings.Story.Card.StatusPill">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Approval}" Value="APPROVED"><Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Approval}" Value="REJECTED"><Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="{DynamicResource Font.Icon}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE121;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Approval}" Value="APPROVED"><Setter Property="Text" Value="&#xE73E;"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Approval}" Value="REJECTED"><Setter Property="Text" Value="&#xE711;"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="Findings.Story.Card.Status"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- why it matters, what we can't tell and the evidence: a helper, not a section -->
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding TechnicalText}">
                                                        <Run Text="{Binding PlainTitle, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center">
                                                        <TextBlock Text="&#xE946;" Style="{DynamicResource Icon}" FontSize="13" VerticalAlignment="Center"
                                                               Margin="6,0,0,0" FontWeight="Normal" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"
                                                               ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000" AutomationProperties.AutomationId="Findings.Story.Card.Help"
                                                               AutomationProperties.Name="About this key event">
                                                        <TextBlock.ToolTip>
                                                            <StackPanel MaxWidth="420">
                                                                <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Visibility="{Binding Why, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasCantTell, Converter={StaticResource BoolToVis}}">
                                                                    <Run Text="What we can't tell:" FontWeight="SemiBold"/> <Run Text="{Binding CantTell, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding EvidenceLine}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding EvidenceLine, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                        </InlineUIContainer>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Style="{DynamicResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingText}"
                                                           AutomationProperties.AutomationId="Findings.Story.Card.Mapping">
                                                    <Run Text="{Binding MappingText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding CountLine, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PromotedWhy}" Style="{DynamicResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PromotedWhy}"
                                                           Visibility="{Binding PromotedWhy, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.Card.PromotedWhy"/>
                                            </StackPanel>
                                        </DockPanel>
                                        </DockPanel>
                                        </Grid>
                                    </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Spectre picked no key events for this case. Details lists everything it found." Style="{DynamicResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowNoMoments, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.NoMoments"/>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ details: the findings on the left, the editor on the right -->
            <Grid x:Name="DetailsGrid" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.DetailsView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.45*" MinWidth="380"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="0.55*" MinWidth="420"/>
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource Card}" Padding="10" AutomationProperties.AutomationId="Findings.AllFindings">
                  <TabControl Style="{DynamicResource FlatTabs}" SelectedIndex="{Binding DetailListTab, Mode=TwoWay}" AutomationProperties.AutomationId="Findings.Details.ListTabs">
                   <TabItem Header="Findings" AutomationProperties.AutomationId="Findings.Details.FindingsTab">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" Command="{Binding RefreshFindingsCommand}" Margin="4,0,0,0"
                                        ToolTip="Reload the findings" AutomationProperties.AutomationId="Findings.Refresh" AutomationProperties.Name="Refresh"/>
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFiltersCommand}" Margin="4,0,0,0" ToolTip="Clear the search and the filters"
                                        AutomationProperties.AutomationId="Findings.ClearFilters" AutomationProperties.Name="Clear filters"/>
                                <TextBox Style="{DynamicResource ClearableTextBox}" Padding="6,4,26,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search findings"
                                         AutomationProperties.AutomationId="Findings.Search" AutomationProperties.Name="Search findings"/>
                            </DockPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <ComboBox Width="104" Margin="0,0,6,0" ItemsSource="{x:Static fvm:FindingsViewModel.SeverityFilters}" SelectedItem="{Binding SeverityFilter}"
                                          ToolTip="Severity" AutomationProperties.AutomationId="Findings.FilterSeverity" AutomationProperties.Name="Severity filter"/>
                                <ComboBox Width="116" Margin="0,0,6,0" ItemsSource="{x:Static fvm:FindingsViewModel.ReviewFilters}" SelectedItem="{Binding ReviewFilter}"
                                          ToolTip="Review status" AutomationProperties.AutomationId="Findings.Details.FilterReview" AutomationProperties.Name="Review filter"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ListSummary}" Style="{DynamicResource Caption}" Margin="0,0,0,6" AutomationProperties.AutomationId="Findings.Summary"/>
                        <!-- column headers (the second line of each row holds Approval and Time, the third the mapping) -->
                        <Grid DockPanel.Dock="Top" Margin="6,0,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/><ColumnDefinition Width="20"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="&#xE734;" FontFamily="{DynamicResource Font.Icon}" Style="{DynamicResource Caption}" ToolTip="Key event"/>
                            <TextBlock Grid.Column="2" Text="Analyst" Style="{DynamicResource Caption}"/>
                            <TextBlock Grid.Column="3" Text="Severity" Style="{DynamicResource Caption}"/>
                            <TextBlock Grid.Column="4" Text="Title · Approval · Time (UTC)" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid>
                            <ListBox x:Name="FindingList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="FindingList_SelectionChanged" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Findings.List" AutomationProperties.Name="Findings">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="FindingMenu_Opened">
                                        <MenuItem x:Name="EditFindingItem" Header="Edit finding…" Click="EditFinding_Click" AutomationProperties.AutomationId="Findings.List.EditFinding"/>
                                        <MenuItem Header="Show the evidence" Command="{Binding ShowFindingEvidenceCommand}" AutomationProperties.AutomationId="Findings.EvidencePanel.FromList"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" BorderThickness="3,0,0,0" Padding="3,3,0,3" Margin="-4,0,0,0" AutomationProperties.AutomationId="Findings.Details.RowCard">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Approval}" Value="APPROVED"><Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Approval}" Value="REJECTED"><Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                                        <!-- selected: the list's selection fill shows through, the coloured edge stays -->
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="Transparent"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        <Grid ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/><ColumnDefinition Width="20"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- edited dot; a yellow ! when Spectre suggests a change -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource ReviewMark}" Margin="0,0,2,0" VerticalAlignment="Top" AutomationProperties.AutomationId="Findings.Details.ReviewMark"/>
                                                <TextBlock Text="●" Foreground="{DynamicResource Brush.Accent}" ToolTip="Edited by you" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}" ToolTip="Spectre suggests a change"
                                                           Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StarGlyph}" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Warning}" ToolTip="Key event"
                                                       VerticalAlignment="Top" AutomationProperties.AutomationId="Findings.Details.Star"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OriginText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" AutomationProperties.AutomationId="Findings.Details.Origin"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Severity}" Style="{StaticResource SeverityText}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MetaLine}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Findings.Details.RowMeta"/>
                                                <TextBlock Text="{Binding Mapping}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mapping}"
                                                           Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Details.RowMapping"/>
                                                <TextBlock Text="{Binding Status}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" Visibility="{Binding Status, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding ChipText}" Style="{DynamicResource Caption}" Foreground="{DynamicResource Brush.Info}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasInfoChips, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Details.Chips"/>

                                            </StackPanel>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- states -->
                            <TextBlock Text="Loading the findings…" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoadingFindings, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Loading"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                        Visibility="{Binding FindingsError, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Error">
                                <TextBlock Text="{Binding FindingsError}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap"/>
                                <Button Content="Try again" Command="{Binding RefreshFindingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Text="No findings yet. They appear when Spectre has analysed the case." Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowEmptyList, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Empty"/>
                            <TextBlock Text="No finding matches the filters." Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.NoMatch"/>
                        </Grid>
                    </DockPanel>
                   </TabItem>
                   <TabItem Header="{Binding KeyEventsTitle}" AutomationProperties.AutomationId="Findings.Details.KeyEventsTab">
                    <Grid>
                        <ListBox x:Name="KeyEventList" ItemsSource="{Binding KeyEventRows}" SelectedItem="{Binding SelectedKeyEvent, Mode=TwoWay}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Findings.KeyEvents.List" AutomationProperties.Name="Key events">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type fvm:KeyEventRowViewModel}">
                                    <Grid ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="Findings.KeyEvents.Row" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE735;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OriginText}" VerticalAlignment="Top" AutomationProperties.AutomationId="Findings.KeyEvents.Origin"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Severity}" Style="{StaticResource SeverityText}" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLine}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Findings.KeyEvents.Meta"/>
                                            <TextBlock Text="{Binding MappingText}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingText}"
                                                       Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.Mapping"/>
                                            <TextBlock Text="{Binding ChipText}" Style="{DynamicResource Caption}" Foreground="{DynamicResource Brush.Info}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.Chips"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No key events yet. Select findings and use Add to timeline or Group into key event." Style="{DynamicResource Caption}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                   Visibility="{Binding HasKeyEvents, Converter={StaticResource BoolToVisInv}}" AutomationProperties.AutomationId="Findings.KeyEvents.Empty"/>
                    </Grid>
                   </TabItem>
                  </TabControl>
                </Border>
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE" AutomationProperties.AutomationId="Findings.Details.Splitter" AutomationProperties.Name="Resize the list and the editor">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent"><Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Brush.BorderStrong}"/></Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- the editor: always open for the selected finding -->
                <Border Grid.Column="2" x:Name="EditorPane" Style="{DynamicResource Card}" Padding="12" AutomationProperties.AutomationId="Findings.Editor">
                    <Grid>
                        <TextBlock Text="Select a finding" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowNoFindingSelected, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.NoSelection"/>
                        <TextBlock Text="Select a key event" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowNoKeyEventSelected, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.NoSelection"/>
                        <!-- the key event editor -->
                        <DockPanel Visibility="{Binding ShowKeyEventEditor, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.Editor">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Style="{DynamicResource SectionTitle}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Key event"/> <Run Text="·"/> <Run Text="{Binding SelectedKeyEvent.OriginText, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding SelectedKeyEvent.FindingCountText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedKeyEvent.ChipText}" Style="{DynamicResource Caption}" Foreground="{DynamicResource Brush.Info}" TextWrapping="Wrap" Margin="0,2,0,4"
                                           Visibility="{Binding SelectedKeyEvent.HasChips, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.Editor.Chips"/>
                                <WrapPanel>
                                    <Button Content="Keep anyway" Command="{Binding KeepKeyEventAnywayCommand}" Margin="0,0,6,4" ToolTip="Spectre no longer reports this moment; keep it on the timeline"
                                            Visibility="{Binding SelectedKeyEvent.IsRemovedAtSource, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.KeepAnyway"/>
                                    <Button Content="Remove key event" Command="{Binding RemoveKeyEventRowCommand}" Margin="0,0,6,4" ToolTip="Take it off the timeline; its findings stay in the list"
                                            AutomationProperties.AutomationId="Findings.KeyEvents.Remove"/>
                                </WrapPanel>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Save" Style="{DynamicResource AccentButton}" Command="{Binding SaveKeyEventCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Findings.KeyEvents.Save"/>
                                        <Button Content="Discard" Command="{Binding DiscardKeyEventEditsCommand}" IsEnabled="{Binding IsKeyEventDirty}" AutomationProperties.AutomationId="Findings.KeyEvents.Discard"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding KeyEventEditMessage}" Style="{DynamicResource Caption}" VerticalAlignment="Center" AutomationProperties.AutomationId="Findings.KeyEvents.EditMessage"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding KeyEventDraftTitle, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.AutomationId="Findings.KeyEvents.Title" AutomationProperties.Name="Key event title"/>
                                    <TextBlock Text="Time (UTC, yyyy-MM-dd HH:mm:ss)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding KeyEventDraftTime, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Tag="No time"
                                             AutomationProperties.AutomationId="Findings.KeyEvents.Time" AutomationProperties.Name="Key event time (UTC)"/>
                                    <TextBlock Text="Use yyyy-MM-dd HH:mm:ss (UTC), or leave it empty." Foreground="{DynamicResource Brush.Error}" Style="{DynamicResource Caption}"
                                               Visibility="{Binding KeyEventTimeInvalid, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeyEvents.TimeInvalid"/>
                                    <TextBlock Text="Severity" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{x:Static fvm:FindingsViewModel.Severities}" SelectedItem="{Binding KeyEventDraftSeverity}" HorizontalAlignment="Left" Width="140"
                                              AutomationProperties.AutomationId="Findings.KeyEvents.Severity" AutomationProperties.Name="Key event severity"/>
                                    <TextBlock Text="Mapping" Style="{StaticResource FieldLabel}"/>
                                    <c:TechniquePicker Text="{Binding KeyEventDraftMitre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsInvalid="{Binding KeyEventMitreInvalid}"
                                                       AutomationProperties.AutomationId="Findings.KeyEvents.Mitre" AutomationProperties.Name="Key event mapping"/>
                                    <TextBlock Text="{x:Static fvm:FindingsViewModel.MitreInvalidTip}" Foreground="{DynamicResource Brush.Error}" Style="{DynamicResource Caption}"
                                               Visibility="{Binding KeyEventMitreInvalid, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding KeyEventDraftNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                             AutomationProperties.AutomationId="Findings.KeyEvents.Notes" AutomationProperties.Name="Key event notes"/>
                                    <TextBlock Text="Findings" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding KeyEventFindings}" AutomationProperties.AutomationId="Findings.KeyEvents.Findings">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type fvm:KeyEventFindingLine}">
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{DynamicResource SubtleButton}" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemoveFindingFromSelectedKeyEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            ToolTip="Take this finding out of the key event" AutomationProperties.AutomationId="Findings.KeyEvents.Finding.Remove"/>
                                                    <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityText}" Width="64" DockPanel.Dock="Left"/>
                                                    <TextBlock TextTrimming="CharacterEllipsis"><Hyperlink Command="{Binding DataContext.ShowKeyEventFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Run Text="{Binding Title, Mode=OneWay}"/></Hyperlink></TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <DockPanel Visibility="{Binding ShowFindingEditor, Converter={StaticResource BoolToVis}}">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Style="{DynamicResource SectionTitle}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Selected.Finding.FindingId, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Selected.OriginText, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Selected.Approval, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{DynamicResource Caption}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Selected.Finding.ArtifactType, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Selected.Time, Mode=OneWay}"/>
                                </TextBlock>
                                <WrapPanel>
                                    <Button Content="Confirm" Command="{Binding ApproveCommand}" Margin="0,0,6,4" ToolTip="Confirm this finding; you give a rationale (A)"
                                            AutomationProperties.AutomationId="Findings.Approve"/>
                                    <Button Content="Reject" Command="{Binding RejectCommand}" Margin="0,0,6,4" ToolTip="Reject this finding (false positive); you give a rationale (R)"
                                            AutomationProperties.AutomationId="Findings.Reject"/>
                                    <Button x:Name="AddToKeyEventButton" Click="AddToKeyEventButton_Click" Margin="0,0,6,4"
                                            ToolTip="Put the selected findings in a key event (Ctrl+click or Shift+click to select several)"
                                            AutomationProperties.AutomationId="Findings.AddToKeyEvent" AutomationProperties.Name="Add to key event">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Add to key event"/>
                                            <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icon}" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Group into key event" Command="{Binding GroupIntoKeyEventCommand}" Margin="0,0,6,4"
                                            ToolTip="One key event from the selected findings (Ctrl+click or Shift+click to select several)" AutomationProperties.AutomationId="Findings.GroupIntoKeyEvent"/>
                                    <Button Content="Keep anyway" Command="{Binding KeepAnywayCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,4" ToolTip="The source no longer has it; keep it on the page"
                                            Visibility="{Binding Selected.IsRemovedAtSource, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.KeepAnyway"/>
                                    <Button Content="Remove" Command="{Binding RemoveItemCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,4" ToolTip="Remove it; a sync never brings it back"
                                            Visibility="{Binding Selected.IsRemovedAtSource, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.RemoveItem"/>
                                    <Button Content="Compare" Command="{Binding OpenCompareCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,4" ToolTip="Compare with the key event that may be the same"
                                            Visibility="{Binding Selected.HasDuplicatePair, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Compare.Open"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Spectre suggests (from the chat) -->
                            <Border DockPanel.Dock="Top" DataContext="{Binding Selected}" Margin="0,0,0,8" Padding="10" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
                                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Suggestion">
                                <StackPanel>
                                    <TextBlock Text="Spectre suggests…" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding SuggestionLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SuggestionWhy}" Style="{DynamicResource Caption}" Margin="0,4,0,0" Visibility="{Binding SuggestionWhy, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Accept" Margin="0,0,6,0" Command="{Binding DataContext.AcceptSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Save the change now, noted as suggested by Spectre" AutomationProperties.AutomationId="Findings.Suggestion.Accept"/>
                                        <Button Content="Edit" Margin="0,0,6,0" Command="{Binding DataContext.EditSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Put it in the editor to adjust" AutomationProperties.AutomationId="Findings.Suggestion.Edit"/>
                                        <Button Content="Dismiss" Command="{Binding DataContext.DismissSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.AutomationId="Findings.Suggestion.Dismiss"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TabControl Style="{DynamicResource FlatTabs}" SelectedIndex="{Binding SelectedDetailTab, Mode=TwoWay}" AutomationProperties.AutomationId="Findings.DetailTabs">
                                <!-- editor -->
                                <TabItem Header="Details" AutomationProperties.AutomationId="Findings.Tab.Details">
                                    <DockPanel>
                                        <!-- save bar -->
                                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="Save" Style="{DynamicResource AccentButton}" Command="{Binding SaveCommand}" Margin="0,0,6,0" AutomationProperties.AutomationId="Findings.Save"/>
                                                    <Button Content="Discard" Command="{Binding DiscardEditsCommand}" IsEnabled="{Binding IsDirty}" AutomationProperties.AutomationId="Findings.Discard"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" Tag="Reason for the change (required to save)" MaxLength="300"
                                                             AutomationProperties.AutomationId="Findings.Reason" AutomationProperties.Name="Reason for the change"/>
                                                    <TextBlock Text="{Binding EditMessage}" Style="{DynamicResource Caption}" Margin="0,4,0,0" Visibility="{Binding EditMessage, Converter={StaticResource BoolToVis}}"
                                                               AutomationProperties.AutomationId="Findings.EditMessage"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,0,8,0">
                                                <!-- key event -->
                                                <TextBlock Text="Key event" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Visibility="{Binding IsSelectedKeyEvent, Converter={StaticResource BoolToVis}}"/>
                                                <DockPanel Margin="0,0,0,2" LastChildFill="False" HorizontalAlignment="Left" Visibility="{Binding IsSelectedKeyEvent, Converter={StaticResource BoolToVis}}">
                                                    <Button DockPanel.Dock="Left" Command="{Binding ToggleSelectedKeyEventCommand}" Margin="0,0,6,0" Padding="10,4"
                                                            ToolTip="Takes the finding out of its key event" AutomationProperties.AutomationId="Findings.KeyEvent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding KeyEventGlyph}" FontFamily="{DynamicResource Font.Icon}" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelectedKeyEvent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding KeyEventButtonText}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DockPanel>

                                                <!-- title -->
                                                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource RevertButton}" Command="{Binding RevertFieldCommand}" CommandParameter="title"
                                                            Visibility="{Binding TitleDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Revert.Title" AutomationProperties.Name="Revert title"/>
                                                    <TextBox x:Name="TitleBox" Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.AutomationId="Findings.Title" AutomationProperties.Name="Title"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding EngineTitle, StringFormat='Spectre: {0}'}" Style="{StaticResource EngineValue}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding TitleDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Engine.Title"/>

                                                <!-- severity -->
                                                <TextBlock Text="Severity" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource RevertButton}" Command="{Binding RevertFieldCommand}" CommandParameter="severity"
                                                            Visibility="{Binding SeverityDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Revert.Severity" AutomationProperties.Name="Revert severity"/>
                                                    <ComboBox ItemsSource="{x:Static fvm:FindingsViewModel.Severities}" SelectedItem="{Binding DraftSeverity}" HorizontalAlignment="Left" Width="140"
                                                              AutomationProperties.AutomationId="Findings.Severity" AutomationProperties.Name="Severity"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding EngineSeverity, StringFormat='Spectre: {0}'}" Style="{StaticResource EngineValue}" Margin="0,2,0,0"
                                                           Visibility="{Binding SeverityDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Engine.Severity"/>

                                                <!-- mapping: one line per technique, "T1218 · System Binary Proxy Execution — Defense Evasion" -->
                                                <TextBlock Text="Mapping" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource RevertButton}" Command="{Binding RevertFieldCommand}" CommandParameter="mitre_attack"
                                                            Visibility="{Binding MitreDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Revert.Mitre" AutomationProperties.Name="Revert mapping"/>
                                                    <c:TechniquePicker x:Name="TechniqueBox" Text="{Binding DraftMitre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsInvalid="{Binding MitreInvalid}"
                                                              AutomationProperties.AutomationId="Findings.Mitre" AutomationProperties.Name="Mapping"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding EngineMitreDisplay, StringFormat='Spectre: {0}'}" Style="{StaticResource EngineValue}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding MitreDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Engine.Mitre"/>

                                                <!-- notes -->
                                                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource RevertButton}" Command="{Binding RevertFieldCommand}" CommandParameter="notes"
                                                            Visibility="{Binding NotesDiffers, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Revert.Notes" AutomationProperties.Name="Clear notes"/>
                                                    <TextBox Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="160"
                                                             VerticalScrollBarVisibility="Auto" Tag="Notes are kept with the finding and go into the report" AutomationProperties.AutomationId="Findings.Notes" AutomationProperties.Name="Notes"/>
                                                </DockPanel>


                                                <!-- rows: one range per CSV (editable for a finding made in Analyze) -->
                                                <StackPanel Visibility="{Binding HasRowLines, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Rows">
                                                    <TextBlock Text="Rows" Style="{StaticResource FieldLabel}"/>
                                                    <ItemsControl ItemsSource="{Binding RowLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type fvm:FindingRowsLine}">
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding FileName}" Width="150" Style="{DynamicResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding CsvRelPath}"/>
                                                                    <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditable, Converter={StaticResource Not}}" TextWrapping="Wrap"
                                                                             ToolTip="Row numbers as the grid shows them, for example 12-15 or 1, 15, 16, 21-24" AutomationProperties.AutomationId="Findings.Rows.Range"
                                                                             AutomationProperties.Name="{Binding FileName, StringFormat='Rows in {0}'}"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding RowsError}" Foreground="{DynamicResource Brush.Error}" Style="{DynamicResource Caption}" TextWrapping="Wrap"
                                                               Visibility="{Binding RowsInvalid, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Rows.Error"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>

                                <!-- evidence -->
                                <TabItem Header="Evidence" AutomationProperties.AutomationId="Findings.Tab.Evidence">
                                    <!-- the rows behind the selected finding: the same evidence view as the panel (flags, notes, Open in Analyze) -->
                                    <Grid Margin="0,6,0,0">
                                        <fv:EvidencePanelView DataContext="{Binding DetailEvidence}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                              AutomationProperties.AutomationId="Findings.Evidence"/>
                                        <TextBlock Text="{Binding EvidenceMessage}" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="Findings.EvidenceMessage"/>
                                        <TextBlock Text="Loading the evidence…" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLoadingEvidence, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </TabItem>

                                <!-- history -->
                                <TabItem Header="History" AutomationProperties.AutomationId="Findings.Tab.History">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryMessage}" Style="{DynamicResource Caption}" Margin="0,0,0,6" Visibility="{Binding HistoryMessage, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.AutomationId="Findings.HistoryMessage"/>
                                        <Grid>
                                            <ListBox ItemsSource="{Binding HistoryLines}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Findings.History">
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="Loading the history…" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsLoadingHistory, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ report flyout -->
            <Grid Panel.ZIndex="10" Visibility="{Binding IsReportOpen, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.ReportFlyout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*" MaxWidth="1000"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Window}" Opacity="0.55" MouseLeftButtonDown="ReportBackdrop_MouseDown"/>
                <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="14" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}" Style="{DynamicResource SubtleButton}" Command="{Binding CloseReportCommand}"
                                    ToolTip="Close (Esc)" AutomationProperties.AutomationId="Findings.CloseReport" AutomationProperties.Name="Close the report"/>

                        <StackPanel>
                            <TextBlock Text="Build report" Style="{DynamicResource SectionTitle}"/>
                            
                            <!-- pending approvals: a warning, not a blocker -->
                            <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="4" Background="{DynamicResource Brush.WarningBg}" HorizontalAlignment="Left"
                                    Visibility="{Binding PendingApprovals, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Pending">
                                <TextBlock Text="{Binding PendingApprovals, StringFormat='Pending approvals: {0}. You can still generate the report.'}"/>
                            </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Build report" Style="{DynamicResource AccentButton}" Command="{Binding GenerateReportCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="Findings.Generate"/>
                                <Button Content="Save as HTML" Command="{Binding SaveReportHtmlCommand}" Margin="0,0,8,0" ToolTip="One file you can open in a browser or print" AutomationProperties.AutomationId="Findings.SaveHtml"/>
                                <Button Content="Save as Markdown" Command="{Binding SaveReportMarkdownCommand}" IsEnabled="{Binding HasReport}" Margin="0,0,8,0" AutomationProperties.AutomationId="Findings.SaveMarkdown"/>
                                <Button Content="Open in browser" Command="{Binding OpenReportInBrowserCommand}" IsEnabled="{Binding CanOpenInBrowser}" Margin="0,0,8,0" AutomationProperties.AutomationId="Findings.OpenBrowser"/>
                                <Button Content="Open folder" Command="{Binding OpenReportFolderCommand}" IsEnabled="{Binding CanOpenFolder}" Margin="0,0,8,0" AutomationProperties.AutomationId="Findings.OpenFolder"/>
                                
                                
                            </StackPanel>
                            <TextBlock Text="{Binding ReportStatus}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ReportStatus, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.ReportStatus"/>
                                                    </StackPanel>
                        </DockPanel>
                        <Border Margin="0,10,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid>
                                <fv:MarkdownPreview Markdown="{Binding ReportPreview}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.AutomationId="Findings.Preview"/>
                                <TextBlock Text="Build the report to see a preview here." Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasReport, Converter={StaticResource BoolToVisInv}}"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================ duplicate compare view -->
            <Border x:Name="CompareOverlay" Background="{DynamicResource Brush.Window}" Panel.ZIndex="5" Visibility="{Binding IsCompareOpen, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="Findings.Compare">
                <DockPanel DataContext="{Binding Compare}" Margin="0,0,8,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Close" Command="{Binding DataContext.CloseCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{DynamicResource SubtleButton}" AutomationProperties.AutomationId="Findings.Compare.Close"/>
                        <TextBlock Style="{DynamicResource SectionTitle}"><Run Text="{Binding MatchText, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="Merge" Command="{Binding MergeCommand}" Margin="0,0,6,0" ToolTip="Fold the second into the first; its rows count with the first" AutomationProperties.AutomationId="Findings.Compare.Merge"/>
                        <Button Content="Keep both" Command="{Binding KeepBothCommand}" ToolTip="They are different things; ask again only if their rows change" AutomationProperties.AutomationId="Findings.Compare.KeepBoth"/>
                    </StackPanel>
                    <UniformGrid Columns="2">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Keep this" Command="{Binding KeepACommand}" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="Keep this one; the other is hidden as a duplicate" AutomationProperties.AutomationId="Findings.Compare.KeepA"/>
                            <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource DuplicateSideTemplate}" AutomationProperties.AutomationId="Findings.Compare.A"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Keep this" Command="{Binding KeepBCommand}" HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="Keep this one; the other is hidden as a duplicate" AutomationProperties.AutomationId="Findings.Compare.KeepB"/>
                            <ContentControl Content="{Binding B}" ContentTemplate="{StaticResource DuplicateSideTemplate}" AutomationProperties.AutomationId="Findings.Compare.B"/>
                        </DockPanel>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!-- ============================================================ Story tab: the slides -->
            <Border x:Name="WalkthroughOverlay" Background="{DynamicResource Brush.Window}" Focusable="True" FocusVisualStyle="{x:Null}"
                    DataContext="{Binding Walkthrough}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" PreviewMouseDown="Walkthrough_PreviewMouseDown"
                    AutomationProperties.AutomationId="Findings.Walkthrough" AutomationProperties.Name="Timeline slides"
                    AutomationProperties.HelpText="Left and Right, Space, Page Up and Page Down move between slides">
                <DockPanel Margin="4,0,4,4">
                    <!-- top bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Confirmed only" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Page.ConfirmedOnly, Mode=TwoWay}"
                                      ToolTip="Show only the key events whose finding you confirmed, in both the Timeline and the Attack flow"
                                      AutomationProperties.AutomationId="Findings.Story.ConfirmedOnly"/>
                            <Button x:Name="AutoplayButton" Style="{DynamicResource SubtleButton}" Margin="0,0,6,0" Command="{Binding ToggleAutoplayCommand}"
                                    Visibility="{Binding Page.ShowTimelineView, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Move to the next slide every few seconds (Space). Any click or key pauses it." AutomationProperties.AutomationId="Findings.Walkthrough.Autoplay">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{DynamicResource Font.Icon}" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsAutoplay}" Value="True"><Setter Property="Text" Value="&#xE769;"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AutoplayText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}" Margin="0,0,10,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left" AutomationProperties.AutomationId="Findings.Story.View">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Timeline" GroupName="StoryView" Style="{StaticResource SegmentButton}" IsChecked="{Binding Page.IsTimelineViewSelected, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="Findings.Story.View.Timeline"/>
                                <RadioButton Content="Attack flow" GroupName="StoryView" Style="{StaticResource SegmentButton}" IsChecked="{Binding Page.IsAttackFlowViewSelected, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="Findings.Story.View.AttackFlow"/>
                            </StackPanel>
                        </Border>
                        <TextBlock VerticalAlignment="Center" Visibility="{Binding Page.ShowTimelineView, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding ProgressText, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </TextBlock>
                    </DockPanel>
                    <Grid>
                    <DockPanel Visibility="{Binding Page.ShowTimelineView, Converter={StaticResource BoolToVis}}">

                    <!-- bottom bar: Back, dots, Next -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}" MinWidth="40" VerticalAlignment="Center"
                                ToolTip="Previous (Left)" AutomationProperties.Name="Back" AutomationProperties.AutomationId="Findings.Walkthrough.Back">
                            <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"/>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Dots}" Margin="10,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Findings.Walkthrough.Dots">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type fvm:SlideDot}">
                                    <Button Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" Cursor="Hand" Margin="3,0" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="2">
                                                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Brush.Border}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Text}"/></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource AccentButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" MinWidth="40" VerticalAlignment="Center"
                                ToolTip="Next (Right)" AutomationProperties.Name="Next" AutomationProperties.AutomationId="Findings.Walkthrough.Next">
                            <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource Font.Icon}" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <!-- the computer(s); the slide's computer is bold (the severity counts are on Overview) -->
                    <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="8,0,8,10" Focusable="False"
                               Visibility="{Binding HasSummaryLine, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Walkthrough.SummaryLine">
                        <TextBlock Text="{Binding ComputerLabel, StringFormat={}{0}:}" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Visibility="{Binding HasComputers, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Computers}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{DynamicResource Caption}"/>
                                        <TextBlock Text="{Binding Suffix}" Style="{DynamicResource Caption}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- the timeline glides to the slide's moment -->
                    <Border DockPanel.Dock="Top" Style="{DynamicResource Card}" Padding="0,6" Margin="0,0,0,24"
                            Visibility="{Binding Page.ShowStoryTimeline, Converter={StaticResource BoolToVis}}">
                        <c:StoryTimeline x:Name="SlideLine" Timeline="{Binding Page.HostTimeline}" FocusMomentId="{Binding FocusMomentId}" FollowFocus="True"
                                         SelectedMomentId="{Binding Page.SelectedMomentId, Mode=OneWay}"
                                         AutomationProperties.AutomationId="Findings.Walkthrough.Timeline" AutomationProperties.Name="Timeline (UTC)"/>
                    </Border>

                    <!-- the slide's words -->
                    <ScrollViewer x:Name="SlideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Border x:Name="SlideCard" Style="{DynamicResource Card}" MaxWidth="900" HorizontalAlignment="Center" Margin="8,0,8,8" Padding="24,16"
                                AutomationProperties.AutomationId="Findings.Walkthrough.Panel">
                        <Grid x:Name="SlidePanel" HorizontalAlignment="Stretch">
                            <Grid.RenderTransform><TranslateTransform x:Name="SlideShift"/></Grid.RenderTransform>

                            <!-- overview -->
                            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Walkthrough.Overview">
                                <TextBlock Text="The story so far" Style="{DynamicResource Caption}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Page.HeadlineText}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,14"/>
                                <TextBlock Text="{Binding OverviewHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- one key event -->
                            <StackPanel DataContext="{Binding Card}" Visibility="{Binding DataContext.IsMoment, ElementName=WalkthroughOverlay, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center" AutomationProperties.AutomationId="Findings.Walkthrough.Moment">
                                <!-- a looping illustration of the kind of activity (still when animations are off); shrinks when the slide is short
                                     (FindingsView.FitSlideScene) so the actions stay in view -->
                                <Grid x:Name="SlideIcon" Width="220" Height="160" Margin="0,0,0,8" HorizontalAlignment="Center" ToolTip="{Binding Stage}">
                                    <Viewbox Stretch="Uniform">
                                        <c:StageScene Stage="{Binding Stage}" Technique="{Binding TechniqueText}" Severity="{Binding Severity}"
                                                      AutomationProperties.Name="{Binding Stage}" AutomationProperties.AutomationId="Findings.Walkthrough.Scene"/>
                                    </Viewbox>
                                </Grid>
                                <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" CornerRadius="10" Padding="8,2"
                                        HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.AutomationId="Findings.Walkthrough.ConfirmedBadge" AutomationProperties.Name="Confirmed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Confirmed" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{DynamicResource Caption}" TextAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="{Binding DataContext.MomentHeader, ElementName=WalkthroughOverlay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding PlainTitle}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,4" ToolTip="{Binding TechnicalText}"
                                           AutomationProperties.AutomationId="Findings.Walkthrough.Title"/>
                                <TextBlock Text="{Binding DataContext.SlideLine, ElementName=WalkthroughOverlay}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" ToolTip="{Binding WhyText}"
                                           AutomationProperties.AutomationId="Findings.Walkthrough.Why"/>
                                <TextBlock Text="{Binding CardTime}" Style="{DynamicResource Caption}" TextAlignment="Center" Margin="0,2,0,0" AutomationProperties.AutomationId="Findings.Walkthrough.Time"/>
                                <TextBlock Text="{Binding CardTactic}" Style="{DynamicResource Caption}" TextAlignment="Center" AutomationProperties.AutomationId="Findings.Walkthrough.Tactic"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource ReviewMark}"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Caption}" VerticalAlignment="Center" AutomationProperties.AutomationId="Findings.Walkthrough.Status"/>
                                    <TextBlock Text="  · AI reading" Style="{DynamicResource Caption}" VerticalAlignment="Center" Visibility="{Binding WhyIsAi, Converter={StaticResource BoolToVis}}"
                                               ToolTip="Written by Spectre's AI model from the cited findings; check it against the evidence"/>
                                </StackPanel>
                                <Expander Header="More" Margin="0,10,0,0" HorizontalAlignment="Center" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding WhyText}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <TextBlock Style="{DynamicResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" Visibility="{Binding HasCantTell, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.AutomationId="Findings.Walkthrough.CantTell">
                                            <Run Text="What we can't tell:" FontWeight="SemiBold"/> <Run Text="{Binding CantTell, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding EvidenceLine}" Style="{DynamicResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" ToolTip="{Binding TechnicalText}"
                                                   AutomationProperties.AutomationId="Findings.Walkthrough.Evidence"/>
                                    </StackPanel>
                                </Expander>

                                <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Center">
                                    <Button Content="Confirm" Margin="0,0,8,4"
                                            Command="{Binding DataContext.ConfirmCommand, ElementName=WalkthroughOverlay}" ToolTip="This is right: confirm the key event's finding (you give a short reason)"
                                            AutomationProperties.AutomationId="Findings.Walkthrough.Confirm"/>
                                    <Button Content="Not a key event" Style="{StaticResource CardButton}" Margin="0,0,8,4"
                                            Command="{Binding DataContext.NotImportantCommand, ElementName=WalkthroughOverlay}" ToolTip="Take this key event off the timeline; its findings stay in the list (recorded with your name)"
                                            AutomationProperties.AutomationId="Findings.Walkthrough.NotImportant"/>
                                    <Button Content="Show the evidence" Style="{StaticResource CardButton}" Margin="0,0,8,4"
                                            Command="{Binding DataContext.ShowEvidenceCommand, ElementName=WalkthroughOverlay}" ToolTip="Show the rows behind it in a panel here; you can flag them"
                                            AutomationProperties.AutomationId="Findings.Walkthrough.ShowEvidence"/>
                                    <Button Content="Ask Spectre" Style="{StaticResource CardButton}" Margin="0,0,8,4"
                                            Command="{Binding DataContext.AskCommand, ElementName=WalkthroughOverlay}" ToolTip="Ask Spectre about this key event in the chat"
                                            AutomationProperties.AutomationId="Findings.Walkthrough.Ask"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- summary -->
                            <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Walkthrough.Summary">
                                <TextBlock Text="Where the review stands" Style="{DynamicResource Caption}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding ConfirmedText}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,8"
                                           AutomationProperties.AutomationId="Findings.Walkthrough.Confirmed"/>
                                <TextBlock Text="{Binding OpenText}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="Findings.Walkthrough.Open"/>
                                <TextBlock Text="{Binding UndatedText}" Style="{DynamicResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                           Visibility="{Binding UndatedText, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Walkthrough.Undated"/>
                                <Button Content="Make report" Style="{DynamicResource AccentButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding MakeReportCommand}"
                                        ToolTip="Go to Overview and open the report" AutomationProperties.AutomationId="Findings.Walkthrough.MakeReport"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </ScrollViewer>
                    </DockPanel>
                    <!-- Attack flow: the key events as a flow graph -->
                    <Grid x:Name="AttackFlowHost" Visibility="{Binding Page.ShowAttackFlowView, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.AttackFlow">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <c:AttackFlowGraph x:Name="AttackFlow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,8"
                                               Nodes="{Binding Page.AttackFlowNodes}" ShowHost="{Binding Page.ShowFlowHost}" SelectedId="{Binding Page.SelectedMomentId, Mode=OneWay}"
                                               NodeClicked="Flow_NodeClicked" NodeDoubleClicked="Flow_NodeDoubleClicked"
                                               AutomationProperties.AutomationId="Findings.Story.AttackFlow.Graph" AutomationProperties.Name="Attack flow (UTC)"/>
                        </ScrollViewer>
                        <TextBlock Text="No confirmed key events yet." Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Page.ShowNoConfirmed, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Findings.Story.AttackFlow.NoConfirmed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,18,0">
                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}" FontSize="15" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Key events in time order, in a column for each tactic. An arrow means the next event in time (then), not that one caused the other. Times are UTC. Click selects, double click opens it in Details."
                                       ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000" AutomationProperties.AutomationId="Findings.Story.AttackFlow.Info" AutomationProperties.Name="About the attack flow"/>
                            <Button Content="&#xE72C;" FontFamily="{DynamicResource Font.Icon}" Style="{DynamicResource SubtleButton}" Click="Flow_Replay" ToolTip="Replay"
                                    AutomationProperties.AutomationId="Findings.Story.AttackFlow.Replay" AutomationProperties.Name="Replay"/>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ============================================================ evidence panel: docked on the right, takes its own column, resizable (Esc closes) -->
        <GridSplitter x:Name="EvidenceSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Visibility="Collapsed" ToolTip="Drag to resize the panel" AutomationProperties.AutomationId="Findings.EvidencePanel.Splitter">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent"><Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Brush.BorderStrong}"/></Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border x:Name="EvidenceSlide" Grid.Column="2" DataContext="{Binding EvidencePanel}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="Findings.EvidencePanel" AutomationProperties.Name="Evidence panel"
                AutomationProperties.HelpText="C confirmed, N not relevant, A add, M note, Delete clears your label, J and K move between evidence rows, Esc closes">
            <Border.RenderTransform><TranslateTransform x:Name="EvidenceShift"/></Border.RenderTransform>
            <fv:EvidencePanelView x:Name="EvidencePanelView"/>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
