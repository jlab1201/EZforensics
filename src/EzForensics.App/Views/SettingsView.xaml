<UserControl x:Class="EzForensics.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,16,0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <c:PageHeader Title="Options"/>
            <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}" Margin="0,6,0,0"
                            Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,6,0"/>
                <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" MinWidth="90"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                <Run Text="Options file: "/><Run Text="{Binding SettingsPath, Mode=OneWay}"/>
                <Run Text="  ·  App log: "/><Run Text="{Binding LogPath, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="CardsGrid" VerticalAlignment="Top" SizeChanged="CardsGrid_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondColumn" Width="*"/></Grid.ColumnDefinitions>
                <!-- wide: 3 rows (Install|Display, Flags|Ingest, AI|Hot Keys); narrow: one column of 6 (code-behind) -->
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="CardInstall" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Style="{StaticResource SectionTitle}" Text="Installation"/></StackPanel>
                        <Grid DataContext="{Binding Edit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Tools root"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource {x:Type TextBox}}" Margin="0,10,0,0"
                             Text="{Binding ToolsRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="6,10,0,0"
                            Command="{Binding DataContext.BrowseToolsRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Max parallel jobs"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left"
                             Text="{Binding MaxParallel, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Job timeout (minutes)"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left"
                             Text="{Binding JobTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" Text="Case folder"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding CaseRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="Browse…" Margin="6,10,0,0"
                            Command="{Binding DataContext.BrowseCaseRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,16,0">
                        <TextBlock Text="Output names" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:HelpTip Text="Only affects jobs you run from the Tools page, e.g. TypedURLs_NTUSER.DAT.csv instead of 20261007123456_TypedURLs__NTUSER.DAT.csv (originals are kept in the case manifest). Ingest runs always use the standard case names (Host\Category\Artifact.csv)." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.OutputNames"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                        <CheckBox Content="Tools page: remove timestamp prefix from output file names" IsChecked="{Binding StripTimestampPrefix}"
                                  AutomationProperties.AutomationId="Settings.StripTimestampPrefix"
                                  AutomationProperties.Name="Tools page: remove timestamp prefix from output file names"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,16,0">
                        <TextBlock Text="Tool logging" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:HelpTip Text="Debug adds lines starting with &quot;# Debug:&quot; to every job log: the full command line (quoted), working directory, whether EZ Forensics runs as Administrator, the tool's path, version and signature, the exit code, the duration and the last lines of its output. Use it when a tool fails and you need to see why; Normal keeps the logs short." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.ToolLogging"/>
                    </StackPanel>
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,10,0,0" Width="180" HorizontalAlignment="Left"
                              ItemsSource="{x:Static vm:SettingsViewModel.ToolLogLevels}" SelectedItem="{Binding ToolLogLevel}"
                              AutomationProperties.AutomationId="Settings.ToolLogLevel" AutomationProperties.Name="Tool logging"/>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,16,0">
                        <TextBlock Text="Updates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:HelpTip Text="Looks for a newer version on the project's GitHub releases. Only works for a copy installed with EzForensics-Setup.exe. Leave the box empty to use the default; paste another GitHub repository URL, an https feed URL or a folder to use that instead." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.Updates"/>
                    </StackPanel>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,10,0,0" Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"
                             Tag="empty = https://github.com/jlab1201/EZforensics"
                             AutomationProperties.AutomationId="Settings.UpdateFeedUrl" AutomationProperties.Name="Update feed"/>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,16,0">
                        <TextBlock Text="Examiner name" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:HelpTip Text="Recorded with every edit and approval on the Review page. Leave empty to use your Windows user name." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.Examiner"/>
                    </StackPanel>
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,10,0,0" Width="260" HorizontalAlignment="Left" Text="{Binding ExaminerName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="empty = Windows user name" AutomationProperties.AutomationId="Settings.ExaminerName" AutomationProperties.Name="Examiner name"/>

                    <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for updates" Margin="0,0,6,0"
                                    Command="{Binding DataContext.CheckAppUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="Settings.CheckAppUpdate"/>
                            <Button Content="Install and restart"
                                    Command="{Binding DataContext.InstallAppUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="Settings.InstallAppUpdate"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding DataContext.UpdateStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   AutomationProperties.AutomationId="Settings.UpdateStatus"/>
                    </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="CardDisplay" Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Style="{StaticResource SectionTitle}" Text="Display"/></StackPanel>
                        <Grid DataContext="{Binding Edit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Theme"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,10,0,0" Width="180" HorizontalAlignment="Left"
                              ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="UI font"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="260" IsEditable="True" AutomationProperties.AutomationId="Settings.UiFontFamily"
                                  ItemsSource="{x:Static vm:SettingsViewModel.FontFamilies}"
                                  Text="{Binding UiFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Font used across the app (a fallback list such as 'Segoe UI Variable Text, Segoe UI' is allowed)"/>
                        <TextBlock Text="Size" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox Width="80" IsEditable="True" AutomationProperties.AutomationId="Settings.UiFontSize"
                                  ItemsSource="{x:Static vm:SettingsViewModel.FontSizes}"
                                  Text="{Binding UiFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" Text="Monospace font"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="260" IsEditable="True" AutomationProperties.AutomationId="Settings.MonoFontFamily"
                                  ItemsSource="{x:Static vm:SettingsViewModel.FontFamilies}"
                                  Text="{Binding MonoFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Logs, command previews, the Analyze table and the cell viewer"/>
                        <TextBlock Text="Size" VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox Width="80" IsEditable="True" AutomationProperties.AutomationId="Settings.MonoFontSize"
                                  ItemsSource="{x:Static vm:SettingsViewModel.FontSizes}"
                                  Text="{Binding MonoFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" Text="Date format (--dt)"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"
                             Tag="empty = tool default (yyyy-MM-dd HH:mm:ss)" FontFamily="{DynamicResource Font.Mono}"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,13,16,0">
                        <TextBlock Text="Analyze hints" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <c:HelpTip Text="Hides reliability banners and column markers on Analyze for good. To hide them only until you close the app, use Analyze &gt; Actions &gt; Hide hints." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.AnalyzeHints"/>
                    </StackPanel>
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Width="180" HorizontalAlignment="Left"
                              SelectedValuePath="Tag" SelectedValue="{Binding ShowAnalyzeHints}"
                              AutomationProperties.AutomationId="Settings.ShowAnalyzeHints" AutomationProperties.Name="Analyze hints">
                        <ComboBoxItem Content="Show"><ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Hide"><ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag></ComboBoxItem>
                    </ComboBox>

                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="CardFlags" Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Style="{StaticResource SectionTitle}" Text="Analyze Flags"/><c:HelpTip Text="Flags, in the order shown in the flag menu, filter and Ctrl+1..9. Rename, recolour, reorder, add or remove them. Flags are saved by id, so renaming never breaks flags already set." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.AnalyzeFlags"/></StackPanel>
<StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding DataContext.FlagItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FlagEditItem}">
                                    <WrapPanel Margin="0,2">
                                        <Border Style="{StaticResource FlagSwatch}" Background="{Binding Brush}"/>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,0,0"
                                                 AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Label}"
                                                 AutomationProperties.Name="{Binding Id, StringFormat=Flag label {0}}"/>
                                        <TextBox Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="6,0,0,0" MaxLength="7"
                                                 AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Color}"
                                                 AutomationProperties.Name="{Binding Id, StringFormat=Flag colour {0}}" ToolTip="Hex colour, e.g. #F59E0B"/>
                                        <ComboBox Width="62" Margin="6,0,0,0" ItemsSource="{x:Static vm:SettingsViewModel.FlagPresetColors}"
                                                  SelectedItem="{Binding Color, Mode=TwoWay}" ToolTip="Preset colours"
                                                  AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Preset}"
                                                  AutomationProperties.Name="{Binding Id, StringFormat=Flag colour preset {0}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="36" Height="12" CornerRadius="3" ToolTip="{Binding}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding Mode=OneWay}"/>
                                                        </Border.Background>
                                                    </Border>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="&#x2191;" Margin="6,0,0,0" MinWidth="28" ToolTip="Move up"
                                                Command="{Binding DataContext.MoveFlagUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Up}" AutomationProperties.Name="Move flag up"/>
                                        <Button Content="&#x2193;" Margin="2,0,0,0" MinWidth="28" ToolTip="Move down"
                                                Command="{Binding DataContext.MoveFlagDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Down}" AutomationProperties.Name="Move flag down"/>
                                        <Button Content="Remove" Margin="6,0,0,0" ToolTip="Remove this flag (at least one stays)"
                                                Command="{Binding DataContext.RemoveFlagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.Flag.{0}.Remove}" AutomationProperties.Name="Remove flag"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add flag" Margin="0,0,6,0" Command="{Binding DataContext.AddFlagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="Settings.Flag.Add"/>
                            <Button Content="Reset to defaults" Command="{Binding DataContext.ResetFlagsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Restore Informational, Interesting, Suspicious, Malicious and Benign / Ruled out (custom flags are removed from the list; rows keep their flag id)"
                                    AutomationProperties.AutomationId="Settings.Flag.Reset"/>
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CardIngest" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Style="{StaticResource SectionTitle}" Text="Ingest selection"/></StackPanel>
                    <StackPanel Margin="0,8,0,0" x:Name="IngestSelectionsSection" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Named sets of planned jobs for the Custom selection menu on the Ingest page. Pick a selection to see and change its jobs. Changes are saved immediately."/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <ListBox ItemsSource="{Binding SelectionRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MaxHeight="260"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="Settings.IngestSelection.List" AutomationProperties.Name="Ingest selections">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IngestSelectionRow}">
                                            <DockPanel Margin="2,3" LastChildFill="True"
                                                       AutomationProperties.AutomationId="{Binding Name, StringFormat=Settings.IngestSelection.{0}.Row}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="10,0,2,0" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Brush.Control}"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" ToolTip="Built in: can be edited but not renamed or deleted">
                                                        <TextBlock Text="Default" Style="{StaticResource Caption}" FontSize="{DynamicResource FontSize.Small}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="New" MinWidth="56" Margin="0,0,6,0" Padding="10,3" Command="{Binding NewSelectionCommand}"
                                            AutomationProperties.AutomationId="Settings.IngestSelection.New"/>
                                    <Button Content="Rename" MinWidth="56" Margin="0,0,6,0" Padding="10,3" Command="{Binding RenameSelectionCommand}"
                                            AutomationProperties.AutomationId="Settings.IngestSelection.Rename"/>
                                    <Button Content="Delete" MinWidth="56" Padding="10,3" Command="{Binding DeleteSelectionCommand}"
                                            AutomationProperties.AutomationId="Settings.IngestSelection.Delete"/>
                                </WrapPanel>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsEditingSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Name" FontWeight="SemiBold"/>
                                    <TextBox Margin="0,4,0,0" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="Settings.IngestSelection.Name" AutomationProperties.Name="Selection name"/>
                                    <TextBlock Text="{Binding EditorError}" Foreground="{DynamicResource Brush.Error}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding EditorError, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Settings.IngestSelection.Error"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Save" Style="{StaticResource AccentButton}" MinWidth="64" Margin="0,0,6,0" Command="{Binding SaveSelectionCommand}"
                                                AutomationProperties.AutomationId="Settings.IngestSelection.Save"/>
                                        <Button Content="Cancel" MinWidth="64" Command="{Binding CancelSelectionCommand}"
                                                AutomationProperties.AutomationId="Settings.IngestSelection.Cancel"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border}" Padding="14,0,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Reset to built-in" Padding="10,3" Command="{Binding ResetSelectionToBuiltInCommand}"
                                                Visibility="{Binding IsDefaultSelected, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Put the SANS fast-forensics set back" AutomationProperties.AutomationId="Settings.IngestSelection.Reset"/>
                                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="Jobs in "/><Run Text="{Binding SelectedRow.Name, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding EditorGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:IngestRuleGroup}">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                                                        <ItemsControl ItemsSource="{Binding Rules}" Margin="8,2,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:IngestRuleCheck}">
                                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2"
                                                                              AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.IngestSelection.Rule.{0}}"
                                                                              AutomationProperties.Name="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CardAi" Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="AI"/>
                            <c:HelpTip Text="Model for Spectre, the investigation assistant. Local (Ollama) needs no key. Cloud keys are encrypted for your Windows account and never shown again. Provider and model apply after Save. Auto-mode lets Spectre apply its filter, flag, sort and open-file suggestions without asking; each one can be undone from the chat." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.Ai"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" Text="Provider"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,10,0,0" Width="220" HorizontalAlignment="Left"
                                      ItemsSource="{x:Static vm:AiSettingsViewModel.Providers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding Edit.AiProvider}" AutomationProperties.AutomationId="Settings.Ai.Provider"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" Text="Model"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" IsEditable="True"
                                      ItemsSource="{Binding Ai.Models}" Text="{Binding Edit.AiModel, UpdateSourceTrigger=LostFocus}"
                                      AutomationProperties.AutomationId="Settings.Ai.Model"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Refresh" Margin="6,10,0,0" Command="{Binding Ai.RefreshModelsCommand}"
                                    AutomationProperties.AutomationId="Settings.Ai.Refresh"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Visibility="{Binding Ai.ShowBaseUrl, Converter={StaticResource BoolToVis}}" Text="Base URL"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Ai.ShowBaseUrl, Converter={StaticResource BoolToVis}}">
                                <TextBox Width="320" Text="{Binding Edit.AiBaseUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="Settings.Ai.BaseUrl"/>
                                <c:HelpTip Text="Address of the server, e.g. http://localhost:1234/v1/ for LM Studio. Needed for Other (OpenAI-compatible); for Local and OpenAI leave it empty to use the default. The API key is optional for Other." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.AiBaseUrl"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Ai.NeedsKey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="API key" Width="150" Margin="0"/>
                                <PasswordBox x:Name="AiKeyBox" Width="220" AutomationProperties.AutomationId="Settings.Ai.Key"/>
                                <Button Content="Save key" Margin="6,0,0,0" Click="AiSaveKey_Click" AutomationProperties.AutomationId="Settings.Ai.SaveKey"/>
                                <Button Content="Clear" Margin="6,0,0,0" Command="{Binding Ai.ClearKeyCommand}" AutomationProperties.AutomationId="Settings.Ai.ClearKey"/>
                                <TextBlock Text="{Binding Ai.KeyStatus}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                           AutomationProperties.AutomationId="Settings.Ai.KeyStatus"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Test" MinWidth="80" Command="{Binding Ai.TestCommand}" AutomationProperties.AutomationId="Settings.Ai.Test"/>
                                <Button Content="Use local AI" Margin="8,0,0,0" Command="{Binding Ai.UseLocalAiCommand}" AutomationProperties.AutomationId="Settings.Ai.SetUpLocal" ToolTip="Uses Ollama if it is installed and downloads the model that suits this PC for Spectre. Nothing is installed."/>
                                <Button Content="Check again" Margin="6,0,0,0" Command="{Binding Ai.UseLocalAiCommand}" Visibility="{Binding Ai.LocalAi.OllamaMissing, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Settings.Ai.CheckAgain"/>
                                <Button Content="Cancel" Margin="6,0,0,0" Command="{Binding Ai.LocalAi.CancelCommand}" Visibility="{Binding Ai.LocalAi.IsRunning, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Settings.Ai.Cancel"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Ai.Status}" AutomationProperties.AutomationId="Settings.Ai.Status"/>
                                <Button Content="Get Ollama (ollama.com)" Margin="8,0,0,0" Style="{StaticResource LinkButton}" Command="{Binding Ai.LocalAi.OpenDownloadCommand}" Visibility="{Binding Ai.LocalAi.OllamaMissing, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Settings.Ai.GetOllama"/>
                                <Button Content="Open log" Margin="8,0,0,0" Style="{StaticResource LinkButton}" Command="{Binding Ai.LocalAi.OpenLogCommand}" Visibility="{Binding Ai.LocalAi.ShowOpenLog, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Settings.Ai.OpenLog"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding Ai.CanTuneOllama, Converter={StaticResource BoolToVis}}">
                                <Button Content="Speed up Ollama" Command="{Binding Ai.TuneOllamaCommand}" AutomationProperties.AutomationId="Settings.Ai.TuneOllama"/>
                                <c:HelpTip Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.TuneOllama"
                                           Text="Turns on Ollama's flash attention and a smaller memory cache (OLLAMA_FLASH_ATTENTION=1, OLLAMA_KV_CACHE_TYPE=q8_0) for your Windows user. On an 8 GB GPU this keeps Spectre's model fully on the GPU, about 2.5x faster. Restart Ollama afterwards."/>
                            </StackPanel>

                            <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" IsChecked="{Binding Edit.AssistantAutoMode}"
                                      Content="Auto-mode: let Spectre apply filters, flags and open files without asking"
                                      ToolTip="Spectre applies its filter, flag, sort and open-file suggestions at once and shows an Undo button. Off = it asks first. Changes apply after Save."
                                      AutomationProperties.AutomationId="Settings.Ai.AutoMode" AutomationProperties.Name="Auto-mode"/>

                            <CheckBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" IsChecked="{Binding Edit.RunSpectreAfterIngest}"
                                      Content="Run Spectre after Ingest"
                                      ToolTip="When an Ingest run finishes (not after Stop), the Spectre analysis is queued (its progress shows on Review): it hands the case to the Spectre engine and runs the analysis, so the Review page is ready. Needs the Spectre engine (Tools). Applies after Save."
                                      AutomationProperties.AutomationId="Settings.Ai.RunSpectreAfterIngest" AutomationProperties.Name="Run Spectre after Ingest"/>

                            <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Open prompt files" Command="{Binding Ai.OpenPromptFilesCommand}" AutomationProperties.AutomationId="Settings.Ai.OpenPrompts"
                                        ToolTip="Opens the folder where you can override what Spectre is told (copy a file from the prompts folder next to the exe and edit it)."/>
                                <Button Content="Save last request" Margin="6,0,0,0" Command="{Binding Ai.SaveLastRequestCommand}" AutomationProperties.AutomationId="Settings.Ai.SaveRequest"
                                        ToolTip="Saves exactly what Spectre last sent to the model (system prompt, tools, messages) and opens it. The API key is not included."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="CardHotKeys" Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="18,4,18,18" Margin="0,0,14,14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Hot Keys"/>
                            <c:HelpTip Text="Keyboard shortcuts for the Analyze table and Actions menu. Click a key box, then press the combination you want (Esc cancels). A combination already used by another action is refused until you clear or change that one. Changes apply after Save, without a restart." Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Help.HotKeys"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <!-- shared size scope: the name column is as wide as the longest action name in every group, so the key boxes line up and stay close -->
                            <ItemsControl ItemsSource="{Binding HotKeyGroups}" Grid.IsSharedSizeScope="True" AutomationProperties.AutomationId="Settings.HotKeys.List">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HotKeyGroup}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="16,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HotKeyEditItem}">
                                                        <StackPanel Margin="0,2">
                                                            <Grid HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="HotKeyName"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                                <Button Grid.Column="1" Content="{Binding KeyBoxText}" Click="HotKeyBox_Click" PreviewKeyDown="HotKeyBox_PreviewKeyDown"
                                                                        LostKeyboardFocus="HotKeyBox_LostKeyboardFocus" HorizontalContentAlignment="Left" Padding="10,3" FontFamily="{DynamicResource Font.Mono}"
                                                                        ToolTip="Click, then press the new key combination (Esc cancels)"
                                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.HotKeys.{0}.Key}"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat=Shortcut for {0}}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0" Padding="10,3" ToolTip="Leave this action without a shortcut"
                                                                        Command="{Binding DataContext.ClearHotKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.HotKeys.{0}.Clear}" AutomationProperties.Name="Clear shortcut"/>
                                                                <Button Grid.Column="3" Content="Reset" Margin="6,0,0,0" Padding="10,3" ToolTip="{Binding DefaultText, StringFormat=Restore the default ({0})}"
                                                                        Command="{Binding DataContext.ResetHotKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.HotKeys.{0}.Reset}" AutomationProperties.Name="Reset shortcut"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                                                                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Settings.HotKeys.{0}.Warning}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Reset all to defaults" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3" Command="{Binding ResetAllHotKeysCommand}"
                                    AutomationProperties.AutomationId="Settings.HotKeys.ResetAll"/>
                            <TextBlock Text="FIXED (not editable)" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,14,0,2"/>
                            <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.FixedHotKeys}" Margin="16,0,0,0" AutomationProperties.AutomationId="Settings.HotKeys.Fixed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Caption}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
