<Window x:Class="EzForensics.App.Views.EvtxCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize event selection" Width="880" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource FontSize.Body}" TextOptions.TextFormattingMode="{DynamicResource Ui.TextFormatting}"
        AutomationProperties.AutomationId="EvtxCustomize" KeyDown="Window_KeyDown">
    <DockPanel Margin="16">
        <!-- footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" AutomationProperties.AutomationId="EvtxCustomize.Cancel"/>
                <Button Content="OK" MinWidth="80" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True" AutomationProperties.AutomationId="EvtxCustomize.Ok"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
        </DockPanel>

        <!-- toolbar: search, select all/none, scan -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                <Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,6,0"/>
                <Button Content="Recommended" Command="{Binding ResetRecommendedCommand}" Margin="0,0,6,0" ToolTip="Back to the recommended selection"/>
                <Button Content="Scan evidence…" Command="{Binding ScanEvidenceCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}"
                        ToolTip="Find the channels and event IDs in a folder of .evtx files and list the ones missing here" AutomationProperties.AutomationId="EvtxCustomize.Scan"/>
            </StackPanel>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search events (ID, channel, title, field)…" Margin="0,0,10,0"
                     AutomationProperties.AutomationId="EvtxCustomize.Search"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasScanStatus, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Content="Cancel scan" Command="{Binding CancelScanCommand}" Margin="8,0,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="90" Height="6" Margin="8,0,0,0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsThreeState="True" IsChecked="{Binding AllSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                                  ToolTip="Select all / none in this group"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Events}" Margin="26,2,0,6" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EventId}" FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold" Margin="0,1,6,0"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        <Run Text="{Binding Channel, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Fields, Mode=OneWay, StringFormat='Fields: {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,1,0,0">
                                                    <TextBlock Text="{Binding CountText, Mode=OneWay}" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="map unverified" Style="{StaticResource Caption}" Visibility="{Binding Unverified, Converter={StaticResource BoolToVis}}"
                                                               ToolTip="No EZ map was checked for this event: it may be parsed without named fields."/>
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.InfoBg}"
                                                            TextElement.Foreground="{DynamicResource Brush.Info}"
                                                            Visibility="{Binding HasCustomMap, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="EvtxECmd uses your custom map for this event instead of the stock map">
                                                        <TextBlock Text="custom map" FontSize="{DynamicResource FontSize.Small}"/>
                                                    </Border>
                                                    <Button Content="Reset to stock" Command="{Binding ResetMapCommand}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                                            Visibility="{Binding HasCustomMap, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Delete your custom map: EvtxECmd uses the stock map again" AutomationProperties.AutomationId="EvtxCustomize.ResetMap"/>
                                                    <Button Content="Edit fields…" Command="{Binding EditFieldsCommand}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                                            ToolTip="Change which fields EvtxECmd extracts for this event, tried on sample records from the evidence"
                                                            AutomationProperties.AutomationId="EvtxCustomize.EditFields"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
