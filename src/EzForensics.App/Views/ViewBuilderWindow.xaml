<Window x:Class="EzForensics.App.Views.ViewBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
        Title="View builder" Width="820" Height="580" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource FontSize.Body}" TextOptions.TextFormattingMode="{DynamicResource Ui.TextFormatting}"
        AutomationProperties.AutomationId="ViewBuilder" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Builder-tab-only footer buttons: hidden on the Saved tab -->
        <Style x:Key="BuilderTabBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Saved-tab-only footer pieces (Import / Export) -->
        <Style x:Key="SavedTabOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- OK reads "Close" on the Saved tab -->
        <Style x:Key="OkButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Content" Value="Close"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="IconMini" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16" LayoutTransform="{DynamicResource Ui.Scale}">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Margin="0">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.AutomationId="ViewBuilder.Summary"/>
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ViewBuilder.Notice"/>
            </StackPanel>
            <!-- buttons share the syntax box's left and right edges -->
            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0" Style="{StaticResource SavedTabOnly}">
                    <Button Content="Import…" Click="Import_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="ViewBuilder.Saved.Import"
                            ToolTip="Imports saved views from a .ezviews.json file"/>
                    <Button Content="Export…" Click="Export_Click" AutomationProperties.AutomationId="ViewBuilder.Saved.Export"
                            ToolTip="Exports saved views to a .ezviews.json file"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Save" Click="Save_Click" IsEnabled="{Binding CanSave}" Margin="0,0,6,0" AutomationProperties.AutomationId="ViewBuilder.Save"
                            ToolTip="Saves the column layout (and grouping, if any) to this CSV layout's category (window stays open)"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Save as…" Click="SaveAs_Click" IsEnabled="{Binding CanSave}" Margin="0,0,16,0" AutomationProperties.AutomationId="ViewBuilder.SaveAs"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Apply" Click="Apply_Click" IsEnabled="{Binding CanApply}" ToolTip="{Binding ApplyTip}"
                            Margin="0,0,6,0" MinWidth="80" AutomationProperties.AutomationId="ViewBuilder.Apply"/>
                    <Button Content="OK" Style="{StaticResource OkButton}" IsDefault="True" MinWidth="80" Click="Ok_Click" IsEnabled="{Binding CanOk}" ToolTip="{Binding OkTip}"
                            Margin="0,0,6,0" AutomationProperties.AutomationId="ViewBuilder.Ok"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Cancel" Click="Cancel_Click" MinWidth="80" AutomationProperties.AutomationId="ViewBuilder.Cancel"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" AutomationProperties.AutomationId="ViewBuilder.Tabs">
            <TabItem Header="Builder" AutomationProperties.AutomationId="ViewBuilder.Tab.Builder">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{Binding SavedName, StringFormat=Saved view: {0}}"
                               Visibility="{Binding HasSavedName, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ViewBuilder.SavedName"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Columns (checked = shown, top to bottom = left to right)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ListBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                         AutomationProperties.AutomationId="ViewBuilder.Columns">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ViewColumnItem}">
                                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Content="{Binding Name}" Margin="2,2"
                                                      AutomationProperties.AutomationId="{Binding Name, StringFormat=ViewBuilder.Column.{0}}"
                                                      AutomationProperties.Name="{Binding Name}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>

                        <StackPanel Grid.Column="1" Margin="8,22,12,0">
                            <Button Style="{StaticResource Mini}" Content="&#xE74A;" FontFamily="{StaticResource Font.Icon}" Command="{Binding MoveUpCommand}" ToolTip="Move up"
                                    AutomationProperties.AutomationId="ViewBuilder.MoveUp" AutomationProperties.Name="Move up"/>
                            <Button Style="{StaticResource Mini}" Content="&#xE74B;" FontFamily="{StaticResource Font.Icon}" Command="{Binding MoveDownCommand}" ToolTip="Move down"
                                    AutomationProperties.AutomationId="ViewBuilder.MoveDown" AutomationProperties.Name="Move down"/>
                            <Button Style="{StaticResource Mini}" Content="Show all" Command="{Binding ShowAllCommand}" Margin="0,12,0,6" AutomationProperties.AutomationId="ViewBuilder.ShowAll"/>
                            <Button Style="{StaticResource Mini}" Content="Hide all" Command="{Binding HideAllCommand}" AutomationProperties.AutomationId="ViewBuilder.HideAll"
                                    ToolTip="Hides all but the selected column"/>
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Pivot (group by, outermost first)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddGroupCommand}" Margin="6,0,0,0" MinHeight="26"
                                        AutomationProperties.AutomationId="ViewBuilder.Group.Add"/>
                                <ComboBox ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroupChoice, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ViewBuilder.Group.Choice" AutomationProperties.Name="Group column"/>
                            </DockPanel>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.AutomationId="ViewBuilder.Groups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ViewGroupItem}">
                                            <DockPanel Margin="2,2">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconMini}" Content="&#xE711;" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="{Binding Column, StringFormat=ViewBuilder.Group.{0}.Remove}" AutomationProperties.Name="Remove"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconMini}" Content="{Binding SortGlyph}" FontFamily="{DynamicResource Font.UI}" MinWidth="40"
                                                        ToolTip="Group order (click to change)"
                                                        Command="{Binding DataContext.CycleGroupSortCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="{Binding Column, StringFormat=ViewBuilder.Group.{0}.Sort}" AutomationProperties.Name="Sort"/>
                                                <TextBlock Text="{Binding Column}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Saved views" AutomationProperties.AutomationId="ViewBuilder.Tab.Saved">
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="No saved views yet. Arrange the columns and use Save." Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSavedGroups, Converter={StaticResource BoolToVisInv}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SavedGroups}" Focusable="False" AutomationProperties.AutomationId="ViewBuilder.Saved.List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedViewCategoryViewModel}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                              AutomationProperties.AutomationId="ViewBuilder.Saved.Category" AutomationProperties.Name="{Binding Header}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource IconMini}" Content="&#xE70F;" Margin="6,0,0,0" Click="RenameCategory_Click" ToolTip="Rename category"
                                                        AutomationProperties.AutomationId="ViewBuilder.Saved.RenameCategory" AutomationProperties.Name="Rename category"/>
                                                <Button Style="{StaticResource IconMini}" Content="&#xE74D;" Click="DeleteCategory_Click" ToolTip="Delete category"
                                                        AutomationProperties.AutomationId="ViewBuilder.Saved.DeleteCategory" AutomationProperties.Name="Delete category"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SavedViewItemViewModel}">
                                                    <Border Padding="6,4" Margin="0,1" Background="Transparent" MouseLeftButtonDown="SavedRow_MouseDown" ToolTip="{Binding RowTooltip}"
                                                            AutomationProperties.AutomationId="ViewBuilder.Saved.Row" AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                            <Button Style="{StaticResource IconMini}" Content="&#xE70F;" Margin="6,0,0,0" Click="RenameSaved_Click" ToolTip="Rename"
                                                                    AutomationProperties.AutomationId="ViewBuilder.Saved.Rename" AutomationProperties.Name="Rename"/>
                                                            <Button Style="{StaticResource IconMini}" Content="&#xE74D;" Click="DeleteSaved_Click" ToolTip="Delete"
                                                                    AutomationProperties.AutomationId="ViewBuilder.Saved.Delete" AutomationProperties.Name="Delete"/>
                                                            <Button Style="{StaticResource IconMini}" Content="&#xE8A7;" Margin="8,0,0,0" Click="EditSaved_Click"
                                                                    IsEnabled="{Binding CanLoad}" ToolTip="{Binding EditTooltip}"
                                                                    AutomationProperties.AutomationId="ViewBuilder.Saved.Edit" AutomationProperties.Name="Edit in builder"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
