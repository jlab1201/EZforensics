<UserControl x:Class="EzForensics.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
             xmlns:c="clr-namespace:EzForensics.App.Controls"
             xmlns:local="clr-namespace:EzForensics.App"
             xmlns:svc="clr-namespace:EzForensics.App.Services"
             xmlns:an="clr-namespace:EzForensics.App.Views.Analyze">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <c:PageHeader Title="{x:Static svc:PageNames.Analyze}"/>
            <ContentControl Content="{Binding Banner}" ContentTemplate="{StaticResource InfoBarTemplate}"
                            Visibility="{Binding Banner, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0"/>
            <!-- the records behind a Spectre finding are showing: say so, and the ways on -->
            <Border Visibility="{Binding HasEvidenceBanner, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}" AutomationProperties.AutomationId="Results.EvidenceBanner">
                <WrapPanel>
                    <TextBlock Text="{Binding EvidenceBannerText}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" AutomationProperties.AutomationId="Results.EvidenceBanner.Text"/>
                    <Button Content="Show all rows" Command="{Binding ShowAllEvidenceRowsCommand}" Style="{DynamicResource SubtleButton}" Margin="0,0,8,0"
                            ToolTip="Take the filter off. The evidence rows stay flagged." AutomationProperties.AutomationId="Results.EvidenceBanner.ShowAll"/>
                    <Button Content="Back to Review" Command="{Binding BackToFindingsCommand}" Style="{DynamicResource SubtleButton}" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Results.EvidenceBanner.Back"/>
                    <ItemsControl ItemsSource="{Binding EvidenceOtherFiles}" Visibility="{Binding HasEvidenceOtherFiles, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name, StringFormat='Also in {0}'}" Margin="0,0,8,0" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding DataContext.OpenEvidenceFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Border>
        </StackPanel>


        <Grid x:Name="PageBody" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="860" MinWidth="180"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="12"/>
                <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- left card: case folder, computer details, case files tree. Collapse LeftCard + PaneSplitter (and zero LeftColumn/SplitterColumn) for a focus mode. -->
            <Border x:Name="LeftCard" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <an:CaseTreePanel x:Name="CaseTree"/>
                    <an:KeyEventsPanel x:Name="KeyEvents" Grid.Row="1"/>
                </Grid>
            </Border>
            <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Center"/>

            <!-- right pane: process tree of a host on top (ResultsViewModel.ProcessTree, Close x releases it), events grid below; the top row and the splitter collapse while no tree is open -->
            <Grid x:Name="RightPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TreeRow" Height="0"/>
                    <RowDefinition x:Name="TreeSplitterRow" Height="0"/>
                    <RowDefinition x:Name="EventsRow" Height="*"/>
                </Grid.RowDefinitions>
                <an:ProcessTreePane x:Name="ProcessTreeView" Grid.Row="0" DataContext="{Binding ProcessTree}"
                                    Visibility="{Binding DataContext.IsProcessTreeOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <GridSplitter x:Name="TreeSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"
                              AutomationProperties.AutomationId="Results.ProcessTree.Splitter" AutomationProperties.Name="Resize the process tree"/>
                <an:EventsPane x:Name="Events" Grid.Row="2"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
