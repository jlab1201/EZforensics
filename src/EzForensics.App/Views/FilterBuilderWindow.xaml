<Window x:Class="EzForensics.App.Views.FilterBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:EzForensics.App.Controls"
        xmlns:vm="clr-namespace:EzForensics.App.ViewModels"
        xmlns:hl="clr-namespace:EzForensics.App.Views.Controls"
        Title="Filter builder" Width="860" Height="560" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource FontSize.Body}" TextOptions.TextFormattingMode="{DynamicResource Ui.TextFormatting}"
        AutomationProperties.AutomationId="FilterBuilder" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Builder-tab-only footer buttons: hidden on the Saved tab -->
        <Style x:Key="BuilderTabBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Saved-tab-only footer pieces (Import / Export) -->
        <Style x:Key="SavedTabOnly" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- OK reads "Close" on the Saved tab -->
        <Style x:Key="OkButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Content" Value="Close"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColumnCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Filter.Column}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource Filter.Column}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OperatorCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Filter.Function}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource Filter.Function}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JoinChip" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Filter.Logical}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Filter.Logical}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource Filter.Logical}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Filter.Not}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Filter.String}"/>
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Filter.String}"/>
        </Style>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Filter.Logical}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Depth}" Value="1">
                    <Setter Property="BorderBrush" Value="{DynamicResource Filter.Column}"/>
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="2">
                    <Setter Property="BorderBrush" Value="{DynamicResource Filter.Function}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="3">
                    <Setter Property="BorderBrush" Value="{DynamicResource Filter.Number}"/>
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="4">
                    <Setter Property="BorderBrush" Value="{DynamicResource Filter.String}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:BuilderGroupViewModel}">
            <Border Style="{StaticResource GroupBorder}" Padding="8,4,0,4" Margin="0,3">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource NotToggle}" Content="Not" IsChecked="{Binding Negate}" Margin="0,0,10,0" AutomationProperties.AutomationId="FilterBuilder.Group.Not"/>
                        <ComboBox Style="{StaticResource JoinChip}" SelectedIndex="{Binding JoinIndex}" Width="150" AutomationProperties.AutomationId="FilterBuilder.Group.Join">
                            <ComboBoxItem Content="And (all of)"/>
                            <ComboBoxItem Content="Or (any of)"/>
                        </ComboBox>
                        <Button Style="{StaticResource Mini}" Content="+ Condition" Command="{Binding AddConditionCommand}" AutomationProperties.AutomationId="FilterBuilder.Group.AddCondition"/>
                        <Button Style="{StaticResource Mini}" Content="+ Group" Command="{Binding AddGroupCommand}" AutomationProperties.AutomationId="FilterBuilder.Group.AddGroup"/>
                        <Button Style="{StaticResource Mini}" Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="11" ToolTip="Remove group"
                                Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Remove group"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="18,4,0,0" Focusable="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BuilderConditionViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <ComboBox Style="{StaticResource ColumnCombo}" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          ItemsSource="{Binding ColumnChoices}" Text="{Binding ColumnText, Mode=OneWay}" Width="200"
                          AutomationProperties.AutomationId="FilterBuilder.Condition.Column" AutomationProperties.Name="Field"
                          ToolTip="Type to search the fields; Enter picks, Esc cancels"
                          TextBoxBase.TextChanged="Field_TextChanged" PreviewKeyDown="Field_PreviewKeyDown"
                          DropDownOpened="Field_DropDownOpened" DropDownClosed="Field_DropDownClosed" LostKeyboardFocus="Field_LostKeyboardFocus"
                          GotKeyboardFocus="Field_GotKeyboardFocus"/>
                <ComboBox Style="{StaticResource OperatorCombo}" ItemsSource="{Binding AvailableOps}" SelectedItem="{Binding Op}" Width="150" Margin="6,0,0,0" AutomationProperties.AutomationId="FilterBuilder.Condition.Op"/>
                <TextBox Style="{StaticResource ValueBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="6,0,0,0" Tag="value"
                         IsEnabled="{Binding NeedsValue}" Visibility="{Binding ShowTextValue, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="FilterBuilder.Condition.Value"/>
                <ComboBox Style="{StaticResource ValueCombo}" ItemsSource="{Binding Root.FlagChoices}" SelectedValuePath="Id" DisplayMemberPath="Label"
                          SelectedValue="{Binding Value}" Width="220" Margin="6,0,0,0" Visibility="{Binding ShowFlagValue, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.AutomationId="FilterBuilder.Condition.FlagValue" AutomationProperties.Name="Flag"/>
                <TextBox Style="{StaticResource ValueBox}" Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="6,0,0,0" Tag="and"
                         Visibility="{Binding IsBetween, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource Mini}" Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="11" ToolTip="Remove condition"
                        Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove condition"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BuilderFixedViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock hl:FilterHighlighter.Text="{Binding Text}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}" VerticalAlignment="Center"
                           MaxWidth="600" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                <Button Style="{StaticResource Mini}" Content="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="11" ToolTip="Remove"
                        Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16" LayoutTransform="{DynamicResource Ui.Scale}">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Margin="0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconMini}" Content="&#xE8C8;" Margin="6,0,0,0" VerticalAlignment="Top" Click="CopySyntax_Click"
                                ToolTip="Copy syntax" AutomationProperties.AutomationId="FilterBuilder.Syntax.Copy" AutomationProperties.Name="Copy syntax"/>
                        <!-- syntax colouring: the box's own text is transparent (caret and selection stay); the coloured copy is drawn over it, aligned in code-behind -->
                        <Grid>
                            <TextBox x:Name="SyntaxBox" CaretBrush="{DynamicResource Brush.Text}" Text="{Binding SyntaxText, Mode=OneWay}" MinHeight="44" MaxHeight="120" Padding="8,6"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="False" SpellCheck.IsEnabled="False"
                                     TextChanged="SyntaxBox_TextChanged" LostKeyboardFocus="SyntaxBox_LostKeyboardFocus"
                                     AutomationProperties.AutomationId="FilterBuilder.Syntax" AutomationProperties.Name="Filter syntax"
                                     ToolTip="Filter syntax. Edit or paste it here and the builder above follows.">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
                                        <Setter Property="IsReadOnly" Value="False"/>
                                        <Setter Property="Foreground" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSyntaxError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Border x:Name="SyntaxOverlayHost" IsHitTestVisible="False" Background="Transparent" ClipToBounds="True">
                                <TextBlock x:Name="SyntaxOverlay" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontFamily="{Binding FontFamily, ElementName=SyntaxBox}" FontSize="{Binding FontSize, ElementName=SyntaxBox}"
                                           Foreground="{DynamicResource Brush.Text}"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{Binding SyntaxErrorText}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasSyntaxError, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="FilterBuilder.Syntax.Error"/>
                </StackPanel>
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="FilterBuilder.Notice"/>
            </StackPanel>
            <!-- buttons share the syntax box's left and right edges -->
            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0" Style="{StaticResource SavedTabOnly}">
                    <Button Content="Import…" Click="Import_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="FilterBuilder.Saved.Import"
                            ToolTip="Imports saved filters from a .ezfilters.json file"/>
                    <Button Content="Export…" Click="Export_Click" AutomationProperties.AutomationId="FilterBuilder.Saved.Export"
                            ToolTip="Exports saved filters to a .ezfilters.json file"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Save" Click="Save_Click" IsEnabled="{Binding CanSave}" Margin="0,0,6,0" AutomationProperties.AutomationId="FilterBuilder.Save"
                            ToolTip="Saves the builder content and search text to this CSV layout's category (window stays open)"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Save as…" Click="SaveAs_Click" IsEnabled="{Binding CanSave}" Margin="0,0,16,0" AutomationProperties.AutomationId="FilterBuilder.SaveAs"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Apply" Click="Apply_Click" IsEnabled="{Binding CanApply}" ToolTip="{Binding ApplyTip}"
                            Margin="0,0,6,0" MinWidth="80" AutomationProperties.AutomationId="FilterBuilder.Apply"/>
                    <Button Content="OK" Style="{StaticResource OkButton}" IsDefault="True" MinWidth="80" Click="Ok_Click" IsEnabled="{Binding CanOk}" ToolTip="{Binding OkTip}"
                            Margin="0,0,6,0" AutomationProperties.AutomationId="FilterBuilder.Ok"/>
                    <Button Style="{StaticResource BuilderTabBtn}" Content="Cancel" Click="Cancel_Click" MinWidth="80" AutomationProperties.AutomationId="FilterBuilder.Cancel"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TabControl Style="{StaticResource FlatTabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" AutomationProperties.AutomationId="FilterBuilder.Tabs">
            <TabItem Header="Builder" AutomationProperties.AutomationId="FilterBuilder.Tab.Builder">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{Binding SavedName, StringFormat=Saved filter: {0}}"
                               Visibility="{Binding HasSavedName, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="FilterBuilder.SavedName"/>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ContentControl Content="{Binding RootGroup}" Focusable="False"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Saved filters" AutomationProperties.AutomationId="FilterBuilder.Tab.Saved">
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="No saved filters yet. Build a filter and use Save." Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSavedGroups, Converter={StaticResource BoolToVisInv}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SavedGroups}" Focusable="False" AutomationProperties.AutomationId="FilterBuilder.Saved.List">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedCategoryViewModel}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                              AutomationProperties.AutomationId="FilterBuilder.Saved.Category" AutomationProperties.Name="{Binding Header}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource IconMini}" Content="&#xE70F;" Margin="6,0,0,0" Click="RenameCategory_Click" ToolTip="Rename category"
                                                        AutomationProperties.AutomationId="FilterBuilder.Saved.RenameCategory" AutomationProperties.Name="Rename category"/>
                                                <Button Style="{StaticResource IconMini}" Content="&#xE74D;" Click="DeleteCategory_Click" ToolTip="Delete category"
                                                        AutomationProperties.AutomationId="FilterBuilder.Saved.DeleteCategory" AutomationProperties.Name="Delete category"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SavedFilterItemViewModel}">
                                                    <Border Padding="6,4" Margin="0,1" Background="Transparent" MouseLeftButtonDown="SavedRow_MouseDown" ToolTip="{Binding RowTooltip}"
                                                            AutomationProperties.AutomationId="FilterBuilder.Saved.Row" AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                                <Button Style="{StaticResource IconMini}" Content="&#xE70F;" Margin="6,0,0,0" Click="RenameSaved_Click" ToolTip="Rename"
                                                                        AutomationProperties.AutomationId="FilterBuilder.Saved.Rename" AutomationProperties.Name="Rename"/>
                                                                <Button Style="{StaticResource IconMini}" Content="&#xE74D;" Click="DeleteSaved_Click" ToolTip="Delete"
                                                                        AutomationProperties.AutomationId="FilterBuilder.Saved.Delete" AutomationProperties.Name="Delete"/>
                                                            </StackPanel>
                                                            <Grid Margin="0,2,0,0" HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" hl:FilterHighlighter.Text="{Binding Preview}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Mono}"
                                                                           TextTrimming="CharacterEllipsis" Opacity="0.75" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Style="{StaticResource IconMini}" Content="&#xE70F;" Margin="6,0,0,0" Click="EditSaved_Click"
                                                                        IsEnabled="{Binding CanLoad}" ToolTip="{Binding EditTooltip}"
                                                                        AutomationProperties.AutomationId="FilterBuilder.Saved.Edit" AutomationProperties.Name="Edit in builder"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
