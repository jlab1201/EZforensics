<UserControl x:Class="EzForensics.App.Views.Jobs.JobDetailsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EzForensics.App.Controls">
<UserControl.Resources>
    <Style x:Key="CopyIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="Content" Value="&#xE8C8;"/>
        <Setter Property="ToolTip" Value="Copy"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style>
</UserControl.Resources>
<DockPanel>
    <Expander DockPanel.Dock="Top" Margin="0,0,0,4" IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}"
              Visibility="{Binding CommandText, Converter={StaticResource BoolToVis}}">
        <Expander.Header><TextBlock Text="Command" Style="{StaticResource SectionTitle}" Margin="0"/></Expander.Header>
        <Grid Margin="0,2,0,4">
            <TextBox Style="{StaticResource MonoBox}" MinHeight="0" MaxHeight="110" Padding="4,2,34,2"
                     AutomationProperties.AutomationId="Jobs.Command" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Text="{Binding CommandText, Mode=OneWay}"/>
            <Button Style="{StaticResource CopyIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                    Background="{DynamicResource Brush.Code}"
                    AutomationProperties.AutomationId="Jobs.CopyCommand" AutomationProperties.Name="Copy command"
                    Command="{Binding CopyCommandTextCommand}"/>
        </Grid>
    </Expander>
    <Expander IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
        <Expander.Header><TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0"/></Expander.Header>
        <Grid Margin="0,2,0,0">
            <TextBlock Text="Select a job to see its log" Style="{StaticResource Caption}" Margin="2,4,0,8"
                       AutomationProperties.AutomationId="Jobs.LogPlaceholder"
                       Visibility="{Binding Selected, Converter={StaticResource BoolToVisInv}}"/>
            <c:LogConsole AutomationProperties.AutomationId="Jobs.Log" Buffer="{Binding Log}" MinHeight="100" Padding="4,2,34,2"
                          Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource CopyIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                    Background="{DynamicResource Brush.Code}"
                    AutomationProperties.AutomationId="Jobs.CopyLog" AutomationProperties.Name="Copy log"
                    Command="{Binding CopyLogCommand}"
                    Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Expander>
</DockPanel>
</UserControl>
