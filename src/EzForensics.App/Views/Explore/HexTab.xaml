<UserControl x:Class="EzForensics.App.Views.Explore.HexTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EzForensics.App.Controls"
             xmlns:ex="clr-namespace:EzForensics.App.Views.Explore">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send selection to CyberChef" Click="SendSelection_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="Explore.Hex.SendSelection" AutomationProperties.Name="Send selection to CyberChef"
                    ToolTip="Sends the selected bytes (up to 10 MB) to the CyberChef panel"/>
            <Button DockPanel.Dock="Left" Content="Go" Click="GoTo_Click" Margin="0,0,6,0" AutomationProperties.AutomationId="Explore.Hex.GoTo" AutomationProperties.Name="Go to offset"/>
            <TextBox x:Name="OffsetBox" Style="{DynamicResource ClearableTextBox}" Padding="6,4,26,4" DockPanel.Dock="Left" Width="150" Tag="Go to offset (hex)" Margin="0,0,10,0" KeyDown="OffsetBox_KeyDown"
                     AutomationProperties.AutomationId="Explore.Hex.Offset" AutomationProperties.Name="Go to offset"/>
            <TextBlock x:Name="InfoText" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="Explore.Hex.Info"/>
        </DockPanel>
        <Border x:Name="InspectorBorder" DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,4" CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}" Visibility="Collapsed">
            <ItemsControl x:Name="InspectorList" AutomationProperties.AutomationId="Explore.Hex.Inspector" AutomationProperties.Name="Selection inspector">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1,18,1">
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Value}" FontFamily="{DynamicResource Font.Mono}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                <ex:HexCanvas x:Name="Hex" AutomationProperties.AutomationId="Explore.Hex.View" AutomationProperties.Name="Hex view"/>
            </Border>
            <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical" Scroll="VScroll_Scroll" SmallChange="1" LargeChange="10"
                       AutomationProperties.AutomationId="Explore.Hex.Scroll"/>
            <ctl:EmptyState x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE8A5;" Title="No file selected" Message="Select a file to see its bytes."/>
        </Grid>
    </DockPanel>
</UserControl>
