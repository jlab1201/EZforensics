<UserControl x:Class="EzForensics.App.Views.Explore.OverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:exvm="clr-namespace:EzForensics.App.ViewModels.Explore">
    <UserControl.Resources>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Width" Value="84"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HashValue" TargetType="TextBlock" BasedOn="{StaticResource FactValue}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Mono}"/>
        </Style>
        <Style x:Key="CopyBtn" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Copy"/>
        </Style>
        <Style x:Key="ChipBorder" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bad"><Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bad"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Explore.Overview">
        <StackPanel Margin="0,0,8,8">
            <ProgressBar Maximum="1" Value="{Binding FactsProgress}" Height="3" Margin="0,0,0,6" Visibility="{Binding ViewerBusy, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.AutomationId="Explore.Overview.Progress" AutomationProperties.Name="Reading the file"/>
            <TextBlock Text="{Binding ViewerError}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding ViewerError, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="Explore.Overview.Error"/>
            <TextBlock Text="{Binding FileTitle}" Style="{DynamicResource SectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileTitle}"/>
            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,2" AutomationProperties.AutomationId="Explore.Overview.Chips" AutomationProperties.Name="Verdict chips">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ChipBorder}" AutomationProperties.Name="{Binding Text}">
                            <TextBlock Text="{Binding Text}" Style="{DynamicResource ChipText}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,8,0,0">
                <DockPanel Margin="0,2"><TextBlock Text="Type" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding TypeText}" Style="{DynamicResource FactValue}" AutomationProperties.AutomationId="Explore.Overview.Type"/></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Size" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding SizeText}" Style="{DynamicResource FactValue}" AutomationProperties.AutomationId="Explore.Overview.Size"/></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Modified" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding ModifiedText}" Style="{DynamicResource FactValue}"/></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Accessed" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding AccessedText}" Style="{DynamicResource FactValue}"/></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Created" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding CreatedText}" Style="{DynamicResource FactValue}"/></DockPanel>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <DockPanel Margin="0,2">
                    <TextBlock Text="MD5" Style="{DynamicResource FactLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource CopyBtn}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Md5}"
                            AutomationProperties.AutomationId="Explore.Overview.CopyMd5" AutomationProperties.Name="Copy MD5"/>
                    <TextBlock Text="{Binding Md5}" Style="{DynamicResource HashValue}" AutomationProperties.AutomationId="Explore.Overview.Md5"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="SHA-1" Style="{DynamicResource FactLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource CopyBtn}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Sha1}"
                            AutomationProperties.AutomationId="Explore.Overview.CopySha1" AutomationProperties.Name="Copy SHA-1"/>
                    <TextBlock Text="{Binding Sha1}" Style="{DynamicResource HashValue}" AutomationProperties.AutomationId="Explore.Overview.Sha1"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="SHA-256" Style="{DynamicResource FactLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource CopyBtn}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Sha256}"
                            AutomationProperties.AutomationId="Explore.Overview.CopySha256" AutomationProperties.Name="Copy SHA-256"/>
                    <TextBlock Text="{Binding Sha256}" Style="{DynamicResource HashValue}" AutomationProperties.AutomationId="Explore.Overview.Sha256"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <DockPanel Margin="0,2">
                    <TextBlock Text="Entropy" Style="{DynamicResource FactLabel}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding EntropyText}" Style="{DynamicResource FactValue}" Margin="10,0,0,0" AutomationProperties.AutomationId="Explore.Overview.Entropy"/>
                    <ProgressBar Maximum="1" Value="{Binding EntropyFraction}" Height="6" VerticalAlignment="Center" MaxWidth="260" HorizontalAlignment="Left" Width="200"
                                 AutomationProperties.AutomationId="Explore.Overview.EntropyBar" AutomationProperties.Name="Entropy"/>
                </DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Signer" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding SignerText}" Style="{DynamicResource FactValue}" AutomationProperties.AutomationId="Explore.Overview.Signer"/></DockPanel>
                <DockPanel Margin="0,2"><TextBlock Text="Detect It Easy" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding DieText}" Style="{DynamicResource FactValue}" AutomationProperties.AutomationId="Explore.Overview.Die"/></DockPanel>
                <StackPanel Visibility="{Binding DieNote, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="84,2,0,0">
                    <TextBlock Text="{Binding DieNote}" Style="{DynamicResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="Explore.Overview.DieNote"/>
                    <Button Content="Install in Tools" Style="{DynamicResource LinkButton}" Command="{Binding OpenToolsCommand}" Margin="8,0,0,0"
                            Visibility="{Binding DieInstalled, Converter={StaticResource BoolToVisInv}}" AutomationProperties.AutomationId="Explore.Overview.InstallDie"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding HasZone, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                <DockPanel Margin="0,2"><TextBlock Text="Origin" Style="{DynamicResource FactLabel}"/><TextBlock Text="{Binding ZoneText}" Style="{DynamicResource FactValue}"/></DockPanel>
            </StackPanel>
            <Button Content="Rescan" Style="{DynamicResource SubtleButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding RescanCommand}"
                    ToolTip="Forget cached tool results for this file and analyze it again" AutomationProperties.AutomationId="Explore.Overview.Rescan"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
