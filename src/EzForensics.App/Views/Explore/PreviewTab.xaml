<UserControl x:Class="EzForensics.App.Views.Explore.PreviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Images (decoded by WPF from a read-only stream) and plain text only. Nothing is rendered as HTML or run. -->
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVis}}">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"
                   AutomationProperties.AutomationId="Explore.Preview.Image" AutomationProperties.Name="Image preview"/>
        </ScrollViewer>
        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" Style="{DynamicResource MonoBox}" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding PreviewText, Converter={StaticResource BoolToVis}}"
                 AutomationProperties.AutomationId="Explore.Preview.Text" AutomationProperties.Name="Text preview"/>
    </Grid>
</UserControl>
