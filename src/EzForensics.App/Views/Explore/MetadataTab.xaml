<UserControl x:Class="EzForensics.App.Views.Explore.MetadataTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetaCopy" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="ToolTip" Value="Copy"/>
        </Style>
        <Style x:Key="MetaChipLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="MetaChipValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Explore.Metadata">
        <StackPanel Margin="0,0,8,8">
            <!-- summary strip -->
            <Border Style="{DynamicResource Card}" Padding="10,8" Margin="0,0,0,8" AutomationProperties.AutomationId="Explore.Metadata.Summary">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" Margin="0,0,14,4" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <TextBlock Text="{Binding SizeText}" Style="{DynamicResource Caption}" Margin="0,0,14,4" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SignerText}" Style="{DynamicResource Caption}" Margin="0,0,14,4" VerticalAlignment="Center" AutomationProperties.AutomationId="Explore.Metadata.Signer"/>
                        <TextBlock Text="{Binding DieText}" Style="{DynamicResource Caption}" Margin="0,0,0,4" VerticalAlignment="Center" AutomationProperties.AutomationId="Explore.Metadata.Die"/>
                    </WrapPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding Md5Short, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MD5" Style="{DynamicResource MetaChipLabel}"/>
                            <TextBlock Text="{Binding Md5Short}" Style="{DynamicResource MetaChipValue}" ToolTip="{Binding Md5}"/>
                            <Button Style="{DynamicResource MetaCopy}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Md5}" Margin="2,0,0,0"
                                    AutomationProperties.AutomationId="Explore.Metadata.CopyMd5" AutomationProperties.Name="Copy MD5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding Sha1Short, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SHA1" Style="{DynamicResource MetaChipLabel}"/>
                            <TextBlock Text="{Binding Sha1Short}" Style="{DynamicResource MetaChipValue}" ToolTip="{Binding Sha1}"/>
                            <Button Style="{DynamicResource MetaCopy}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Sha1}" Margin="2,0,0,0"
                                    AutomationProperties.AutomationId="Explore.Metadata.CopySha1" AutomationProperties.Name="Copy SHA1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Sha256Short, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SHA256" Style="{DynamicResource MetaChipLabel}"/>
                            <TextBlock Text="{Binding Sha256Short}" Style="{DynamicResource MetaChipValue}" ToolTip="{Binding Sha256}"/>
                            <Button Style="{DynamicResource MetaCopy}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Sha256}" Margin="2,0,0,0"
                                    AutomationProperties.AutomationId="Explore.Metadata.CopySha256" AutomationProperties.Name="Copy SHA256"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4" Visibility="{Binding MetadataBusy, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ExifNote, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                <TextBlock Text="{Binding ExifNote}" Style="{DynamicResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="Explore.Metadata.Note"/>
                <Button Content="Install in Tools" Style="{DynamicResource LinkButton}" Command="{Binding OpenToolsCommand}" Margin="8,0,0,0"
                        Visibility="{Binding ExifInstalled, Converter={StaticResource BoolToVisInv}}" AutomationProperties.AutomationId="Explore.Metadata.InstallExif"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding MetaSections}" AutomationProperties.AutomationId="Explore.Metadata.Groups" AutomationProperties.Name="Metadata sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Title}" IsExpanded="{Binding Expanded, Mode=OneWay}" Margin="0,2">
                            <ItemsControl ItemsSource="{Binding Rows}" Margin="8,2,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Row" Background="Transparent" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                            <TextBox x:Name="Val" Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     TextWrapping="Wrap" Padding="0,2" MinHeight="0" VerticalContentAlignment="Top"/>
                                            <Button x:Name="Cp" Grid.Column="2" Style="{DynamicResource MetaCopy}" VerticalAlignment="Top" Visibility="Hidden"
                                                    Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    CommandParameter="{Binding Value}" AutomationProperties.Name="Copy value"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cp" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Mono}" Value="True">
                                                <Setter TargetName="Val" Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
                                                <Setter TargetName="Val" Property="FontSize" Value="{DynamicResource FontSize.Mono}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
