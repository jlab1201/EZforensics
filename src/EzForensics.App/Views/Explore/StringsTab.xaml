<UserControl x:Class="EzForensics.App.Views.Explore.StringsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Send to CyberChef" Command="{Binding SendStringToCyberChefCommand}" CommandParameter="{Binding SelectedString}"
                    AutomationProperties.AutomationId="Explore.Strings.SendToCyberChef" AutomationProperties.Name="Send string to CyberChef"/>
            <TextBlock DockPanel.Dock="Left" Text="Min length" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding StringsMinLengths}" SelectedItem="{Binding StringsMinLength}" Width="56" Margin="0,0,10,0"
                      AutomationProperties.AutomationId="Explore.Strings.MinLength" AutomationProperties.Name="Minimum string length"/>
            <TextBox Style="{DynamicResource ClearableTextBox}" Padding="6,4,26,4" Text="{Binding StringsFilter, UpdateSourceTrigger=PropertyChanged}" Tag="Filter strings" AutomationProperties.AutomationId="Explore.Strings.Filter" AutomationProperties.Name="Filter strings"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StringsStatus}" Style="{DynamicResource Caption}" Margin="0,6,0,0" AutomationProperties.AutomationId="Explore.Strings.Status"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,4" Visibility="{Binding StringsBusy, Converter={StaticResource BoolToVis}}"/>
        <DataGrid ItemsSource="{Binding FilteredStrings}" SelectedItem="{Binding SelectedString, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.AutomationId="Explore.Strings.Grid" AutomationProperties.Name="Strings">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Offset" Binding="{Binding OffsetHex}" Width="90" FontFamily="{DynamicResource Font.Mono}"/>
                <DataGridTextColumn Header="Enc" Binding="{Binding Encoding}" Width="64"/>
                <DataGridTextColumn Header="String" Binding="{Binding Text}" Width="*" FontFamily="{DynamicResource Font.Mono}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
