<UserControl x:Class="EzForensics.App.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <!-- always visible so the title never shifts; disabled when there is nowhere to go back to -->
        <Button x:Name="BackButton" Style="{StaticResource SubtleButton}" Padding="6,3" Margin="-6,0,4,4" VerticalAlignment="Center"
                AutomationProperties.AutomationId="Page.Back" AutomationProperties.Name="Back"
                Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                ToolTip="{Binding DataContext.BackTip, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE72B;"/>
        </Button>
        <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,4" Text="{Binding Title, ElementName=Root}"/>
    </StackPanel>
</UserControl>
