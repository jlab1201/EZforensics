<UserControl x:Class="EzForensics.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center"
             AutomationProperties.Name="{Binding Title, ElementName=Root}">
    <StackPanel MaxWidth="420" HorizontalAlignment="Center">
        <TextBlock x:Name="GlyphText" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Brush.NeutralText}"
                   HorizontalAlignment="Center" Margin="0,0,0,8" Text="{Binding Glyph, ElementName=Root}"/>
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Text="{Binding Title, ElementName=Root}"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"
                   Text="{Binding Message, ElementName=Root}"/>
        <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="PrimaryButton" Margin="0,0,6,0" Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}"/>
            <Button x:Name="SecondaryButton" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                    Content="{Binding SecondaryActionText, ElementName=Root}" Command="{Binding SecondaryActionCommand, ElementName=Root}"/>
            <ContentPresenter Content="{Binding Extra, ElementName=Root}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
